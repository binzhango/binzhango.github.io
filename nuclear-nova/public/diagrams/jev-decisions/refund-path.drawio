<mxfile host="app.diagrams.net"><diagram name="Normal vs Jev-assisted agent" id="jev-comparison"><mxGraphModel page="1" pageWidth="900" pageHeight="1140" background="#f8fafc"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="input" value="&lt;b&gt;One task · same starting facts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Same local LLM, tools, policy knowledge and generation settings&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#eaf0f7;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="30" y="30" width="820" height="85" /></mxCell><mxCell id="normal_label" value="&lt;b&gt;NORMAL AGENT&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=none;strokeColor=none;spacing=12;"><mxGeometry as="geometry" x="30" y="145" width="380" height="42" /></mxCell><mxCell id="jev_label" value="&lt;b&gt;JEV-ASSISTED AGENT&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=none;strokeColor=none;spacing=12;"><mxGeometry as="geometry" x="470" y="145" width="380" height="42" /></mxCell><mxCell id="normal_llm" value="&lt;b&gt;Local LLM chooses&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Selects workflow and proposes the action&lt;br&gt;within its generation&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#eaf0f7;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="30" y="215" width="380" height="185" /></mxCell><mxCell id="triage" value="&lt;b&gt;Jev triage → prompt hint&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Category + confidence select advisory guidance&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#e0f3f4;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="470" y="215" width="380" height="80" /></mxCell><mxCell id="jev_llm" value="&lt;b&gt;Same local LLM proposes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;All tools remain available; LLM chooses action&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#eaf0f7;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="470" y="325" width="380" height="75" /></mxCell><mxCell id="normal_policy" value="&lt;b&gt;Python: hard-policy checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Ownership, amount limits, duplicate refunds&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#f0eafa;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="30" y="455" width="380" height="80" /></mxCell><mxCell id="jev_policy" value="&lt;b&gt;Same hard-policy checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Deny invalid refunds before Jev risk&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#f0eafa;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="470" y="455" width="380" height="80" /></mxCell><mxCell id="risk" value="&lt;b&gt;Jev assesses eligible refund&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Proposed arguments + verified evidence&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#e0f3f4;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="470" y="585" width="380" height="80" /></mxCell><mxCell id="normal_review" value="&lt;b&gt;Python: review when required&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Amount &amp;gt; $25 or LLM requests review&lt;br&gt;Recheck edited arguments&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#f0eafa;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="30" y="715" width="380" height="100" /></mxCell><mxCell id="jev_review" value="&lt;b&gt;Python: review when required&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Same rules + risk ≥ threshold or unavailable&lt;br&gt;Recheck edited arguments&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#f0eafa;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="470" y="715" width="380" height="100" /></mxCell><mxCell id="normal_result" value="&lt;b&gt;Simulated tool → LLM response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Own order data and checkpoints&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#eaf0f7;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="30" y="875" width="380" height="85" /></mxCell><mxCell id="jev_result" value="&lt;b&gt;Simulated tool → LLM response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Independent order data and checkpoints&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#eaf0f7;strokeColor=#74849b;spacing=12;"><mxGeometry as="geometry" x="470" y="875" width="380" height="85" /></mxCell><mxCell id="compare" value="&lt;b&gt;Compare the two recorded runs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Actual effects · response quality · calls · timing&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#192c43;fillColor=#eaf0f7;strokeColor=#74849b;spacing=12;"><