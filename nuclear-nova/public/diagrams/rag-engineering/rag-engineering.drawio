        <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=20;html=1;strokeColor=#586d86;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15263a;fontSize=16;fontFamily=Helvetica;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="query" target="gate">
