  <diagram id="05-expansion" name="Search a sentence; send a useful source region">
    <mxGraphModel grid="1" gridSize="10" page="0" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hit" value="&lt;b&gt;Sentence hit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#42536a&quot;&gt;&quot;Acknowledge P1 within 15 min.&quot;&lt;/font&gt;" style="shape=document;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#287cb5;strokeWidth=1.7;fontColor=#15263a;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="25.0" width="310" height="120" />
