      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="query" value="&lt;b&gt;Query encoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#42536a&quot;&gt;Model · revision · normalization&lt;/font&gt;" style="rounded=0;align=left;spacingLeft=18;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#287cb5;strokeWidth=1.7;fontColor=#15263a;fontSize=19;fontFamily=Helvetica;spacing=12;verticalAlign=middle;" vertex="1" parent="1">
