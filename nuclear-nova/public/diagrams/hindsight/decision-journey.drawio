  <diagram id="decision-journey" name="A decision survives the conversation">
    <mxGraphModel grid="1" page="0" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="source" value="&lt;b&gt;1 · Record decision&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#42536a&quot; style=&quot;font-size:17px&quot;&gt;Planner records Alice’s constraints&lt;/font&gt;" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#e2f5ed;strokeColor=#278162;fontColor=#15263a;fontFamily=Helvetica;fontSize=20;spacing=12;strokeWidth=1.5;">
