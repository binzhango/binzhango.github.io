<mxfile host="app.diagrams.net"><diagram name="Memory-informed answer decisions" id="jev-comparison"><mxGraphModel page="1" pageWidth="900" pageHeight="1140" background="#101b2b"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="scope" value="&lt;b&gt;Request + user/project scope&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Application selects the memory bank&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#e5edf8;fillColor=#1c2b41;strokeColor=#71849e;spacing=12;"><mxGeometry as="geometry" x="20" y="20" width="340" height="110" /></mxCell><mxCell id="recall" value="&lt;b&gt;Hindsight recalls once&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Fact IDs + text form the shared evidence snapshot&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#e5edf8;fillColor=#1c2b41;strokeColor=#71849e;spacing=12;"><mxGeometry as="geometry" x="20" y="185" width="340" height="110" /></mxCell><mxCell id="preflight" value="&lt;b&gt;Jev preflight&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Proceed, clarify, or review · hosted prediction&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#e5edf8;fillColor=#143d49;strokeColor=#71849e;spacing=12;"><mxGeometry as="geometry" x="20" y="350" width="340" height="110" /></mxCell><mxCell id="worker" value="&lt;b&gt;Local worker drafts an answer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Same question, instructions and memory evidence&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#e5edf8;fillColor=#1c2b41;strokeColor=#71849e;spacing=12;"><mxGeometry as="geometry" x="20" y="515" width="340" height="110" /></mxCell><mxCell id="review" value="&lt;b&gt;Jev reviews the draft&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Same snapshot + draft · hosted prediction&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#e5edf8;fillColor=#143d49;strokeColor=#71849e;spacing=12;"><mxGeometry as="geometry" x="20" y="680" width="340" height="110" /></mxCell><mxCell id="policy" value="&lt;b&gt;Python applies the gate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Proceed with confidence ≥ 0.60 → accepted answer&lt;br&gt;Otherwise → clarify/review; draft kept separate&lt;/span&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#e5edf8;fillColor=#372e4f;strokeColor=#71849e;spacing=12;"><mxGeometry as="geometry" x="20" y="845" width="340" height="135" /></mxCell><mxCell id="e0" source="scope" target="recall" value="question" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#71849e;fontColor=#e5edf8;fontSize=15;labelBackgroundColor=#101b2b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" source="recall" target="preflight" value="shared history" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#71849e;fontColor=#e5edf8;fontSize=15;labelBackgroundColor=#101b2b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" source="preflight" target="worker" value="proceed + confidence ≥ 0.60" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#71849e;fontColor=#e5edf8;fontSize=15;labelBackgroundColor=#101b2b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" source="worker" target="review" value="draft + history" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#71849e;fontColor=#e5edf8;fontSize=15;labelBackgroundColor=#101b2b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" source="review" target="policy" value="decision" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#71849e;fontColor=#e5edf8;fontSize=15;labelBackgroundColor=#101b2b;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>