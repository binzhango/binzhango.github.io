---
import ThemeManager from '../components/ThemeManager.astro';
import Lightbox from '../components/Lightbox.astro';
import CodeBlockCopy from '../components/CodeBlockCopy.astro';
import ThemeControl from '../components/ThemeControl.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'B~~~~~Z',
  description = 'A blog about Python, Kubernetes, Spark, Machine Learning, and more.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const isBlogPage = Astro.url.pathname === '/posts/' || Astro.url.pathname.startsWith('/posts/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.ico" />
    <ThemeManager defaultTheme="light" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell">
        <a class="brand" href="/">
          <img src="/assets/favicon.ico" alt="B~~~~~Z" width="28" height="28" />
          <span>B~~~~~Z</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a class="nav-link" href="/">Home</a>
          <a class="nav-link" href="/posts/">Blog</a>
          <a class="nav-link" href="/archive/">Archive</a>
          <a
            class="social-link"
            href="https://github.com/binzhango"
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52
                .28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02
                .08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 4.38c.68 0 1.36.09 2 .27 1.53-1.04
                2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65
                3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0
                16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
          </a>
          <a
            class="social-link social-link--threads"
            href="https://www.threads.net/@binzhango"
            target="_blank"
            rel="noreferrer"
            aria-label="Threads"
            title="Threads"
          >
            <span aria-hidden="true">@</span>
          </a>
        </nav>
      </div>
    </header>
    <main class="site-shell page">
      <div class="sl-markdown-content">
        <slot />
      </div>
    </main>
    <footer class="site-shell site-footer">
      <span>&copy; {new Date().getFullYear()} Bin Zhang. All rights reserved.</span>
    </footer>
    {!isBlogPage && <ThemeControl variant="floating" />}

    <CodeBlockCopy />
    <Lightbox />
  </body>
</html>

<style>
  .site-shell {
    width: min(1120px, 100% - 2rem);
    margin-inline: auto;
  }

  .site-header {
    border-bottom: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-nav);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .site-header .site-shell {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--sl-color-text-accent);
    font-weight: 700;
  }

  .site-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .nav-link {
    color: var(--sl-color-text);
    text-decoration: none;
    font-size: 0.95rem;
    border: 0;
    background: transparent;
    border-radius: 8px;
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    transition:
      color 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .nav-link:hover {
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-hairline-light) 65%, transparent);
    box-shadow: inset 0 0 0 1px var(--sl-color-hairline);
  }

  .social-link {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-text);
    text-decoration: none;
    border-radius: 999px;
    transition:
      color 0.18s ease,
      background-color 0.18s ease,
      transform 0.18s ease;
  }

  .social-link svg {
    width: 1.35rem;
    height: 1.35rem;
    display: block;
  }

  .social-link--threads {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
  }

  .social-link:hover {
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-hairline-light) 45%, transparent);
    transform: translateY(-1px);
  }

  .page {
    padding-block: 1.5rem 2rem;
  }

  .site-footer {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 1.25rem 0 2rem;
    color: var(--sl-color-gray-5);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .site-header .site-shell {
      min-height: 56px;
      flex-direction: column;
      justify-content: center;
      padding-block: 0.5rem;
      align-items: flex-start;
    }

    .site-nav {
      gap: 0.5rem;
    }

    .nav-link {
      padding: 0.3rem 0.45rem;
      font-size: 0.9rem;
    }

    .social-link {
      width: 1.8rem;
      height: 1.8rem;
    }

  }
</style>
