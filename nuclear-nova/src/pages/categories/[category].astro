---
import { getPostsByCategory, getPostPath, type Post } from '../../utils/post-utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { getPostExcerpt } from '../../utils/excerpt';
import { normalizeCategory, slugifyCategory } from '../../utils/taxonomy';

interface CategoryLink {
    slug: string;
    label: string;
}

export async function getStaticPaths() {
    const postsByCategory = await getPostsByCategory();
    const categoriesBySlug = new Map<string, { label: string; posts: Post[] }>();

    for (const [rawCategory, posts] of Object.entries(postsByCategory)) {
        const label = normalizeCategory(rawCategory);
        const slug = slugifyCategory(label);
        if (!slug) continue;

        const existing = categoriesBySlug.get(slug);
        if (!existing) {
            categoriesBySlug.set(slug, { label, posts: [...posts] });
            continue;
        }

        const mergedPosts = new Map(existing.posts.map((post) => [post.id, post]));
        for (const post of posts) {
            mergedPosts.set(post.id, post);
        }
        existing.posts = [...mergedPosts.values()];
    }

    const categories = [...categoriesBySlug.entries()]
        .map(([slug, value]) => ({ slug, label: value.label, posts: value.posts }))
        .sort((a, b) => a.label.localeCompare(b.label));
    const allCategories: CategoryLink[] = categories.map(({ slug, label }) => ({ slug, label }));

    return categories.map(({ slug, label, posts }) => ({
        params: { category: slug },
        props: {
            category: label,
            categorySlug: slug,
            posts,
            allCategories,
        },
    }));
}

interface Props {
    category: string;
    categorySlug: string;
    posts: Post[];
    allCategories: CategoryLink[];
}

const { category, categorySlug, posts, allCategories } = Astro.props;
const pageTitle = `Category: ${category}`;
const pageDescription = `Blog posts in the ${category} category`;

function formatDate(date: Date | undefined): string {
    if (!date) return '';
    return new Date(date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}

const sortedPosts = [...posts].sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <div class="listing-layout">
        <aside class="listing-sidebar">
            <div class="listing-sidebar__card">
                <p class="listing-sidebar__eyebrow">Categories</p>
                <nav>
                    <ul>
                        {allCategories.map((cat) => (
                            <li>
                                <a href={`/categories/${cat.slug}/`} class:list={[{ active: categorySlug === cat.slug }]}>
                                    {cat.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>
        </aside>

        <main class="listing-content">
            <div class="listing-posts">
                {sortedPosts.map(post => (
                    <article class="listing-post">
                        <div class="listing-post__top">
                            <h2 class="listing-post__title">
                                <a href={getPostPath(post)}>{post.data.title}</a>
                            </h2>
                            <time class="listing-post__date" datetime={post.data.date?.toISOString()}>
                                {formatDate(post.data.date)}
                            </time>
                        </div>

                        {post.data.categories && post.data.categories.length > 0 && (
                            <div class="listing-post__tags">
                                {post.data.categories.map(cat => (
                                    <CategoryBadge category={cat} link={true} />
                                ))}
                            </div>
                        )}

                        <p class="listing-post__excerpt">{getPostExcerpt(post)}</p>
                    </article>
                ))}
            </div>
        </main>
    </div>
</BaseLayout>

<style>
    .listing-layout {
        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr);
        gap: 1.2rem;
    }

    .listing-sidebar {
        position: sticky;
        top: 5.15rem;
        align-self: start;
    }

    .listing-sidebar__card,
    .listing-post {
        border: 1px solid var(--clay-border);
        border-radius: 28px;
        background: color-mix(in srgb, var(--clay-paper) 88%, transparent);
        box-shadow: var(--clay-shadow);
    }

    .listing-sidebar__card {
        padding: 1rem;
    }

    .listing-sidebar__eyebrow {
        margin: 0 0 0.75rem;
        color: var(--clay-muted);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .listing-sidebar ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.35rem;
    }

    .listing-sidebar a {
        display: block;
        padding: 0.6rem 0.75rem;
        border-radius: 18px;
        color: var(--sl-color-text) !important;
        text-decoration: none;
        transition: background-color 0.18s ease, transform 0.18s ease;
    }

    .listing-sidebar a:hover {
        background: color-mix(in srgb, var(--clay-lemon-400) 26%, var(--clay-paper) 74%) !important;
        transform: translateY(-1px);
    }

    .listing-sidebar a.active {
        background: color-mix(in srgb, var(--clay-slushie-500) 18%, var(--clay-paper) 82%) !important;
        color: var(--sl-color-text) !important;
        font-weight: 700;
    }

    .listing-content {
        min-width: 0;
        display: grid;
        gap: 1rem;
    }

    .listing-posts {
        display: grid;
        gap: 1rem;
    }

    .listing-post {
        padding: 1.2rem;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
    }

    .listing-post:hover {
        transform: translateY(-0.18rem);
        box-shadow: var(--clay-shadow-hard);
    }

    .listing-post__top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
    }

    .listing-post__title {
        margin: 0;
        font-size: clamp(1.35rem, 3vw, 1.8rem);
        line-height: 1.08;
        letter-spacing: -0.04em;
    }

    .listing-post__title a {
        color: var(--sl-color-text);
        text-decoration: none;
    }

    .listing-post__date {
        color: var(--clay-muted);
        font-family: var(--font-space-mono);
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        white-space: nowrap;
    }

    .listing-post__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 0.75rem;
    }

    .listing-post__excerpt {
        margin: 0;
        color: var(--clay-charcoal);
    }

    @media (max-width: 860px) {
        .listing-layout {
            grid-template-columns: 1fr;
        }

        .listing-sidebar {
            position: static;
        }

        .listing-sidebar ul {
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        }
    }
</style>
