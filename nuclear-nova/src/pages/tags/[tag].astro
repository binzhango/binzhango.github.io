---
import { getPostsByTag, type Post } from '../../utils/post-utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../../components/PostPreview.astro';
import BlogShell from '../../components/BlogShell.astro';
import { slugifyTag } from '../../utils/taxonomy';

interface TagLink {
    slug: string;
    label: string;
}

export async function getStaticPaths() {
    const postsByTag = await getPostsByTag();
    const tagsBySlug = new Map<string, { label: string; posts: Post[] }>();

    for (const [rawTag, posts] of Object.entries(postsByTag)) {
        const slug = slugifyTag(rawTag);
        if (!slug) continue;

        const existing = tagsBySlug.get(slug);
        if (!existing) {
            tagsBySlug.set(slug, { label: rawTag, posts: [...posts] });
            continue;
        }

        const mergedPosts = new Map(existing.posts.map((post) => [post.id, post]));
        for (const post of posts) {
            mergedPosts.set(post.id, post);
        }
        existing.posts = [...mergedPosts.values()];
    }

    const tags = [...tagsBySlug.entries()]
        .map(([slug, value]) => ({ slug, label: value.label, posts: value.posts }))
        .sort((a, b) => a.label.localeCompare(b.label));
    const allTags: TagLink[] = tags.map(({ slug, label }) => ({ slug, label }));

    return tags.map(({ slug, label, posts }) => ({
        params: { tag: slug },
        props: {
            tag: label,
            tagSlug: slug,
            posts,
            allTags,
        },
    }));
}

interface Props {
    tag: string;
    tagSlug: string;
    posts: Post[];
    allTags: TagLink[];
}

const { tag, posts } = Astro.props;
const pageTitle = `Tag: ${tag}`;
const pageDescription = `Blog posts tagged with ${tag}`;



const sortedPosts = [...posts].sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
});
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <BlogShell>
    <header class="page-heading"><p class="eyebrow">Tag / {posts.length} articles</p><h1>{`#${tag}`}</h1><p>{pageDescription}</p></header>
    <div class="post-list">{sortedPosts.map((post) => <PostPreview post={post} />)}</div>
  </BlogShell>
</BaseLayout>
