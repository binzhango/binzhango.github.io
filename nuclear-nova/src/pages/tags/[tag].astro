---
import { getPostsByTag, getPostPath, type Post } from '../../utils/post-utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagBadge from '../../components/TagBadge.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { getPostExcerpt } from '../../utils/excerpt';
import { slugifyTag } from '../../utils/taxonomy';

interface TagLink {
    slug: string;
    label: string;
}

export async function getStaticPaths() {
    const postsByTag = await getPostsByTag();
    const tagsBySlug = new Map<string, { label: string; posts: Post[] }>();

    for (const [rawTag, posts] of Object.entries(postsByTag)) {
        const slug = slugifyTag(rawTag);
        if (!slug) continue;

        const existing = tagsBySlug.get(slug);
        if (!existing) {
            tagsBySlug.set(slug, { label: rawTag, posts: [...posts] });
            continue;
        }

        const mergedPosts = new Map(existing.posts.map((post) => [post.id, post]));
        for (const post of posts) {
            mergedPosts.set(post.id, post);
        }
        existing.posts = [...mergedPosts.values()];
    }

    const tags = [...tagsBySlug.entries()]
        .map(([slug, value]) => ({ slug, label: value.label, posts: value.posts }))
        .sort((a, b) => a.label.localeCompare(b.label));
    const allTags: TagLink[] = tags.map(({ slug, label }) => ({ slug, label }));

    return tags.map(({ slug, label, posts }) => ({
        params: { tag: slug },
        props: {
            tag: label,
            tagSlug: slug,
            posts,
            allTags,
        },
    }));
}

interface Props {
    tag: string;
    tagSlug: string;
    posts: Post[];
    allTags: TagLink[];
}

const { tag, tagSlug, posts, allTags } = Astro.props;
const pageTitle = `Tag: ${tag}`;
const pageDescription = `Blog posts tagged with ${tag}`;

function formatDate(date: Date | undefined): string {
    if (!date) return '';
    return new Date(date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}

const sortedPosts = [...posts].sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <div class="listing-layout">
        <aside class="listing-sidebar">
            <div class="listing-sidebar__card">
                <p class="listing-sidebar__eyebrow">Tags</p>
                <nav>
                    <ul>
                        {allTags.map((t) => (
                            <li>
                                <a href={`/tags/${t.slug}/`} class:list={[{ active: tagSlug === t.slug }]}>
                                    #{t.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>
        </aside>

        <main class="listing-content">
            <header class="listing-header">
                <h1 class="listing-title">
                    <TagBadge tag={tag} link={false} />
                </h1>
                <p class="listing-count">{sortedPosts.length} {sortedPosts.length === 1 ? 'post' : 'posts'}</p>
            </header>

            <div class="listing-posts">
                {sortedPosts.map(post => (
                    <article class="listing-post">
                        <div class="listing-post__top">
                            <h2 class="listing-post__title">
                                <a href={getPostPath(post)}>{post.data.title}</a>
                            </h2>
                            <time class="listing-post__date" datetime={post.data.date?.toISOString()}>
                                {formatDate(post.data.date)}
                            </time>
                        </div>

                        {post.data.categories && post.data.categories.length > 0 && (
                            <div class="listing-post__tags">
                                {post.data.categories.map(cat => (
                                    <CategoryBadge category={cat} link={true} />
                                ))}
                            </div>
                        )}

                        {post.data.tags && post.data.tags.length > 0 && (
                            <div class="listing-post__tags">
                                {post.data.tags.map(t => (
                                    <TagBadge tag={t} link={true} />
                                ))}
                            </div>
                        )}

                        <p class="listing-post__excerpt">{getPostExcerpt(post)}</p>
                    </article>
                ))}
            </div>
        </main>
    </div>
</BaseLayout>

<style>
    .listing-layout {
        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr);
        gap: 1.2rem;
    }

    .listing-sidebar {
        position: sticky;
        top: 5.15rem;
        align-self: start;
    }

    .listing-sidebar__card,
    .listing-header,
    .listing-post {
        border: 1px solid var(--clay-border);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.84);
        box-shadow: var(--clay-shadow);
    }

    .listing-sidebar__card {
        padding: 1rem;
    }

    .listing-sidebar__eyebrow {
        margin: 0 0 0.75rem;
        color: var(--clay-muted);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .listing-sidebar ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.35rem;
    }

    .listing-sidebar a {
        display: block;
        padding: 0.6rem 0.75rem;
        border-radius: 18px;
        color: var(--sl-color-text);
        text-decoration: none;
        transition: background-color 0.18s ease, transform 0.18s ease;
    }

    .listing-sidebar a:hover {
        background: rgba(248, 204, 101, 0.34);
        transform: translateY(-1px);
    }

    .listing-sidebar a.active {
        background: rgba(59, 211, 253, 0.24);
    }

    .listing-content {
        min-width: 0;
        display: grid;
        gap: 1rem;
    }

    .listing-header {
        padding: 1.2rem 1.3rem;
    }

    .listing-title {
        margin: 0 0 0.45rem;
    }

    .listing-count {
        margin: 0;
        color: var(--clay-muted);
        font-family: var(--font-space-mono);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .listing-posts {
        display: grid;
        gap: 1rem;
    }

    .listing-post {
        padding: 1.2rem;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
    }

    .listing-post:hover {
        transform: translateY(-0.18rem);
        box-shadow: var(--clay-shadow-hard);
    }

    .listing-post__top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
    }

    .listing-post__title {
        margin: 0;
        font-size: clamp(1.35rem, 3vw, 1.8rem);
        line-height: 1.08;
        letter-spacing: -0.04em;
    }

    .listing-post__title a {
        color: var(--sl-color-text);
        text-decoration: none;
    }

    .listing-post__date {
        color: var(--clay-muted);
        font-family: var(--font-space-mono);
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        white-space: nowrap;
    }

    .listing-post__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 0.75rem;
    }

    .listing-post__excerpt {
        margin: 0;
        color: var(--clay-charcoal);
    }

    @media (max-width: 860px) {
        .listing-layout {
            grid-template-columns: 1fr;
        }

        .listing-sidebar {
            position: static;
        }

        .listing-sidebar ul {
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        }
    }
</style>
