---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogShell from '../../components/BlogShell.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getAdjacentPosts, getPostPath, getAllPosts, slugifyId, type Post } from '../../utils/post-utils';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: slugifyId(post.id) },
    props: { postId: post.id },
  }));
}

interface Props {
  postId: string;
}

const { postId } = Astro.props as Props;
const post = await getEntry('blog', postId);

if (!post) {
  throw new Error(`Post not found for id: ${postId}`);
}

const { Content, headings } = await render(post);
const adjacent = await getAdjacentPosts(post.id);

const pageTitle = post.data.title;
const pageDescription = post.data.excerpt ?? post.data.description ?? '';

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function formatDateTime(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toISOString();
}

function estimateReadingTime(content: string): string {
  const plainText = content
    .replace(/^---[\s\S]*?---/, ' ')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/!\[[^\]]*]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[#>*_\-\[\]()]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const words = plainText ? plainText.split(' ').length : 0;
  const minutes = Math.max(1, Math.ceil(words / 220));
  return `${minutes} min read`;
}

function toNav(postEntry: Post | null) {
  if (!postEntry) return null;
  return {
    href: getPostPath(postEntry),
    title: postEntry.data.title,
  };
}

const prevPost = toNav(adjacent.prev);
const nextPost = toNav(adjacent.next);
const currentPath = getPostPath(post);
const readingTime = estimateReadingTime(post.body ?? '');
const sectionHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const tocHeadings = sectionHeadings.length > 0 ? sectionHeadings : headings.filter((heading) => heading.depth === 1);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <BlogShell currentPath={currentPath} reserveSecondary={true}>
    {tocHeadings.length > 0 && (
      <Fragment slot="secondary">
        <nav class="post-toc" aria-label="On this page" data-post-toc>
          <p class="post-toc__title">On this page</p>
          <ul class="post-toc__list">
            {tocHeadings.map((heading) => (
              <li class:list={['post-toc__item', { 'post-toc__item--nested': heading.depth > 2 }]}>
                <a
                  class="post-toc__link"
                  href={`#${heading.slug}`}
                  data-toc-link
                  data-depth={heading.depth}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </Fragment>
    )}

    <article class="post">
      <header class="post-header">
        <div class="post-header__eyebrow">
          <span class="post-header__eyebrow-label">Article</span>
          {post.data.categories?.[0] && <span class="post-header__eyebrow-topic">{post.data.categories[0]}</span>}
        </div>
        <h1>{post.data.title}</h1>
        {pageDescription && <p class="post-header__summary">{pageDescription}</p>}
        <div class="post-meta">
          <span class="post-meta__item" aria-label="Published date">
            <time class="post-meta__value" datetime={formatDateTime(post.data.date)}>{formatDate(post.data.date)}</time>
          </span>
          {post.data.author && (
            <span class="post-meta__item" aria-label="Author">
              <span class="post-meta__value">{post.data.author}</span>
            </span>
          )}
          <span class="post-meta__item" aria-label="Reading time">
            <span class="post-meta__value">{readingTime}</span>
          </span>
        </div>
        {((post.data.categories && post.data.categories.length > 0) || (post.data.tags && post.data.tags.length > 0)) && (
          <div class="post-taxonomy">
            {post.data.categories && post.data.categories.length > 0 && (
              <div class="post-taxonomy__group">
                <span class="post-taxonomy__label">Categories</span>
                <div class="post-categories">
                  {post.data.categories.map((category) => (
                    <CategoryBadge category={category} link={true} />
                  ))}
                </div>
              </div>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-taxonomy__group">
                <span class="post-taxonomy__label">Tags</span>
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <TagBadge tag={tag} link={true} />
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </header>

      <section class="post-content">
        <Content />
      </section>

      {(prevPost || nextPost) && (
        <nav class:list={['post-nav', { 'post-nav--single': !(prevPost && nextPost) }]} aria-label="Post navigation">
          <div class:list={['post-nav__item', { 'post-nav__item--empty': !prevPost }]}>
            {prevPost && (
              <a href={prevPost.href} class="post-nav__link">
                <span class="post-nav__eyebrow">Previous</span>
                <strong class="post-nav__title">{prevPost.title}</strong>
              </a>
            )}
          </div>
          <div class:list={['post-nav__item', { 'post-nav__item--empty': !nextPost }]}>
            {nextPost && (
              <a href={nextPost.href} class="post-nav__link post-nav__link--next">
                <span class="post-nav__eyebrow">Next</span>
                <strong class="post-nav__title">{nextPost.title}</strong>
              </a>
            )}
          </div>
        </nav>
      )}
    </article>
  </BlogShell>
</BaseLayout>

<style>
  .post {
    max-width: 100%;
    margin-inline: auto;
  }

  .post-header,
  .post-toc,
  .post-nav__link {
    border: 1px solid var(--clay-border);
    box-shadow: var(--clay-shadow);
  }

  .post-header {
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
    padding: clamp(1.05rem, 1.8vw, 1.35rem);
    border-radius: 26px;
    background:
      radial-gradient(circle at top right, rgba(193, 176, 255, 0.36), transparent 24%),
      radial-gradient(circle at bottom left, rgba(132, 231, 165, 0.24), transparent 22%),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--clay-paper) 94%, transparent) 0%,
        color-mix(in srgb, var(--clay-cream) 96%, transparent) 100%
      );
  }

  .post-header__eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.2rem;
  }

  .post-header__eyebrow-label,
  .post-header__eyebrow-topic {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.3rem 0.68rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-header__eyebrow-label {
    background: var(--clay-lemon-400);
  }

  .post-header__eyebrow-topic {
    border: 1px dashed var(--clay-border);
    background: color-mix(in srgb, var(--clay-paper) 70%, transparent);
  }

  .post-header h1 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2.2rem, 5.2vw, 4.4rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
    text-wrap: balance;
  }

  .post-header__summary {
    max-width: 62ch;
    margin: 0;
    color: var(--clay-charcoal);
    font-size: 1rem;
    line-height: 1.62;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-meta__item {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.62rem;
    border: 1px solid var(--clay-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--clay-paper) 72%, transparent);
  }

  .post-meta__value {
    font-family: var(--font-space-mono);
    font-size: 0.76rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .post-taxonomy {
    display: grid;
    gap: 0.65rem;
  }

  .post-taxonomy__group {
    display: grid;
    gap: 0.38rem;
  }

  .post-taxonomy__label {
    color: var(--clay-muted);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-categories,
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .post-content {
    padding: clamp(1.05rem, 1.75vw, 1.5rem);
  }

  .post-nav {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .post-nav--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .post-nav__item--empty {
    display: none;
  }

  .post-nav__link {
    min-height: 6.2rem;
    display: grid;
    gap: 0.45rem;
    align-content: start;
    padding: 1rem;
    border-radius: 24px;
    background: color-mix(in srgb, var(--clay-paper) 84%, transparent);
    color: var(--sl-color-text) !important;
    text-decoration: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease, background-color 0.22s ease;
  }

  .post-nav__link--next {
    text-align: right;
  }

  .post-nav__link:hover {
    background: rgba(248, 204, 101, 0.22);
    transform: translateY(-0.18rem);
    box-shadow: var(--clay-shadow-hard);
  }

  .post-nav__eyebrow {
    color: var(--clay-muted);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-nav__title {
    font-size: 1rem;
    line-height: 1.4;
  }

  .post-toc {
    padding: 0.9rem;
    border-radius: 20px;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--clay-paper) 90%, white 10%) 0%,
        color-mix(in srgb, var(--clay-paper) 84%, var(--clay-cream) 16%) 100%
      );
  }

  .post-toc__title {
    margin: 0 0 0.65rem;
    color: color-mix(in srgb, var(--clay-muted) 82%, var(--sl-color-text) 18%);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.14rem;
  }

  .post-toc__link {
    display: block;
    padding: 0.44rem 0.58rem;
    border-radius: 12px;
    color: color-mix(in srgb, var(--sl-color-text) 82%, white 18%) !important;
    text-decoration: none;
    font-size: 0.8rem;
    line-height: 1.32;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      transform 0.18s ease;
  }

  .post-toc__link:hover {
    background: rgba(59, 211, 253, 0.16);
    color: var(--sl-color-text) !important;
    transform: translateY(-1px);
  }

  .post-toc__item--nested .post-toc__link {
    padding-left: 0.92rem;
    color: color-mix(in srgb, var(--clay-charcoal) 84%, white 16%) !important;
  }

  .post-toc__link[aria-current='true'] {
    background: linear-gradient(
      135deg,
      rgba(59, 211, 253, 0.16) 0%,
      rgba(59, 211, 253, 0.08) 100%
    );
    color: var(--sl-color-text) !important;
    box-shadow: inset 2px 0 0 rgba(1, 65, 141, 0.42);
  }

  @media (max-width: 720px) {
    .post-header {
      border-radius: 22px;
    }

    .post-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
