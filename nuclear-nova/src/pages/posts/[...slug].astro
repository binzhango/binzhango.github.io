---
import { getCollection, getEntry, render } from 'astro:content';
import InterviewBank from '../../components/InterviewBank.astro';
import { interviewReadingTime } from '../../utils/interview-reading-time';
import { validateInterviewBank } from '../../utils/interview-validation';
import { interviewTopics } from '../../utils/interview-topics';
import '../../styles/interview.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogShell from '../../components/BlogShell.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { getTopicTone } from '../../utils/presentation';
import TagBadge from '../../components/TagBadge.astro';
import '../../styles/rag-series.css';
import '../../styles/jev-article.css';
import { getCuratedCollections } from '../../utils/collections';
import { getAdjacentPosts, getPostPath, getAllPosts, slugifyId, type Post } from '../../utils/post-utils';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: slugifyId(post.id) },
    props: { postId: post.id },
  }));
}

interface Props {
  postId: string;
}

const { postId } = Astro.props as Props;
const post = await getEntry('blog', postId);

if (!post) {
  throw new Error(`Post not found for id: ${postId}`);
}

const { Content, headings } = await render(post);
const adjacent = await getAdjacentPosts(post.id);

const isInterview = post.id.toLowerCase() === '2025/10-30-llm-interview';
const allInterviewQuestions = isInterview ? await getCollection('interview') : [];
if (isInterview && import.meta.env.PROD) validateInterviewBank(allInterviewQuestions);
const interviewQuestions = allInterviewQuestions.filter((q) => q.data.status === 'reviewed').sort((a, b) => a.data.order - b.data.order);
const pageTitle = post.data.title;
const isInferenceWalkthrough = post.id === '2026/03-07-prompt-in-llm';
const isJevArticle = post.id === '2026/10-29-decision-models-jev-langchain';
const isRagSeries = post.data.tags?.includes('rag-engineering') ?? false;
const pageDescription = post.data.excerpt ?? post.data.description ?? '';

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

function formatDateTime(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toISOString();
}

function estimateReadingTime(content: string): string {
  const plainText = content
    .replace(/^---[\s\S]*?---/, ' ')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/!\[[^\]]*]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[#>*_\-\[\]()]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const words = plainText ? plainText.split(' ').length : 0;
  const minutes = Math.max(1, Math.ceil(words / 220));
  return `${minutes} min read`;
}

function toNav(postEntry: Post | null) {
  if (!postEntry) return null;
  return {
    href: getPostPath(postEntry),
    title: postEntry.data.title,
  };
}

const series = isRagSeries
  ? (await getCuratedCollections()).find((entry) => entry.slug === 'rag-engineering')
  : undefined;
const seriesIndex = series?.posts.findIndex((entry) => entry.id === post.id) ?? -1;
// Keep chapter order within a series, with chronological links at its boundaries.
const prevPost = toNav(series && seriesIndex >= 0 ? series.posts[seriesIndex - 1] ?? adjacent.prev : adjacent.prev);
const nextPost = toNav(series && seriesIndex >= 0 ? series.posts[seriesIndex + 1] ?? adjacent.next : adjacent.next);
const readingTime = isInterview
  ? interviewReadingTime([post.body ?? '', ...interviewQuestions.map((q) => q.body ?? '')].join('\n\n'))
  : estimateReadingTime(post.body ?? '');
const sectionHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const tocHeadings = sectionHeadings.length > 0 ? sectionHeadings : headings.filter((heading) => heading.depth === 1);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <BlogShell article>
    {isInterview && <nav slot="secondary" class="interview-rail" aria-label="Question topics"><p>Topics · {interviewQuestions.length} questions</p><ol>{interviewTopics.map(([id, title]) => <li><a href={`#topic-${id}`}><span>{title}</span><small>{interviewQuestions.filter((q) => q.data.topic === id).length}</small></a></li>)}</ol></nav>}
    {!isInterview && tocHeadings.length > 0 && <TableOfContents slot="secondary" tone={getTopicTone(post.data.categories?.[0])} headings={tocHeadings} />}

    <article data-topic-tone={getTopicTone(post.data.categories?.[0])} class:list={['post', { 'post--walkthrough': isInferenceWalkthrough, 'post--interview': isInterview, 'post--jev': isJevArticle }]}>
      <header class="post-header">
        <h1>{post.data.title}</h1>
        {pageDescription && <p class="post-header__summary">{pageDescription}</p>}
        <div class="post-meta">
          <span class="post-meta__item" aria-label="Published date">
            <time class="post-meta__value" datetime={formatDateTime(post.data.date)}>{formatDate(post.data.date)}</time>
          </span>
          {post.data.author && (
            <span class="post-meta__item" aria-label="Author">
              <span class="post-meta__value">{post.data.author}</span>
            </span>
          )}
          <span class="post-meta__item" aria-label="Reading time">
            <span class="post-meta__value">{readingTime}</span>
          </span>
        </div>
        {((post.data.categories && post.data.categories.length > 0) || (post.data.tags && post.data.tags.length > 0)) && (
          <div class="post-taxonomy">
            {post.data.categories && post.data.categories.length > 0 && (
              <div class="post-taxonomy__group">
                <span class="post-taxonomy__label">Categories</span>
                <div class="post-categories">
                  {post.data.categories.map((category) => (
                    <CategoryBadge category={category} link={true} />
                  ))}
                </div>
              </div>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-taxonomy__group">
                <span class="post-taxonomy__label">Tags</span>
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <TagBadge tag={tag} link={true} />
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </header>

      {tocHeadings.length > 0 && <div class="post-mobile-contents"><TableOfContents headings={tocHeadings} mode="mobile" /></div>}

      <section class="post-content" data-series={isRagSeries ? 'rag-engineering' : undefined}>
        <Content />
        {isInterview && <InterviewBank questions={interviewQuestions} />}
      </section>

      {(prevPost || nextPost) && (
        <nav class="post-nav" aria-labelledby="keep-reading">
          <div class="post-nav__heading">
            <h2 id="keep-reading">Keep reading</h2>
            <a class="post-nav__browse" href={isRagSeries ? '/collections/rag-engineering/' : '/posts/'}>
              {isRagSeries ? 'View series' : 'All posts'} <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class:list={['post-nav__cards', { 'post-nav__cards--single': !(prevPost && nextPost) }]}>
            {prevPost && (
              <a href={prevPost.href} rel="prev" class="post-nav__link">
                <span class="post-nav__kicker">
                  <span>Previous article</span>
                  <span class="post-nav__icon" aria-hidden="true">&larr;</span>
                </span>
                <strong class="post-nav__title">{prevPost.title}</strong>
              </a>
            )}
            {nextPost && (
              <a href={nextPost.href} rel="next" class="post-nav__link post-nav__link--next">
                <span class="post-nav__kicker">
                  <span>Next article</span>
                  <span class="post-nav__icon" aria-hidden="true">&rarr;</span>
                </span>
                <strong class="post-nav__title">{nextPost.title}</strong>
              </a>
            )}
          </div>
        </nav>
      )}
    </article>
  </BlogShell>
</BaseLayout>


<style>
  .post { min-width: 0; width: 100%; max-width: var(--reading-width); margin-inline: auto; }
  .post-header {
    position: relative; margin-bottom: 2rem; padding: clamp(1.25rem, 2.6vw, 2rem);
    border: 1px solid var(--accent-line); border-radius: .75rem;
    background: color-mix(in srgb, var(--accent-soft) 65%, var(--surface));
  }
  .post-header::before { content: ''; position: absolute; top: 1.6rem; bottom: 1.6rem; left: -1px; width: 4px; border-radius: 4px; background: var(--accent); }
  .post-header h1 { font-size: clamp(2rem, 3.5vw, 3.1rem); line-height: 1.18; letter-spacing: -.035em; max-width: 28ch; }
  .post-header__summary { max-width: 60ch; font-size: 1.08rem; line-height: 1.7; }
  .post-meta { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; color: var(--muted); font-size: .875rem; }
  .post-taxonomy { display: grid; gap: .75rem; margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--accent-line); }
  .post-taxonomy__group { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); align-items: start; gap: .75rem; }
  .post-taxonomy__label { padding-top: .4rem; font-size: .8125rem; color: var(--muted); }
  .post-categories, .post-tags { display: flex; flex-wrap: wrap; gap: .5rem; min-width: 0; }
  .post-nav { width: min(100%, var(--reading-width)); margin: 3.5rem auto 0; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .post-nav__heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .75rem; margin-bottom: 1rem; }
  .post-nav__heading h2 { margin: 0; font-size: 1.15rem; font-weight: 600; letter-spacing: -.025em; color: var(--ink); }
  .post-nav__browse { color: var(--accent); font-size: .82rem; font-weight: 600; text-decoration: none; }
  .post-nav__browse:hover { text-decoration: underline; text-underline-offset: .25em; }
  .post-nav__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .post-nav__cards--single { grid-template-columns: 1fr; }
  .post-nav__link {
    --nav-accent: var(--accent); --nav-tint: var(--accent-soft); --nav-line: var(--line);
    display: flex; flex-direction: column; gap: 1rem; min-width: 0; padding: 1.25rem;
    border: 1px solid var(--nav-line); border-radius: .5rem;
    background: var(--surface);
    color: var(--ink); text-decoration: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  .post-nav__link:hover { border-color: var(--nav-accent); transform: translateY(-3px); box-shadow: 0 8px 22px color-mix(in srgb, var(--nav-accent) 12%, transparent); }
  .post-nav__link:focus-visible, .post-nav__browse:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .post-nav__kicker { display: flex; justify-content: space-between; align-items: center; gap: .75rem; color: var(--nav-accent); font-size: .875rem; font-weight: 600; }
  .post-nav__icon { display: grid; place-items: center; width: 2rem; height: 2rem; background: transparent; font-size: 1.1rem; transition: transform 180ms ease; }
  .post-nav__link:hover .post-nav__icon { transform: translateX(-3px); }
  .post-nav__link--next:hover .post-nav__icon { transform: translateX(3px); }
  .post-nav__title { font-size: 1.02rem; font-weight: 600; line-height: 1.5; letter-spacing: -.015em; overflow-wrap: anywhere; }
  .post-mobile-contents { display: none; width: min(100%, var(--reading-width)); margin: 0 auto 2rem; }
  @media (max-width: 1023px) { .post-mobile-contents { display: block; } }
  @media (max-width: 767px) {
    .post-taxonomy__group { grid-template-columns: minmax(0, 1fr); gap: .35rem; }
    .post-taxonomy__label { padding-top: 0; }
    .post-nav__cards { grid-template-columns: 1fr; gap: .75rem; }
    .post-nav__link { gap: .65rem; padding: 1.1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-nav__link, .post-nav__icon { transition: none; }
    .post-nav__link:hover, .post-nav__link:hover .post-nav__icon { transform: none; }
  }
</style>
