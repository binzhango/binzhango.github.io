---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogShell from '../../components/BlogShell.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getAdjacentPosts, getPostPath, getAllPosts, slugifyId, type Post } from '../../utils/post-utils';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: slugifyId(post.id) },
    props: { postId: post.id },
  }));
}

interface Props {
  postId: string;
}

const { postId } = Astro.props as Props;
const post = await getEntry('blog', postId);

if (!post) {
  throw new Error(`Post not found for id: ${postId}`);
}

const { Content, headings } = await render(post);
const adjacent = await getAdjacentPosts(post.id);

const pageTitle = post.data.title;
const pageDescription = post.data.excerpt ?? post.data.description ?? '';

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function formatDateTime(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toISOString();
}

function estimateReadingTime(content: string): string {
  const plainText = content
    .replace(/^---[\s\S]*?---/, ' ')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/!\[[^\]]*]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[#>*_\-\[\]()]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const words = plainText ? plainText.split(' ').length : 0;
  const minutes = Math.max(1, Math.ceil(words / 220));
  return `${minutes} min read`;
}

function toNav(postEntry: Post | null) {
  if (!postEntry) return null;
  return {
    href: getPostPath(postEntry),
    title: postEntry.data.title,
  };
}

const prevPost = toNav(adjacent.prev);
const nextPost = toNav(adjacent.next);
const currentPath = getPostPath(post);
const readingTime = estimateReadingTime(post.body ?? '');
const sectionHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const tocHeadings = sectionHeadings.length > 0 ? sectionHeadings : headings.filter((heading) => heading.depth === 1);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <BlogShell currentPath={currentPath} reserveSecondary={true}>
    {tocHeadings.length > 0 && (
      <Fragment slot="secondary">
        <nav class="post-toc" aria-label="On this page" data-post-toc>
          <p class="post-toc__title">On this page</p>
          <ul class="post-toc__list">
            {tocHeadings.map((heading) => (
              <li class:list={['post-toc__item', { 'post-toc__item--nested': heading.depth > 2 }]}>
                <a
                  class="post-toc__link"
                  href={`#${heading.slug}`}
                  data-toc-link
                  data-depth={heading.depth}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </Fragment>
    )}

    <article class="post">
      <header class="post-header">
        <div class="post-header__eyebrow">
          <span class="post-header__eyebrow-label">Article</span>
          {post.data.categories?.[0] && <span class="post-header__eyebrow-topic">{post.data.categories[0]}</span>}
        </div>
        <h1>{post.data.title}</h1>
        {pageDescription && <p class="post-header__summary">{pageDescription}</p>}
        <div class="post-meta">
          <span class="post-meta__item" aria-label="Published date">
            <time class="post-meta__value" datetime={formatDateTime(post.data.date)}>{formatDate(post.data.date)}</time>
          </span>
          {post.data.author && (
            <span class="post-meta__item" aria-label="Author">
              <span class="post-meta__value">{post.data.author}</span>
            </span>
          )}
          <span class="post-meta__item" aria-label="Reading time">
            <span class="post-meta__value">{readingTime}</span>
          </span>
        </div>
        {((post.data.categories && post.data.categories.length > 0) || (post.data.tags && post.data.tags.length > 0)) && (
          <div class="post-taxonomy">
            {post.data.categories && post.data.categories.length > 0 && (
              <div class="post-taxonomy__group">
                <span class="post-taxonomy__label">Categories</span>
                <div class="post-categories">
                  {post.data.categories.map((category) => (
                    <CategoryBadge category={category} link={true} />
                  ))}
                </div>
              </div>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-taxonomy__group">
                <span class="post-taxonomy__label">Tags</span>
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <TagBadge tag={tag} link={true} />
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </header>

      <section class="post-content">
        <Content />
      </section>

      {(prevPost || nextPost) && (
        <nav class:list={['post-nav', { 'post-nav--single': !(prevPost && nextPost) }]} aria-label="Post navigation">
          <div class:list={['post-nav__item', 'post-nav__item--prev', { 'post-nav__item--empty': !prevPost }]}>
            {prevPost && (
              <a href={prevPost.href} class="post-nav__link">
                <span class="post-nav__eyebrow">Previous</span>
                <strong class="post-nav__title">{prevPost.title}</strong>
              </a>
            )}
          </div>
          <div class:list={['post-nav__item', 'post-nav__item--next', { 'post-nav__item--empty': !nextPost }]}>
            {nextPost && (
              <a href={nextPost.href} class="post-nav__link">
                <span class="post-nav__eyebrow">Next</span>
                <strong class="post-nav__title">{nextPost.title}</strong>
              </a>
            )}
          </div>
        </nav>
      )}
    </article>
  </BlogShell>
</BaseLayout>

<style>
  .post {
    max-width: 100%;
    margin-inline: auto;
  }

  .post-header {
    position: relative;
    margin-bottom: 1.8rem;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--sl-color-hairline) 82%, transparent);
    border-radius: 1.6rem;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--sl-color-text-accent) 14%, transparent) 0, transparent 34%),
      linear-gradient(165deg, color-mix(in srgb, var(--sl-color-bg-nav) 88%, white 12%) 0%, color-mix(in srgb, var(--sl-color-bg) 94%, transparent) 100%);
    box-shadow:
      0 1.2rem 2.5rem color-mix(in srgb, var(--sl-color-black) 7%, transparent),
      inset 0 1px 0 color-mix(in srgb, white 72%, transparent);
    overflow: hidden;
  }

  .post-header::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 0.35rem;
    background: linear-gradient(90deg, #ff8a00 0%, #00a6fb 52%, #0f766e 100%);
    opacity: 0.92;
  }

  .post-header__eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .post-header__eyebrow-label,
  .post-header__eyebrow-topic {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-header__eyebrow-label {
    color: #0f172a;
    background: linear-gradient(135deg, #f8d36a, #f4a261);
  }

  .post-header__eyebrow-topic {
    color: color-mix(in srgb, var(--sl-color-text-accent) 74%, var(--sl-color-text));
    background: color-mix(in srgb, var(--sl-color-text-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 16%, transparent);
  }

  .post-header h1 {
    margin-top: 0;
    margin-bottom: 0.9rem;
    font-size: clamp(2rem, 4vw, 2.85rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .post-header__summary {
    max-width: 56ch;
    margin: 0 0 1rem;
    font-size: 1.02rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--sl-color-text) 74%, var(--sl-color-gray-6));
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    width: 100%;
    margin-bottom: 1.15rem;
    color: color-mix(in srgb, var(--sl-color-text) 62%, var(--sl-color-gray-6));
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .post-meta__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    position: relative;
  }

  .post-meta__item::before {
    content: '';
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #ff8a00 0%, #00a6fb 100%);
    box-shadow: 0 0 0 0.18rem color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
    flex: 0 0 auto;
  }

  .post-meta__value {
    color: color-mix(in srgb, var(--sl-color-text) 80%, var(--sl-color-gray-6));
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-meta__item:nth-child(2) .post-meta__value::before {
    content: 'By ';
    color: color-mix(in srgb, var(--sl-color-text) 46%, var(--sl-color-gray-6));
    font-weight: 500;
  }

  .post-meta__item:hover .post-meta__value {
    color: var(--sl-color-text);
  }

  .post-taxonomy {
    display: grid;
    gap: 0.9rem;
  }

  .post-taxonomy__group {
    display: grid;
    gap: 0.5rem;
  }

  .post-taxonomy__label {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding-left: 0.8rem;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-6);
    position: relative;
  }

  .post-taxonomy__label::before {
    content: '';
    position: absolute;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--sl-color-text-accent), var(--sl-color-accent));
  }

  .post-categories,
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-content {
    position: relative;
    padding: clamp(1.3rem, 2vw, 1.8rem);
    border: 1px solid color-mix(in srgb, var(--sl-color-hairline) 82%, transparent);
    border-radius: 1.6rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--sl-color-bg-nav) 78%, transparent) 0%, color-mix(in srgb, var(--sl-color-bg) 96%, transparent) 100%);
    box-shadow: 0 1.1rem 2.4rem color-mix(in srgb, var(--sl-color-black) 5%, transparent);
    line-height: 1.72;
  }

  .post-nav {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .post-nav--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .post-nav__item {
    min-width: 0;
  }

  .post-nav__item--empty {
    display: none;
  }

  .post-nav__link {
    min-height: 6.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.45rem;
    padding: 0.95rem 1rem 1rem;
    text-decoration: none;
    color: var(--sl-color-text) !important;
    border: 1px solid color-mix(in srgb, var(--sl-color-hairline) 82%, transparent);
    border-radius: 1.2rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--sl-color-bg-nav) 72%, transparent) 0%, color-mix(in srgb, var(--sl-color-bg) 94%, transparent) 100%);
    box-shadow: 0 0.8rem 1.6rem color-mix(in srgb, var(--sl-color-black) 5%, transparent);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .post-nav__item--next .post-nav__link {
    text-align: right;
  }

  .post-nav__link:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--sl-color-text-accent) 32%, var(--sl-color-hairline));
    background: color-mix(in srgb, var(--sl-color-bg-nav) 88%, var(--sl-color-text-accent) 6%);
    box-shadow: 0 1.1rem 2rem color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
  }

  .post-nav__link:focus-visible {
    outline: none;
    border-color: color-mix(in srgb, var(--sl-color-text-accent) 42%, var(--sl-color-hairline));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-text-accent) 14%, transparent);
  }

  .post-nav__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-5);
  }

  .post-nav__item--prev .post-nav__eyebrow::before {
    content: '\2190';
    font-size: 0.9rem;
    line-height: 1;
  }

  .post-nav__item--next .post-nav__eyebrow {
    justify-content: flex-end;
  }

  .post-nav__item--next .post-nav__eyebrow::after {
    content: '\2192';
    font-size: 0.9rem;
    line-height: 1;
  }

  .post-nav__title {
    display: block;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--sl-color-text) !important;
    text-wrap: balance;
  }

  :root[data-theme='dark'] .post-nav__link {
    background: color-mix(in srgb, var(--sl-color-bg-nav) 70%, transparent);
  }

  :root[data-theme='dark'] .post-nav__link:hover {
    background: color-mix(in srgb, var(--sl-color-bg-nav) 82%, var(--sl-color-text-accent) 7%);
  }

  .post-toc {
    width: 100%;
    box-sizing: border-box;
    color: var(--sl-color-text);
    padding: 1rem 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-hairline) 86%, transparent);
    border-radius: 1.25rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--sl-color-bg-nav) 80%, transparent) 0%, color-mix(in srgb, var(--sl-color-bg) 94%, transparent) 100%);
    box-shadow: 0 1rem 2rem color-mix(in srgb, var(--sl-color-black) 4%, transparent);
    max-height: calc(100vh - 6rem);
    overflow: auto;
    scrollbar-width: thin;
  }

  .post-toc__title {
    margin: 0 0 0.95rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-text);
  }

  .post-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .post-toc__item--nested {
    margin-left: 0;
  }

  .post-toc__link {
    display: block;
    padding: 0.45rem 0.65rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--sl-color-text) 54%, transparent) !important;
    font-size: 0.82rem;
    line-height: 1.35;
    word-break: break-word;
    overflow-wrap: anywhere;
    font-weight: 600;
    border-radius: 0.8rem;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    transition:
      color 0.16s ease,
      background-color 0.16s ease,
      transform 0.16s ease;
  }

  .post-toc__item--nested .post-toc__link {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--sl-color-text) 42%, transparent) !important;
    padding-left: 1rem;
  }

  .post-toc__link:hover {
    color: var(--sl-color-text) !important;
    background: color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
    transform: translateX(2px);
  }

  .post-toc__link.is-active,
  .post-toc__link[aria-current='location'] {
    color: var(--sl-color-text-accent) !important;
    font-weight: 700;
    background: color-mix(in srgb, var(--sl-color-text-accent) 13%, transparent);
  }

  :root[data-theme='dark'] .post-toc__link.is-active,
  :root[data-theme='dark'] .post-toc__link[aria-current='location'] {
    color: #60a5fa !important;
  }

  :root[data-theme='dark'] .post-header,
  :root[data-theme='dark'] .post-content,
  :root[data-theme='dark'] .post-toc,
  :root[data-theme='dark'] .post-nav__link {
    box-shadow:
      0 1rem 2rem rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  :root[data-theme='dark'] .post-header__eyebrow-label {
    color: #1f2937;
  }

  :root[data-theme='dark'] .post-meta {
    color: color-mix(in srgb, var(--sl-color-gray-5) 84%, var(--sl-color-text));
  }

  :root[data-theme='dark'] .post-meta__value {
    color: color-mix(in srgb, white 76%, var(--sl-color-gray-5));
  }

  @media (max-width: 640px) {
    .post-header,
    .post-content {
      padding: 1rem;
      border-radius: 1.15rem;
    }

    .post-header__eyebrow {
      gap: 0.45rem;
      margin-bottom: 0.8rem;
    }

    .post-header__summary {
      font-size: 0.98rem;
      line-height: 1.65;
    }

    .post-meta {
      gap: 0.6rem 0.85rem;
    }

    .post-meta__value {
      font-size: 0.92rem;
    }

    .post-nav {
      margin-top: 2.5rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.7rem;
    }

    .post-nav--single {
      grid-template-columns: 1fr;
    }

    .post-nav__link {
      min-height: 5.4rem;
      padding: 0.85rem 0.85rem 0.9rem;
    }

    .post-nav__item--next .post-nav__link {
      text-align: right;
    }

    .post-nav__item--next .post-nav__eyebrow {
      justify-content: flex-end;
    }

    .post-nav__item--next .post-nav__eyebrow::after {
      content: '\2192';
      font-size: 0.9rem;
      line-height: 1;
    }

    .post-nav__item--next .post-nav__eyebrow::before {
      content: none;
    }

    .post-nav__title {
      font-size: 0.94rem;
      line-height: 1.35;
    }
  }
</style>

<script>
  type TocEntry = {
    id: string;
    heading: HTMLElement;
    link: HTMLAnchorElement;
  };

  type TocWindow = Window & {
    __blogPostTocCleanup?: () => void;
  };

  function initPostToc() {
    const state = window as TocWindow;
    state.__blogPostTocCleanup?.();

    const toc = document.querySelector<HTMLElement>('[data-post-toc]');
    if (!toc) {
      return;
    }

    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const entries: TocEntry[] = links
      .map((link) => {
        const href = link.getAttribute('href');
        if (!href?.startsWith('#')) return null;
        const id = decodeURIComponent(href.slice(1));
        const heading = document.getElementById(id);
        if (!heading) return null;
        return { id, heading, link };
      })
      .filter((entry): entry is TocEntry => entry !== null);

    if (!entries.length) {
      return;
    }

    let activeId = '';
    let frame = 0;

    const keepLinkVisible = (link: HTMLAnchorElement) => {
      const tocRect = toc.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      const relativeTop = linkRect.top - tocRect.top + toc.scrollTop;
      const targetTop = Math.max(0, relativeTop - (toc.clientHeight - linkRect.height) / 2);
      const maxTop = Math.max(0, toc.scrollHeight - toc.clientHeight);
      toc.scrollTo({
        top: Math.min(targetTop, maxTop),
        behavior: 'auto',
      });
    };

    const setActive = (id: string) => {
      if (activeId === id) return;
      activeId = id;

      for (const entry of entries) {
        const isActive = entry.id === id;
        entry.link.classList.toggle('is-active', isActive);
        if (isActive) {
          entry.link.setAttribute('aria-current', 'location');
          keepLinkVisible(entry.link);
        } else {
          entry.link.removeAttribute('aria-current');
        }
      }
    };

    const getCurrentId = () => {
      const readingLine = Math.min(window.innerHeight * 0.32, 260);

      for (let index = 0; index < entries.length; index += 1) {
        const current = entries[index];
        const next = entries[index + 1];
        const currentTop = current.heading.getBoundingClientRect().top;
        const nextTop = next ? next.heading.getBoundingClientRect().top : Number.POSITIVE_INFINITY;

        if (currentTop <= readingLine && nextTop > readingLine) {
          return current.id;
        }
      }

      const firstVisible = entries.find((entry) => entry.heading.getBoundingClientRect().top > 0);
      if (firstVisible) return firstVisible.id;
      return entries[entries.length - 1].id;
    };

    const syncActive = () => setActive(getCurrentId());

    const scheduleSync = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        syncActive();
      });
    };

    for (const entry of entries) {
      entry.link.addEventListener('click', () => setActive(entry.id));
    }

    syncActive();
    window.addEventListener('scroll', scheduleSync, { passive: true });
    document.addEventListener('scroll', scheduleSync, { passive: true, capture: true });
    window.addEventListener('resize', scheduleSync);

    state.__blogPostTocCleanup = () => {
      if (frame) {
        window.cancelAnimationFrame(frame);
        frame = 0;
      }
      window.removeEventListener('scroll', scheduleSync);
      document.removeEventListener('scroll', scheduleSync, true);
      window.removeEventListener('resize', scheduleSync);
    };
  }

  initPostToc();
  document.addEventListener('astro:page-load', initPostToc);
</script>
