---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogShell from '../../components/BlogShell.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getAdjacentPosts, getPostPath, getAllPosts, slugifyId, type Post } from '../../utils/post-utils';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: slugifyId(post.id) },
    props: { postId: post.id },
  }));
}

interface Props {
  postId: string;
}

const { postId } = Astro.props as Props;
const post = await getEntry('blog', postId);

if (!post) {
  throw new Error(`Post not found for id: ${postId}`);
}

const { Content, headings } = await render(post);
const adjacent = await getAdjacentPosts(post.id);

const pageTitle = post.data.title;
const pageDescription = post.data.excerpt ?? post.data.description ?? '';

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function toNav(postEntry: Post | null) {
  if (!postEntry) return null;
  return {
    href: getPostPath(postEntry),
    title: postEntry.data.title,
  };
}

const prevPost = toNav(adjacent.prev);
const nextPost = toNav(adjacent.next);
const currentPath = getPostPath(post);
const sectionHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const tocHeadings = sectionHeadings.length > 0 ? sectionHeadings : headings.filter((heading) => heading.depth === 1);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <BlogShell currentPath={currentPath} reserveSecondary={true}>
    {tocHeadings.length > 0 && (
      <Fragment slot="secondary">
        <nav class="post-toc" aria-label="On this page" data-post-toc>
          <p class="post-toc__title">On this page</p>
          <ul class="post-toc__list">
            {tocHeadings.map((heading) => (
              <li class:list={['post-toc__item', { 'post-toc__item--nested': heading.depth > 2 }]}>
                <a
                  class="post-toc__link"
                  href={`#${heading.slug}`}
                  data-toc-link
                  data-depth={heading.depth}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </Fragment>
    )}

    <article class="post">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <span>{formatDate(post.data.date)}</span>
          {post.data.author && <span>By {post.data.author}</span>}
        </div>
        {post.data.categories && post.data.categories.length > 0 && (
          <div class="post-categories">
            {post.data.categories.map((category) => (
              <CategoryBadge category={category} link={true} />
            ))}
          </div>
        )}
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <TagBadge tag={tag} link={true} />
            ))}
          </div>
        )}
      </header>

      <section class="post-content">
        <Content />
      </section>

      {(prevPost || nextPost) && (
        <nav class:list={['post-nav', { 'post-nav--single': !(prevPost && nextPost) }]} aria-label="Post navigation">
          <div class:list={['post-nav__item', 'post-nav__item--prev', { 'post-nav__item--empty': !prevPost }]}>
            {prevPost && (
              <a href={prevPost.href} class="post-nav__link">
                <span class="post-nav__eyebrow">Previous</span>
                <strong class="post-nav__title">{prevPost.title}</strong>
              </a>
            )}
          </div>
          <div class:list={['post-nav__item', 'post-nav__item--next', { 'post-nav__item--empty': !nextPost }]}>
            {nextPost && (
              <a href={nextPost.href} class="post-nav__link">
                <span class="post-nav__eyebrow">Next</span>
                <strong class="post-nav__title">{nextPost.title}</strong>
              </a>
            )}
          </div>
        </nav>
      )}
    </article>
  </BlogShell>
</BaseLayout>

<style>
  .post {
    max-width: 48rem;
    margin-inline: auto;
  }

  .post-header h1 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 4vw, 2.85rem);
    line-height: 1.05;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--sl-color-gray-6);
    font-size: 0.92rem;
    margin-bottom: 1rem;
  }

  .post-categories,
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.75rem;
  }

  .post-content {
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 1.15rem;
    line-height: 1.72;
  }

  .post-nav {
    margin-top: 3rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--sl-color-hairline);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .post-nav--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .post-nav__item {
    min-width: 0;
  }

  .post-nav__item--empty {
    display: none;
  }

  .post-nav__link {
    min-height: 6.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.45rem;
    padding: 0.95rem 1rem 1rem;
    text-decoration: none;
    color: var(--sl-color-text) !important;
    border-top: 2px solid color-mix(in srgb, var(--sl-color-text-accent) 22%, var(--sl-color-hairline));
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--sl-color-bg-nav) 68%, transparent);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease;
  }

  .post-nav__item--next .post-nav__link {
    text-align: right;
  }

  .post-nav__link:hover {
    transform: translateY(-1px);
    border-top-color: color-mix(in srgb, var(--sl-color-text-accent) 38%, var(--sl-color-hairline));
    background: color-mix(in srgb, var(--sl-color-bg-nav) 88%, var(--sl-color-text-accent) 6%);
  }

  .post-nav__link:focus-visible {
    outline: none;
    border-top-color: color-mix(in srgb, var(--sl-color-text-accent) 42%, var(--sl-color-hairline));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-text-accent) 14%, transparent);
  }

  .post-nav__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-5);
  }

  .post-nav__item--prev .post-nav__eyebrow::before {
    content: '\2190';
    font-size: 0.9rem;
    line-height: 1;
  }

  .post-nav__item--next .post-nav__eyebrow {
    justify-content: flex-end;
  }

  .post-nav__item--next .post-nav__eyebrow::after {
    content: '\2192';
    font-size: 0.9rem;
    line-height: 1;
  }

  .post-nav__title {
    display: block;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--sl-color-text) !important;
    text-wrap: balance;
  }

  :root[data-theme='dark'] .post-nav__link {
    background: color-mix(in srgb, var(--sl-color-bg-nav) 70%, transparent);
  }

  :root[data-theme='dark'] .post-nav__link:hover {
    background: color-mix(in srgb, var(--sl-color-bg-nav) 82%, var(--sl-color-text-accent) 7%);
  }

  .post-toc {
    width: 100%;
    box-sizing: border-box;
    color: var(--sl-color-text);
    max-height: calc(100vh - 6rem);
    overflow: auto;
    scrollbar-width: thin;
  }

  .post-toc__title {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #111827;
  }

  .post-toc__list {
    list-style: none;
    margin: 0;
    padding: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .post-toc__item--nested {
    margin-left: 0;
  }

  .post-toc__link {
    display: block;
    padding: 0.2rem 0;
    text-decoration: none;
    color: #6b7280 !important;
    font-size: 0.82rem;
    line-height: 1.35;
    word-break: break-word;
    overflow-wrap: anywhere;
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    transition: color 0.16s ease;
  }

  .post-toc__item--nested .post-toc__link {
    font-size: 0.78rem;
    color: #98a2b3 !important;
    padding-left: 0.9rem;
  }

  .post-toc__link:hover {
    color: #111827 !important;
  }

  .post-toc__link.is-active,
  .post-toc__link[aria-current='location'] {
    color: #2563eb !important;
    font-weight: 600;
  }

  :root[data-theme='dark'] .post-toc__link.is-active,
  :root[data-theme='dark'] .post-toc__link[aria-current='location'] {
    color: #60a5fa !important;
  }

  @media (max-width: 640px) {
    .post-nav {
      margin-top: 2.5rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.7rem;
    }

    .post-nav--single {
      grid-template-columns: 1fr;
    }

    .post-nav__link {
      min-height: 5.4rem;
      padding: 0.85rem 0.85rem 0.9rem;
    }

    .post-nav__item--next .post-nav__link {
      text-align: right;
    }

    .post-nav__item--next .post-nav__eyebrow {
      justify-content: flex-end;
    }

    .post-nav__item--next .post-nav__eyebrow::after {
      content: '\2192';
      font-size: 0.9rem;
      line-height: 1;
    }

    .post-nav__item--next .post-nav__eyebrow::before {
      content: none;
    }

    .post-nav__title {
      font-size: 0.94rem;
      line-height: 1.35;
    }
  }
</style>

<script>
  type TocEntry = {
    id: string;
    heading: HTMLElement;
    link: HTMLAnchorElement;
  };

  type TocWindow = Window & {
    __blogPostTocCleanup?: () => void;
  };

  function initPostToc() {
    const state = window as TocWindow;
    state.__blogPostTocCleanup?.();

    const toc = document.querySelector<HTMLElement>('[data-post-toc]');
    if (!toc) {
      return;
    }

    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const entries: TocEntry[] = links
      .map((link) => {
        const href = link.getAttribute('href');
        if (!href?.startsWith('#')) return null;
        const id = decodeURIComponent(href.slice(1));
        const heading = document.getElementById(id);
        if (!heading) return null;
        return { id, heading, link };
      })
      .filter((entry): entry is TocEntry => entry !== null);

    if (!entries.length) {
      return;
    }

    const setActive = (id: string) => {
      for (const entry of entries) {
        const isActive = entry.id === id;
        entry.link.classList.toggle('is-active', isActive);
        if (isActive) {
          entry.link.setAttribute('aria-current', 'location');
        } else {
          entry.link.removeAttribute('aria-current');
        }
      }
    };

    const syncActive = () => {
      let currentId = entries[0].id;
      for (const entry of entries) {
        if (entry.heading.getBoundingClientRect().top <= 140) {
          currentId = entry.id;
        } else {
          break;
        }
      }
      setActive(currentId);
    };

    for (const entry of entries) {
      entry.link.addEventListener('click', () => setActive(entry.id));
    }

    syncActive();
    window.addEventListener('scroll', syncActive, { passive: true });
    window.addEventListener('resize', syncActive);

    state.__blogPostTocCleanup = () => {
      window.removeEventListener('scroll', syncActive);
      window.removeEventListener('resize', syncActive);
    };
  }

  initPostToc();
  document.addEventListener('astro:page-load', initPostToc);
</script>
