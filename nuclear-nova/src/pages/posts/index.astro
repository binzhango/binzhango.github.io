---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogShell from '../../components/BlogShell.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getAllPosts, getPostPath } from '../../utils/post-utils';
import { getPostExcerpt } from '../../utils/excerpt';

const posts = await getAllPosts();

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title="Blog Posts" description="All blog posts">
  <BlogShell currentPath={Astro.url.pathname}>
    <header class="posts-header">
      <p class="posts-eyebrow">Blog</p>
      <h1>All posts</h1>
      <p class="posts-description">Notes on LLMs, machine learning, data engineering, and systems work.</p>
    </header>
    <div class="posts-list">
      {posts.map((post) => (
        <article class="post-item">
          <div class="post-item__top">
            <p class="post-item__date">{formatDate(post.data.date)}</p>
            <h2><a href={getPostPath(post)}>{post.data.title}</a></h2>
          </div>
          {post.data.categories && post.data.categories.length > 0 && (
            <div class="post-categories">
              {post.data.categories.map((category) => (
                <CategoryBadge category={category} link={true} />
              ))}
            </div>
          )}
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <TagBadge tag={tag} link={true} />
              ))}
            </div>
          )}
          <p>{getPostExcerpt(post, 180)}</p>
        </article>
      ))}
    </div>
  </BlogShell>
</BaseLayout>

<style>
  :global(body) .posts-header.posts-header.posts-header {
    --page-surface-bg:
      radial-gradient(circle at 12% 10%, rgba(248, 204, 101, 0.16), transparent 28%),
      linear-gradient(
        180deg,
        rgba(246, 238, 225, 0.98) 0%,
        rgba(239, 228, 210, 0.96) 100%
      );
    display: grid;
    gap: 0.45rem;
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding: 1.3rem 1.35rem;
    border: 1px solid var(--clay-border);
    border-radius: 32px;
    background:
      radial-gradient(circle at 12% 10%, rgba(248, 204, 101, 0.16), transparent 28%),
      linear-gradient(
        180deg,
        rgba(246, 238, 225, 0.98) 0%,
        rgba(239, 228, 210, 0.96) 100%
      ) !important;
    box-shadow:
      inset 0 0 0 9999px rgba(246, 238, 225, 0.72),
      var(--clay-shadow);
  }

  .posts-eyebrow {
    margin: 0;
    color: var(--clay-muted);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .posts-description {
    margin: 0;
    color: var(--clay-charcoal);
    max-width: 42rem;
  }

  .posts-list {
    display: grid;
    gap: 1rem;
  }

  .post-item {
    display: grid;
    gap: 0.8rem;
    padding: 1.2rem;
    border: 1px solid var(--clay-border);
    border-radius: 24px;
    background-image: linear-gradient(150deg, rgba(255, 255, 255, 0.26), transparent 34%) !important;
    background-color: rgba(246, 238, 225, 0.94) !important;
    box-shadow: var(--clay-shadow);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }

  .post-item:hover {
    border-color: color-mix(in srgb, var(--clay-blueberry-800) 24%, var(--clay-border));
    transform: translateY(-0.12rem);
    box-shadow:
      0 14px 28px rgba(58, 44, 24, 0.12),
      0 0 0 1px rgba(255, 255, 255, 0.5) inset;
  }

  .post-item__top {
    display: grid;
    gap: 0.45rem;
  }

  .post-item h2 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .post-item h2 a {
    text-decoration: none;
    color: var(--sl-color-text);
  }

  .post-item__date {
    margin: 0;
    color: var(--clay-muted);
    font-family: var(--font-space-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-categories,
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .post-item p:last-child {
    margin: 0;
    color: var(--clay-charcoal);
  }

  :root[data-theme='dark'] .post-item:hover {
    border-color: color-mix(in srgb, var(--clay-border) 50%, var(--clay-slushie-500) 50%);
    box-shadow:
      0 18px 32px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.045) inset,
      0 0 24px color-mix(in srgb, var(--clay-slushie-500) 9%, transparent);
  }

  :root[data-theme='dark'] .posts-header,
  :root[data-theme='dark'] .post-item {
    border-color: color-mix(in srgb, var(--clay-border) 72%, var(--clay-slushie-500) 28%);
    box-shadow:
      0 24px 52px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.035) inset,
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 0 30px color-mix(in srgb, var(--clay-slushie-500) 8%, transparent);
  }

  :root[data-theme='dark'] :global(body) .posts-header.posts-header.posts-header {
    --page-surface-bg:
      linear-gradient(120deg, rgba(248, 204, 101, 0.11), transparent 34%),
      linear-gradient(145deg, color-mix(in srgb, var(--clay-paper) 92%, #29313a 8%) 0%, color-mix(in srgb, var(--clay-cream) 84%, var(--clay-slushie-800) 16%) 100%);
    background:
      linear-gradient(120deg, rgba(248, 204, 101, 0.11), transparent 34%),
      linear-gradient(145deg, color-mix(in srgb, var(--clay-paper) 92%, #29313a 8%) 0%, color-mix(in srgb, var(--clay-cream) 84%, var(--clay-slushie-800) 16%) 100%) !important;
    box-shadow:
      0 24px 52px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.035) inset,
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 0 30px color-mix(in srgb, var(--clay-slushie-500) 8%, transparent);
  }

  :root[data-theme='dark'] .post-item {
    background-image: linear-gradient(150deg, rgba(255, 255, 255, 0.025), transparent 32%) !important;
    background-color: #1c1816 !important;
  }
</style>
