---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogShell from '../../components/BlogShell.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getAllPosts, getPostPath } from '../../utils/post-utils';
import { getPostExcerpt } from '../../utils/excerpt';

const posts = await getAllPosts();

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title="Blog Posts" description="All blog posts">
  <BlogShell currentPath={Astro.url.pathname}>
    <header class="posts-header">
      <p class="posts-eyebrow">Blog</p>
      <h1>All posts</h1>
      <p class="posts-description">Notes on LLMs, machine learning, data engineering, and systems work.</p>
    </header>
    <div class="posts-list">
      {posts.map((post) => (
        <article class="post-item">
          <div class="post-item__top">
            <p class="post-item__date">{formatDate(post.data.date)}</p>
            <h2><a href={getPostPath(post)}>{post.data.title}</a></h2>
          </div>
          {post.data.categories && post.data.categories.length > 0 && (
            <div class="post-categories">
              {post.data.categories.map((category) => (
                <CategoryBadge category={category} link={true} />
              ))}
            </div>
          )}
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <TagBadge tag={tag} link={true} />
              ))}
            </div>
          )}
          <p>{getPostExcerpt(post, 180)}</p>
        </article>
      ))}
    </div>
  </BlogShell>
</BaseLayout>

<style>
  .posts-header {
    display: grid;
    gap: 0.45rem;
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding: 1.3rem 1.35rem;
    border: 1px solid var(--clay-border);
    border-radius: 32px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--clay-paper) 90%, transparent) 0%,
      color-mix(in srgb, var(--clay-cream) 95%, transparent) 100%
    );
    box-shadow: var(--clay-shadow);
  }

  .posts-eyebrow {
    margin: 0;
    color: var(--clay-muted);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .posts-description {
    margin: 0;
    color: var(--clay-charcoal);
    max-width: 42rem;
  }

  .posts-list {
    display: grid;
    gap: 1rem;
  }

  .post-item {
    display: grid;
    gap: 0.8rem;
    padding: 1.2rem;
    border: 1px solid var(--clay-border);
    border-radius: 24px;
    background: color-mix(in srgb, var(--clay-paper) 86%, transparent);
    box-shadow: var(--clay-shadow);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  .post-item:hover {
    transform: translateY(-0.18rem);
    box-shadow: var(--clay-shadow-hard);
  }

  .post-item__top {
    display: grid;
    gap: 0.45rem;
  }

  .post-item h2 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .post-item h2 a {
    text-decoration: none;
    color: var(--sl-color-text);
  }

  .post-item__date {
    margin: 0;
    color: var(--clay-muted);
    font-family: var(--font-space-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-categories,
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .post-item p:last-child {
    margin: 0;
    color: var(--clay-charcoal);
  }
</style>
