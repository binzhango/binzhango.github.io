---
import { getPostsByYear, getPostsByTag, type Post } from '../../utils/post-utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../../components/PostPreview.astro';
import BlogShell from '../../components/BlogShell.astro';
import { slugifyTag } from '../../utils/taxonomy';

interface TagLink {
    slug: string;
    label: string;
}

export async function getStaticPaths() {
    const postsByYear = await getPostsByYear();
    const postsByTag = await getPostsByTag();
    const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a));
    const tagsBySlug = new Map<string, string>();
    for (const tag of Object.keys(postsByTag)) {
        const slug = slugifyTag(tag);
        if (!slug || tagsBySlug.has(slug)) continue;
        tagsBySlug.set(slug, tag);
    }
    const tags = [...tagsBySlug.entries()]
        .map(([slug, label]) => ({ slug, label }))
        .sort((a, b) => a.label.localeCompare(b.label));

    const paths = [
        {
            params: { year: undefined },
            props: {
                year: null,
                postsByYear,
                years,
                tags
            }
        },
        ...years.map(year => ({
            params: { year },
            props: {
                year,
                posts: postsByYear[year],
                years,
                tags
            }
        }))
    ];

    return paths;
}

interface Props {
    year: string | null;
    posts?: Post[];
    postsByYear?: { [year: string]: Post[] };
    years: string[];
    tags: TagLink[];
}

const { year, posts, postsByYear, years, tags } = Astro.props;
const pageTitle = year ? `Archive - ${year}` : 'Archive';
const pageDescription = year ? `Blog posts from ${year}` : 'Browse all blog posts organized by year';


---
<BaseLayout title={pageTitle} description={pageDescription}>
  <BlogShell>
    <details class="archive-tags" data-disclosure><summary>Browse tags</summary><div class="archive-tags__links">{tags.map((tag) => <a href={`/tags/${tag.slug}/`}>{tag.label}</a>)}</div></details>
    <header class="page-heading"><p class="eyebrow">From the archive</p><h1>{year ?? 'A growing notebook.'}</h1><p>{year ? `Everything published in ${year}.` : 'Years of learning, building, and writing things down.'}</p></header>
    {year ? <div class="post-list">{(posts ?? []).map((post) => <PostPreview post={post} />)}</div> : years.map((entry) => (
      <section class="year-section" aria-label={`Posts from ${entry}`}><h2><a href={`/archive/${entry}/`}>{entry}</a> <span class="meta">{postsByYear?.[entry].length} articles</span></h2><div class="post-list">{postsByYear?.[entry].map((post) => <PostPreview post={post} />)}</div></section>
    ))}
  </BlogShell>
</BaseLayout>
<style>.archive-tags { margin-top: -1rem; font-size: .8rem; }.archive-tags__links { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; padding-block: 1rem; max-width: 800px; }.archive-tags__links a { color: var(--muted); }</style>
