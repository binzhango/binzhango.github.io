---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import { getAllPosts, getPostPath } from '../utils/post-utils';
import { getPostExcerpt } from '../utils/excerpt';

const posts = await getAllPosts();
const featured = posts[0];
const recentPosts = posts.slice(1, 7);
const totalPosts = posts.length;
const categoryCounts = new Map<string, number>();

for (const post of posts) {
  for (const category of post.data.categories ?? []) {
    categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
  }
}

const topCategories = Array.from(categoryCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout title="Bin Zhang's Blog" description="Bin Zhang's personal blog and knowledge base.">
  <section class="home-hero" aria-label="Homepage introduction">
    <div class="home-hero__copy">
      <p class="eyebrow">Bin Zhang's Field Notes</p>
      <h1>Modern notes for data, AI, and engineering systems.</h1>
      <p class="lede">
        Practical essays, implementation notes, and mental models for LLMs, infrastructure,
        data platforms, and the craft of building durable software.
      </p>
      <div class="hero-actions">
        <a class="action-button action-button--primary" href="/posts/">Browse posts</a>
        <a class="action-button action-button--secondary" href="/archive/">View archive</a>
      </div>
    </div>

    <aside class="home-hero__panel" aria-label="Blog summary">
      <div class="panel-brand">
        <span class="panel-brand__mark" aria-hidden="true">
          <img src="/assets/favicon.ico" alt="" width="34" height="34" />
        </span>
        <span>
          <span class="panel-brand__label">Knowledge base</span>
          <strong>Technical notes in motion</strong>
        </span>
      </div>

      <div class="metric-grid" aria-label="Publication metrics">
        <div class="metric">
          <span>Posts</span>
          <strong>{totalPosts}</strong>
        </div>
        <div class="metric">
          <span>Topics</span>
          <strong>{categoryCounts.size}</strong>
        </div>
        <div class="metric metric--wide">
          <span>Latest</span>
          <strong>{featured ? formatDate(featured.data.date) : 'Coming soon'}</strong>
        </div>
      </div>

      {topCategories.length > 0 && (
        <div class="topic-cloud" aria-label="Top categories">
          {topCategories.map(([category, count]) => (
            <span class="topic-chip">
              <CategoryBadge category={category} />
              <span>{count}</span>
            </span>
          ))}
        </div>
      )}
    </aside>
  </section>

  <main class="home-board" aria-label="Homepage posts">
    {featured && (
      <section class="featured-section" aria-labelledby="featured-heading">
        <div class="section-heading">
          <p class="eyebrow">Latest dispatch</p>
          <h2 id="featured-heading">Featured article</h2>
        </div>

        <article class="featured-card">
          <div class="featured-card__chrome" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <div class="featured-card__content">
            <p class="meta">{formatDate(featured.data.date)}</p>
            <h3>{featured.data.title}</h3>
            {featured.data.categories && featured.data.categories.length > 0 && (
              <div class="categories">
                {featured.data.categories.map((category) => (
                  <CategoryBadge category={category} link={false} />
                ))}
              </div>
            )}
            <p>{getPostExcerpt(featured, 260)}</p>
            <a class="action-button action-button--primary" href={getPostPath(featured)}>
              Read article
            </a>
          </div>
        </article>
      </section>
    )}

    <section class="recent-section" aria-labelledby="recent-heading">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Fresh from the notebook</p>
          <h2 id="recent-heading">Recent writing</h2>
        </div>
        <a class="section-link" href="/posts/">All posts</a>
      </div>

      <div class="recent-grid">
        {recentPosts.map((post, index) => (
          <article class={`post-card post-card--tone-${index % 4}`}>
            <div class="post-card__top">
              <p class="meta">{formatDate(post.data.date)}</p>
              <span class="post-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            </div>

            <h3>{post.data.title}</h3>
            {post.data.categories && post.data.categories.length > 0 && (
              <div class="categories categories--compact">
                {post.data.categories.slice(0, 2).map((category) => (
                  <CategoryBadge category={category} link={false} />
                ))}
              </div>
            )}
            <p>{getPostExcerpt(post, 140)}</p>
            <a class="post-card__link" href={getPostPath(post)}>Read note</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    gap: clamp(1rem, 2.6vw, 2rem);
    align-items: stretch;
    margin-bottom: clamp(1.3rem, 3vw, 2.3rem);
  }

  .home-hero__copy,
  .home-hero__panel,
  .featured-card,
  .post-card {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--clay-border) 82%, white 18%);
    background: color-mix(in srgb, var(--clay-paper) 92%, transparent);
    box-shadow:
      0 18px 44px rgba(18, 27, 48, 0.08),
      0 1px 0 rgba(255, 255, 255, 0.74) inset;
  }

  .home-hero__copy {
    min-height: clamp(24rem, 42vw, 34rem);
    display: grid;
    align-content: end;
    gap: 1rem;
    padding: clamp(1.2rem, 4vw, 3rem);
    border-radius: 28px;
    background:
      linear-gradient(120deg, rgba(248, 204, 101, 0.28), transparent 34%),
      linear-gradient(145deg, color-mix(in srgb, var(--clay-paper) 95%, white 5%) 0%, color-mix(in srgb, var(--clay-cream) 90%, var(--clay-slushie-500) 10%) 100%);
  }

  .home-hero__copy::before {
    content: '';
    position: absolute;
    inset: auto 1.1rem 1.1rem auto;
    width: min(28rem, 42%);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--clay-border) 76%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--clay-blueberry-800) 18%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--clay-blueberry-800) 14%, transparent) 1px, transparent 1px);
    background-size: 18px 18px;
    opacity: 0.42;
    transform: rotate(-4deg);
    pointer-events: none;
  }

  .home-hero__copy > * {
    position: relative;
    z-index: 1;
  }

  .eyebrow,
  .meta,
  .metric span,
  .panel-brand__label {
    margin: 0;
    color: var(--clay-muted);
    font-family: var(--font-space-mono, var(--font-fira-code));
    font-size: 0.72rem;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(3.1rem, 7vw, 7.3rem);
    line-height: 0.88;
    text-wrap: balance;
  }

  .lede {
    max-width: 46rem;
    margin: 0;
    color: var(--clay-charcoal);
    font-size: clamp(1rem, 1.4vw, 1.22rem);
    line-height: 1.62;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.25rem;
  }

  .action-button,
  .section-link,
  .post-card__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.45rem;
    padding: 0.58rem 0.9rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .action-button--primary {
    border: 1px solid color-mix(in srgb, var(--clay-blueberry-800) 84%, black 16%);
    background: var(--clay-blueberry-800) !important;
    background-color: var(--clay-blueberry-800) !important;
    color: #ffffff !important;
    box-shadow: 0 12px 26px rgba(1, 65, 141, 0.18);
  }

  .action-button--secondary,
  .section-link,
  .post-card__link {
    border: 1px solid color-mix(in srgb, var(--clay-border) 76%, white 24%);
    background: color-mix(in srgb, var(--clay-paper) 84%, transparent) !important;
    background-color: color-mix(in srgb, var(--clay-paper) 84%, transparent) !important;
    color: var(--sl-color-text) !important;
  }

  .action-button:hover,
  .section-link:hover,
  .post-card__link:hover {
    color: #ffffff !important;
    background: var(--clay-pomegranate-400) !important;
    background-color: var(--clay-pomegranate-400) !important;
    border-color: var(--clay-pomegranate-400);
    box-shadow: var(--clay-shadow-hard);
    transform: translateY(-2px);
  }

  .home-hero__panel {
    display: grid;
    align-content: space-between;
    gap: 1.05rem;
    min-height: 100%;
    padding: clamp(1rem, 2.2vw, 1.45rem);
    border-radius: 24px;
  }

  .home-hero__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--clay-slushie-500) 18%, transparent), transparent 42%),
      linear-gradient(315deg, color-mix(in srgb, var(--clay-ube-300) 22%, transparent), transparent 48%);
    pointer-events: none;
  }

  .home-hero__panel > * {
    position: relative;
    z-index: 1;
  }

  .panel-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
  }

  .panel-brand__mark {
    width: 3.4rem;
    height: 3.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    border: 1px solid var(--clay-border);
    border-radius: 18px;
    background: var(--clay-lemon-400);
    box-shadow: 0 10px 20px rgba(18, 27, 48, 0.08);
  }

  .panel-brand strong {
    display: block;
    margin-top: 0.16rem;
    color: var(--sl-color-text);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.15;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .metric {
    min-height: 7.1rem;
    display: grid;
    align-content: end;
    gap: 0.35rem;
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--clay-border) 72%, white 28%);
    border-radius: 18px;
    background: color-mix(in srgb, var(--clay-paper) 74%, transparent);
  }

  .metric--wide {
    grid-column: 1 / -1;
    min-height: 6rem;
  }

  .metric strong {
    color: var(--sl-color-text);
    font-size: clamp(1.55rem, 4vw, 2.7rem);
    line-height: 0.95;
  }

  .metric--wide strong {
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
  }

  .topic-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
  }

  .topic-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.36rem;
  }

  .topic-chip > span:last-child {
    min-width: 1.65rem;
    height: 1.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--clay-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--clay-paper) 86%, transparent);
    color: var(--clay-charcoal);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .home-board {
    display: grid;
    gap: clamp(1.2rem, 3vw, 2rem);
  }

  .section-heading {
    margin-bottom: 0.75rem;
  }

  .section-heading--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-heading h2 {
    margin: 0.18rem 0 0;
    color: var(--sl-color-text);
    font-size: clamp(1.35rem, 2.7vw, 2.1rem);
    line-height: 1;
  }

  .featured-card {
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) minmax(0, 1fr);
    min-height: 25rem;
    border-radius: 28px;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--clay-paper) 96%, white 4%) 0%, color-mix(in srgb, var(--clay-paper) 86%, var(--clay-cream) 14%) 100%);
  }

  .featured-card::after,
  .post-card::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 0.36rem;
    background: linear-gradient(90deg, var(--clay-blueberry-800), var(--clay-slushie-500), var(--clay-pomegranate-400));
  }

  .featured-card__chrome {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    padding: 1.35rem;
    border-right: 1px solid color-mix(in srgb, var(--clay-border) 66%, white 34%);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--clay-blueberry-800) 12%, transparent), transparent),
      color-mix(in srgb, var(--clay-paper) 66%, transparent);
  }

  .featured-card__chrome span {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--clay-border);
    border-radius: 999px;
    background: var(--clay-lemon-400);
    box-shadow: 0 8px 18px rgba(18, 27, 48, 0.08);
  }

  .featured-card__chrome span:nth-child(2) {
    margin-left: 2rem;
    background: var(--clay-slushie-500);
  }

  .featured-card__chrome span:nth-child(3) {
    margin-left: 0.7rem;
    background: var(--clay-pomegranate-400);
  }

  .featured-card__content {
    display: grid;
    align-content: center;
    gap: 0.85rem;
    padding: clamp(1.2rem, 3vw, 2.1rem);
  }

  .featured-card h3 {
    max-width: 18ch;
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(2rem, 4.8vw, 5.25rem);
    line-height: 0.95;
    text-wrap: balance;
  }

  .featured-card p:last-of-type,
  .post-card p {
    margin: 0;
    color: var(--clay-charcoal);
    line-height: 1.58;
  }

  .featured-card p:last-of-type {
    max-width: 62rem;
    font-size: clamp(0.98rem, 1.3vw, 1.12rem);
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
  }

  .categories--compact :global(.category-badge) {
    padding: 0.3rem 0.62rem;
    font-size: 0.72rem;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .post-card {
    min-height: 20rem;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 20px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(140deg, color-mix(in srgb, var(--card-tone, var(--clay-lemon-400)) 18%, transparent), transparent 44%);
    opacity: 0.9;
    pointer-events: none;
  }

  .post-card > * {
    position: relative;
    z-index: 1;
  }

  .post-card--tone-0 {
    --card-tone: var(--clay-lemon-400);
  }

  .post-card--tone-1 {
    --card-tone: var(--clay-slushie-500);
  }

  .post-card--tone-2 {
    --card-tone: var(--clay-ube-300);
  }

  .post-card--tone-3 {
    --card-tone: var(--clay-matcha-300);
  }

  .post-card:hover {
    border-color: color-mix(in srgb, var(--card-tone) 54%, var(--clay-border));
    box-shadow: var(--clay-shadow-hard);
    transform: translateY(-0.18rem);
  }

  .post-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .post-card__index {
    color: color-mix(in srgb, var(--card-tone) 70%, var(--sl-color-text) 30%);
    font-family: var(--font-space-mono, var(--font-fira-code));
    font-size: 0.78rem;
    font-weight: 700;
  }

  .post-card h3 {
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(1.1rem, 1.9vw, 1.48rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  .post-card p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    font-size: 0.94rem;
  }

  .post-card__link {
    align-self: end;
    margin-top: auto;
    min-height: 2.18rem;
    padding: 0.48rem 0.72rem;
    font-size: 0.8rem;
  }

  :root[data-theme='dark'] .home-hero__copy,
  :root[data-theme='dark'] .home-hero__panel,
  :root[data-theme='dark'] .featured-card,
  :root[data-theme='dark'] .post-card {
    border-color: color-mix(in srgb, var(--clay-border) 78%, black 22%);
    box-shadow:
      0 18px 44px rgba(0, 0, 0, 0.26),
      0 1px 0 rgba(255, 255, 255, 0.04) inset;
  }

  :root[data-theme='dark'] .home-hero__copy {
    background:
      linear-gradient(120deg, rgba(248, 204, 101, 0.14), transparent 34%),
      linear-gradient(145deg, color-mix(in srgb, var(--clay-paper) 92%, black 8%) 0%, color-mix(in srgb, var(--clay-cream) 88%, var(--clay-slushie-800) 12%) 100%);
  }

  :root[data-theme='dark'] .featured-card {
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--clay-paper) 94%, black 6%) 0%, color-mix(in srgb, var(--clay-paper) 86%, var(--clay-cream) 14%) 100%);
  }

  @media (max-width: 980px) {
    .home-hero,
    .featured-card {
      grid-template-columns: 1fr;
    }

    .home-hero__copy {
      min-height: 25rem;
    }

    .featured-card__chrome {
      min-height: 5.2rem;
      display: flex;
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--clay-border) 66%, white 34%);
    }

    .featured-card__chrome span:nth-child(2),
    .featured-card__chrome span:nth-child(3) {
      margin-left: 0;
    }

    .recent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .home-hero__copy,
    .home-hero__panel,
    .featured-card,
    .post-card {
      border-radius: 18px;
    }

    .home-hero__copy {
      min-height: 25rem;
      padding: 1.15rem;
    }

    .home-hero h1 {
      max-width: 11ch;
      font-size: 3.05rem;
    }

    .metric-grid,
    .recent-grid {
      grid-template-columns: 1fr;
    }

    .section-heading--split {
      align-items: start;
      flex-direction: column;
    }

    .featured-card__content,
    .post-card {
      padding: 1rem;
    }
  }
</style>
