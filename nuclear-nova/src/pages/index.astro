---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import { getAllPosts, getPostPath } from '../utils/post-utils';
import { getPostExcerpt } from '../utils/excerpt';

const posts = await getAllPosts();
const featured = posts[0];
const recentPosts = posts.slice(1, 7);
const totalPosts = posts.length;
const categoryCounts = new Map<string, number>();

for (const post of posts) {
  for (const category of post.data.categories ?? []) {
    categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
  }
}

const topCategories = Array.from(categoryCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout title="Bin Zhang's Blog" description="Bin Zhang's personal blog and knowledge base.">
  <section class="home-hero" aria-label="Homepage introduction">
    <div class="home-hero__copy">
      <div class="home-hero__intro">
        <p class="eyebrow">Bin Zhang's Field Notes</p>
        <h1>Modern notes for data, AI, and engineering systems.</h1>
        <p class="lede">
          Practical essays, implementation notes, and mental models for LLMs, infrastructure,
          data platforms, and the craft of building durable software.
        </p>
        <div class="hero-actions">
          <a class="action-button action-button--primary" href="/posts/">Browse posts</a>
          <a class="action-button action-button--secondary" href="/archive/">View archive</a>
        </div>
      </div>

      <aside class="home-hero__panel" aria-label="Blog summary">
        <p class="panel-label">Notebook summary</p>

        <div class="metric-grid" aria-label="Publication metrics">
          <div class="metric">
            <span>Posts</span>
            <strong>{totalPosts}</strong>
          </div>
          <div class="metric">
            <span>Topics</span>
            <strong>{categoryCounts.size}</strong>
          </div>
          <div class="metric metric--wide">
            <span>Latest</span>
            <strong>{featured ? formatDate(featured.data.date) : 'Coming soon'}</strong>
          </div>
        </div>

        {topCategories.length > 0 && (
          <div class="topic-cloud" aria-label="Top categories">
            {topCategories.map(([category, count]) => (
              <span class="topic-chip">
                <CategoryBadge category={category} />
                <span>{count}</span>
              </span>
            ))}
          </div>
        )}
      </aside>
    </div>
  </section>

  <main class="home-board" aria-label="Homepage posts">
    {featured && (
      <section class="featured-section" aria-labelledby="featured-heading">
        <div class="section-heading">
          <p class="eyebrow">Latest dispatch</p>
          <h2 id="featured-heading">Featured article</h2>
        </div>

        <article class="featured-card">
          <div class="featured-card__chrome" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <div class="featured-card__content">
            <p class="meta">{formatDate(featured.data.date)}</p>
            <h3>{featured.data.title}</h3>
            {featured.data.categories && featured.data.categories.length > 0 && (
              <div class="categories">
                {featured.data.categories.map((category) => (
                  <CategoryBadge category={category} link={false} />
                ))}
              </div>
            )}
            <p>{getPostExcerpt(featured, 260)}</p>
            <a class="action-button action-button--primary" href={getPostPath(featured)}>
              Read article
            </a>
          </div>
        </article>
      </section>
    )}

    <section class="recent-section" aria-labelledby="recent-heading">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Fresh from the notebook</p>
          <h2 id="recent-heading">Recent writing</h2>
        </div>
        <a class="section-link" href="/posts/">All posts</a>
      </div>

      <div class="recent-grid">
        {recentPosts.map((post, index) => (
          <article class={`post-card post-card--tone-${index % 4}`}>
            <div class="post-card__top">
              <p class="meta">{formatDate(post.data.date)}</p>
              <span class="post-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            </div>

            <h3>{post.data.title}</h3>
            {post.data.categories && post.data.categories.length > 0 && (
              <div class="categories categories--compact">
                {post.data.categories.slice(0, 2).map((category) => (
                  <CategoryBadge category={category} link={false} />
                ))}
              </div>
            )}
            <p>{getPostExcerpt(post, 140)}</p>
            <a class="post-card__link" href={getPostPath(post)}>Read note</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @layer overrides {
    :global(html:root[data-theme='light']) {
      --sl-color-bg: #f3eee7 !important;
      --sl-color-bg-nav: rgba(243, 238, 231, 0.92) !important;
      background: #f3eee7 !important;
    }

    :global(html:root[data-theme='light'] body) {
      background: #f3eee7 !important;
    }

    :global(html:root[data-theme='light'] .page),
    :global(html:root[data-theme='light'] .sl-markdown-content) {
      background: #f3eee7 !important;
    }

    :global(html:root[data-theme='light']) .home-board,
    :global(html:root[data-theme='light']) .featured-section,
    :global(html:root[data-theme='light']) .recent-section {
      background: #f3eee7 !important;
    }

    :global(html:root[data-theme='dark']) {
      --sl-color-bg: #15120f !important;
      --sl-color-bg-nav: rgba(21, 18, 15, 0.94) !important;
      background: #15120f !important;
    }

    :global(html:root[data-theme='dark'] body) {
      background:
        radial-gradient(circle at 8% 0%, rgba(248, 204, 101, 0.06), transparent 26%),
        radial-gradient(circle at 92% 8%, rgba(59, 211, 253, 0.07), transparent 30%),
        linear-gradient(180deg, #15120f 0%, #111415 100%) !important;
    }

    :global(html:root[data-theme='dark'] .page),
    :global(html:root[data-theme='dark'] .sl-markdown-content),
    :global(html:root[data-theme='dark']) .home-board,
    :global(html:root[data-theme='dark']) .featured-section,
    :global(html:root[data-theme='dark']) .recent-section {
      background: #15120f !important;
    }
  }

  .home-hero {
    margin-bottom: clamp(1.3rem, 3vw, 2.3rem);
  }

  .home-hero__copy,
  .featured-card,
  .post-card {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--clay-border) 88%, #bfae93 12%);
    background: color-mix(in srgb, var(--clay-paper) 86%, var(--clay-cream) 14%);
    box-shadow:
      0 22px 48px rgba(58, 44, 24, 0.11),
      0 8px 18px rgba(1, 65, 141, 0.045),
      0 1px 0 rgba(255, 255, 255, 0.8) inset;
  }

  .home-hero__copy {
    min-height: clamp(18rem, 27vw, 23rem);
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
    align-items: stretch;
    gap: clamp(1.1rem, 3vw, 2.2rem);
    padding: clamp(1.1rem, 3vw, 2rem);
    border-radius: 28px;
    background:
      radial-gradient(circle at 12% 12%, rgba(248, 204, 101, 0.18), transparent 32%),
      linear-gradient(300deg, rgba(193, 176, 255, 0.1), transparent 42%),
      linear-gradient(145deg, #f3eadc 0%, #dfece9 100%);
  }

  .home-hero__copy::before {
    content: '';
    position: absolute;
    inset: auto 1.1rem 1.1rem auto;
    width: min(28rem, 42%);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--clay-border) 82%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--clay-blueberry-800) 13%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--clay-slushie-800) 11%, transparent) 1px, transparent 1px);
    background-size: 18px 18px;
    opacity: 0.34;
    transform: rotate(-4deg);
    pointer-events: none;
  }

  .home-hero__copy > * {
    position: relative;
    z-index: 1;
  }

  .home-hero__intro {
    display: grid;
    gap: 1rem;
    align-content: center;
    min-width: 0;
    padding-block: clamp(0.35rem, 1vw, 1rem);
  }

  .eyebrow,
  .meta,
  .metric span,
  .panel-label {
    margin: 0;
    color: var(--clay-muted);
    font-family: var(--font-space-mono, var(--font-fira-code));
    font-size: 0.72rem;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 17ch;
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(2.4rem, 4.5vw, 4.55rem);
    line-height: 0.96;
    text-wrap: balance;
  }

  .lede {
    max-width: 42rem;
    margin: 0;
    color: var(--clay-charcoal);
    font-size: clamp(0.98rem, 1.25vw, 1.1rem);
    line-height: 1.58;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.25rem;
  }

  .action-button,
  .section-link,
  .post-card__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.45rem;
    padding: 0.58rem 0.9rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .action-button--primary {
    border: 1px solid color-mix(in srgb, var(--clay-blueberry-800) 84%, black 16%);
    background: var(--clay-blueberry-800) !important;
    background-color: var(--clay-blueberry-800) !important;
    color: #ffffff !important;
    box-shadow:
      0 14px 28px rgba(1, 65, 141, 0.2),
      0 1px 0 rgba(255, 255, 255, 0.22) inset;
  }

  .action-button--secondary,
  .section-link,
  .post-card__link {
    border: 1px solid color-mix(in srgb, var(--clay-border) 86%, #bfae93 14%);
    background: rgba(247, 241, 230, 0.86) !important;
    background-color: rgba(247, 241, 230, 0.86) !important;
    color: var(--sl-color-text) !important;
  }

  .action-button:hover,
  .section-link:hover,
  .post-card__link:hover {
    color: #ffffff !important;
    background: var(--clay-pomegranate-400) !important;
    background-color: var(--clay-pomegranate-400) !important;
    border-color: var(--clay-pomegranate-400);
    box-shadow: var(--clay-shadow-hard);
    transform: translateY(-2px);
  }

  .home-hero__panel {
    position: relative;
    display: grid;
    align-content: space-between;
    box-sizing: border-box;
    gap: 1rem;
    min-height: auto;
    height: 100%;
    padding: clamp(0.35rem, 1.4vw, 1rem) 0 clamp(0.35rem, 1.4vw, 1rem) clamp(1rem, 2.2vw, 1.6rem);
    border-left: 1px solid color-mix(in srgb, var(--clay-border) 82%, var(--clay-slushie-800) 18%);
  }

  .home-hero__panel::before {
    content: none;
  }

  .home-hero__panel > * {
    position: relative;
    z-index: 1;
  }

  .panel-label {
    align-self: start;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    align-content: stretch;
    border-block: 1px solid color-mix(in srgb, var(--clay-border) 82%, var(--clay-slushie-800) 18%);
  }

  .metric {
    min-height: 5.2rem;
    display: grid;
    align-content: end;
    gap: 0.35rem;
    padding: 0.9rem 0;
  }

  .metric--wide {
    grid-column: 1 / -1;
    min-height: 4.6rem;
    border-top: 1px solid color-mix(in srgb, var(--clay-border) 82%, var(--clay-slushie-800) 18%);
  }

  .metric:nth-child(2) {
    padding-left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--clay-border) 82%, var(--clay-slushie-800) 18%);
  }

  .metric strong {
    color: var(--sl-color-text);
    font-size: clamp(1.55rem, 4vw, 2.7rem);
    line-height: 0.95;
  }

  .metric--wide strong {
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
  }

  .topic-cloud {
    display: flex;
    flex-wrap: wrap;
    align-content: end;
    gap: 0.48rem;
    min-height: auto;
  }

  .topic-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.36rem;
  }

  .topic-chip > span:last-child {
    min-width: 1.65rem;
    height: 1.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--clay-border);
    border-radius: 999px;
    background: rgba(247, 241, 230, 0.74);
    color: var(--clay-charcoal);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .home-board {
    display: grid;
    gap: clamp(1.2rem, 3vw, 2rem);
  }

  .section-heading {
    margin-bottom: 0.75rem;
  }

  .section-heading--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-heading h2 {
    margin: 0.18rem 0 0;
    color: var(--sl-color-text);
    font-size: clamp(1.35rem, 2.7vw, 2.1rem);
    line-height: 1;
  }

  .featured-card {
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) minmax(0, 1fr);
    min-height: 25rem;
    border-radius: 28px;
    background:
      radial-gradient(circle at 16% 15%, rgba(248, 204, 101, 0.14), transparent 30%),
      linear-gradient(145deg, #f3eadc 0%, #dfece9 100%) !important;
  }

  .featured-card::after,
  .post-card::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 0.36rem;
    background: linear-gradient(90deg, var(--clay-blueberry-800), var(--clay-slushie-500), var(--clay-pomegranate-400));
  }

  .featured-card__chrome {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    padding: 1.35rem;
    border-right: 1px solid color-mix(in srgb, var(--clay-border) 82%, var(--clay-slushie-800) 18%);
    background:
      linear-gradient(180deg, rgba(1, 65, 141, 0.08), transparent),
      rgba(239, 230, 216, 0.72) !important;
  }

  .featured-card__chrome span {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--clay-border);
    border-radius: 999px;
    background: var(--clay-lemon-400);
    box-shadow: 0 8px 18px rgba(18, 27, 48, 0.08);
  }

  .featured-card__chrome span:nth-child(2) {
    margin-left: 2rem;
    background: var(--clay-slushie-500);
  }

  .featured-card__chrome span:nth-child(3) {
    margin-left: 0.7rem;
    background: var(--clay-pomegranate-400);
  }

  .featured-card__content {
    display: grid;
    align-content: center;
    gap: 0.85rem;
    padding: clamp(1.2rem, 3vw, 2.1rem);
  }

  .featured-card h3 {
    max-width: 18ch;
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(2rem, 4.8vw, 5.25rem);
    line-height: 0.95;
    text-wrap: balance;
  }

  .featured-card p:last-of-type,
  .post-card p {
    margin: 0;
    color: var(--clay-charcoal);
    line-height: 1.58;
  }

  .featured-card p:last-of-type {
    max-width: 62rem;
    font-size: clamp(0.98rem, 1.3vw, 1.12rem);
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
  }

  .categories--compact :global(.category-badge) {
    padding: 0.3rem 0.62rem;
    font-size: 0.72rem;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .post-card {
    min-height: 20rem;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 20px;
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.38), transparent 32%),
      #f3eadf !important;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(140deg, color-mix(in srgb, var(--card-tone, var(--clay-lemon-400)) 14%, transparent), transparent 44%);
    opacity: 0.74;
    pointer-events: none;
  }

  .post-card > * {
    position: relative;
    z-index: 1;
  }

  .post-card--tone-0 {
    --card-tone: var(--clay-lemon-400);
  }

  .post-card--tone-1 {
    --card-tone: var(--clay-slushie-500);
  }

  .post-card--tone-2 {
    --card-tone: var(--clay-ube-300);
  }

  .post-card--tone-3 {
    --card-tone: var(--clay-matcha-300);
  }

  .post-card:hover {
    border-color: color-mix(in srgb, var(--card-tone) 54%, var(--clay-border));
    box-shadow: var(--clay-shadow-hard);
    transform: translateY(-0.18rem);
  }

  .post-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .post-card__index {
    color: color-mix(in srgb, var(--card-tone) 70%, var(--sl-color-text) 30%);
    font-family: var(--font-space-mono, var(--font-fira-code));
    font-size: 0.78rem;
    font-weight: 700;
  }

  .post-card h3 {
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(1.1rem, 1.9vw, 1.48rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  .post-card p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    font-size: 0.94rem;
  }

  .post-card__link {
    align-self: end;
    margin-top: auto;
    min-height: 2.18rem;
    padding: 0.48rem 0.72rem;
    font-size: 0.8rem;
  }

  :root[data-theme='dark'] .home-hero__copy,
  :root[data-theme='dark'] .featured-card,
  :root[data-theme='dark'] .post-card {
    border-color: color-mix(in srgb, var(--clay-border) 72%, var(--clay-slushie-500) 28%);
    box-shadow:
      0 24px 52px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.035) inset,
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 0 30px color-mix(in srgb, var(--clay-slushie-500) 10%, transparent);
  }

  :root[data-theme='dark'] .home-hero__copy {
    background:
      linear-gradient(120deg, rgba(248, 204, 101, 0.12), transparent 34%),
      linear-gradient(300deg, color-mix(in srgb, var(--clay-ube-300) 9%, transparent), transparent 44%),
      linear-gradient(145deg, color-mix(in srgb, var(--clay-paper) 92%, #29313a 8%) 0%, color-mix(in srgb, var(--clay-cream) 82%, var(--clay-slushie-800) 18%) 100%);
  }

  :root[data-theme='dark'] .home-hero__copy::before {
    border-color: color-mix(in srgb, var(--clay-slushie-500) 22%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--clay-slushie-500) 16%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--clay-lemon-400) 9%, transparent) 1px, transparent 1px);
    opacity: 0.34;
  }

  :root[data-theme='dark'] .home-hero__panel {
    border-left-color: color-mix(in srgb, var(--clay-border) 58%, var(--clay-slushie-500) 42%);
  }

  :root[data-theme='dark'] .metric-grid,
  :root[data-theme='dark'] .metric--wide,
  :root[data-theme='dark'] .metric:nth-child(2) {
    border-color: color-mix(in srgb, var(--clay-border) 64%, var(--clay-slushie-500) 36%);
  }

  :root[data-theme='dark'] .featured-card {
    background:
      radial-gradient(circle at 18% 16%, rgba(248, 204, 101, 0.13), transparent 30%),
      linear-gradient(145deg, #211d1a 0%, #17252b 100%) !important;
  }

  :root[data-theme='dark'] .featured-card__chrome {
    border-right-color: color-mix(in srgb, var(--clay-border) 62%, var(--clay-slushie-500) 38%);
    background:
      linear-gradient(180deg, rgba(1, 65, 141, 0.26), transparent),
      rgba(27, 23, 20, 0.72) !important;
  }

  :root[data-theme='dark'] .post-card {
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.025), transparent 32%),
      #1c1816 !important;
  }

  :root[data-theme='dark'] .post-card::before {
    opacity: 0.42;
  }

  :root[data-theme='dark'] .topic-chip > span:last-child,
  :root[data-theme='dark'] .action-button--secondary,
  :root[data-theme='dark'] .section-link,
  :root[data-theme='dark'] .post-card__link {
    border-color: color-mix(in srgb, var(--clay-border) 70%, var(--clay-slushie-500) 30%);
    background: color-mix(in srgb, var(--clay-paper) 82%, #2b3440 18%) !important;
    background-color: color-mix(in srgb, var(--clay-paper) 82%, #2b3440 18%) !important;
  }

  :root[data-theme='dark'] .post-card:hover {
    border-color: color-mix(in srgb, var(--card-tone) 50%, var(--clay-border));
    box-shadow:
      0 22px 42px rgba(0, 0, 0, 0.5),
      0 0 0 1px color-mix(in srgb, var(--card-tone) 30%, transparent) inset,
      0 0 28px color-mix(in srgb, var(--card-tone) 12%, transparent);
  }

  @media (max-width: 980px) {
    .home-hero__copy,
    .featured-card {
      grid-template-columns: 1fr;
