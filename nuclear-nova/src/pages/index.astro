---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import { getAllPosts, getPostPath } from '../utils/post-utils';
import { getPostExcerpt } from '../utils/excerpt';

const posts = await getAllPosts();
const featured = posts[0];
const recentPosts = posts.slice(1, 7);
const totalPosts = posts.length;

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title="Bin Zhang's Blog" description="Bin Zhang's personal blog and knowledge base.">
  <section class="editorial-hero" aria-label="Homepage introduction">
    <div class="editorial-hero__copy">
      <p class="eyebrow">Bin Zhang's Blog</p>
      <h1>Data, AI, and engineering notes.</h1>
      <p class="lede">Notes on LLMs, data systems, infrastructure, and practical engineering work.</p>
    </div>
    <div class="editorial-hero__meta" aria-label="Blog summary">
      <span>{totalPosts} posts</span>
      {featured && <span>Latest: {formatDate(featured.data.date)}</span>}
    </div>
  </section>

  <main class="editorial-board" aria-label="Homepage posts">
    {featured && (
      <section class="latest-section" aria-labelledby="latest-heading">
        <div class="section-heading">
          <h2 id="latest-heading">Latest article</h2>
          <span>{formatDate(featured.data.date)}</span>
        </div>

        <article class="latest-card">
          <p class="meta">{formatDate(featured.data.date)}</p>
          <h3>{featured.data.title}</h3>
          {featured.data.categories && featured.data.categories.length > 0 && (
            <div class="categories">
              {featured.data.categories.map((category) => (
                <CategoryBadge category={category} link={false} />
              ))}
            </div>
          )}
          <p>{getPostExcerpt(featured, 220)}</p>
          <a class="read-button" href={getPostPath(featured)}>Read article</a>
        </article>
      </section>
    )}

    <aside class="recent-section" aria-labelledby="recent-heading">
      <div class="section-heading">
        <h2 id="recent-heading">Recent posts</h2>
        <span>{recentPosts.length} posts</span>
      </div>

      <div class="recent-list">
        {recentPosts.map((post) => (
          <article class="recent-item">
            <div class="recent-item__copy">
              <p class="meta">{formatDate(post.data.date)}</p>
              <h3>{post.data.title}</h3>
            </div>
            <a class="read-button read-button--small" href={getPostPath(post)}>Read</a>
          </article>
        ))}
      </div>
    </aside>
  </main>
</BaseLayout>

<style>
  .editorial-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: end;
    margin-bottom: 1rem;
    padding: clamp(1.2rem, 2.2vw, 1.9rem);
    border: 1px solid var(--clay-border);
    border-radius: 24px;
    background:
      linear-gradient(90deg, rgba(248, 204, 101, 0.16), transparent 36%),
      color-mix(in srgb, var(--clay-paper) 94%, transparent);
    box-shadow: var(--clay-shadow);
  }

  .editorial-hero__copy {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }

  .eyebrow,
  .meta,
  .section-heading span,
  .editorial-hero__meta {
    color: var(--clay-muted);
    font-family: var(--font-space-mono);
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.72rem;
  }

  .editorial-hero h1 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(3rem, 5.2vw, 5.8rem);
    line-height: 0.94;
    text-wrap: balance;
  }

  .lede {
    margin: 0;
    max-width: 45rem;
    color: var(--clay-charcoal);
    font-size: clamp(1rem, 1.18vw, 1.15rem);
    line-height: 1.58;
  }

  .editorial-hero__meta {
    display: grid;
    gap: 0.42rem;
    justify-items: end;
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .editorial-board {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(21rem, 0.88fr);
    gap: 1rem;
    align-items: start;
  }

  .latest-section,
  .recent-section {
    min-width: 0;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.65rem;
    padding-bottom: 0.42rem;
    border-bottom: 1px solid color-mix(in srgb, var(--clay-border) 62%, transparent);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .section-heading span,
  .meta {
    font-size: 0.7rem;
  }

  .latest-card,
  .recent-item {
    border: 1px solid var(--clay-border);
    background: color-mix(in srgb, var(--clay-paper) 91%, transparent);
    box-shadow: var(--clay-shadow);
  }

  .latest-card {
    display: grid;
    gap: 0.75rem;
    min-height: 25rem;
    align-content: start;
    padding: clamp(1.15rem, 2vw, 1.7rem);
    border-radius: 22px;
  }

  .meta {
    margin: 0;
  }

  .latest-card h3 {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(2.25rem, 4.5vw, 4.8rem);
    line-height: 0.98;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .latest-card p:last-of-type {
    margin: 0;
    max-width: 58rem;
    color: var(--clay-charcoal);
    font-size: 1rem;
    line-height: 1.58;
  }

  .recent-list {
    display: grid;
    gap: 0.58rem;
  }

  .recent-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
    padding: 0.8rem 0.9rem;
    border-radius: 16px;
  }

  .recent-item h3 {
    margin: 0.24rem 0 0;
    color: var(--sl-color-text);
    font-size: 1rem;
    line-height: 1.25;
  }

  .read-button {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.1rem;
    padding: 0.54rem 0.78rem;
    border: 1px solid var(--clay-border);
    border-radius: 999px;
    background: var(--clay-blueberry-800);
    color: #ffffff !important;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .read-button:hover {
    background: var(--clay-pomegranate-400);
    box-shadow: var(--clay-shadow-hard);
    transform: translateY(-0.08rem);
  }

  .read-button--small {
    margin-top: 0;
    padding: 0.36rem 0.62rem;
    background: color-mix(in srgb, var(--clay-paper) 78%, transparent);
    color: var(--sl-color-text) !important;
  }

  .read-button--small:hover {
    background: var(--clay-lemon-400);
  }

  @media (max-width: 860px) {
    .editorial-hero,
    .editorial-board {
      grid-template-columns: 1fr;
    }

    .editorial-hero__meta {
      justify-items: start;
    }

    .latest-card {
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .editorial-hero,
    .latest-card {
      border-radius: 18px;
    }

    .recent-item {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
