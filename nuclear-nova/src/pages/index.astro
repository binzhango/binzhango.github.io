---
import ReadingPaths from '../components/ReadingPaths.astro';
import HomeTopics from '../components/HomeTopics.astro';
import HomeCard from '../components/HomeCard.astro';
import { getTopicTone } from '../utils/presentation';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import { getAllPosts, getPostPath } from '../utils/post-utils';
import { getPostExcerpt } from '../utils/excerpt';
import { getCuratedCollections } from '../utils/collections';
const posts = await getAllPosts();
const featured = posts[0];
const recent = posts.slice(1, 7);
const collections = await getCuratedCollections();
const topics = new Set(posts.flatMap((post) => post.data.categories ?? []));
const newest = [...posts].sort((a, b) => Number(b.data.date ?? 0) - Number(a.data.date ?? 0))[0];
const formatDate = (date?: Date) => date?.toLocaleDateString('en-US', {year:'numeric', month:'short', day:'numeric', timeZone:'UTC'}) ?? '';
---
<BaseLayout title="Bin Zhang's Blog" description="Personal notes on AI, data, and engineering systems by Bin Zhang.">
  <section class="home-hero" aria-labelledby="home-title" data-parallax-hero>
    <div class="hero-copy">
      <p class="hero-byline">Bin Zhang <span aria-hidden="true">/</span> Engineering notes</p>
      <h1 id="home-title">AI systems &amp;<br />data engineering.</h1>
      <p class="hero-description">I write about the engineering behind language models, retrieval systems, and data infrastructure.</p>
      <p class="hero-detail">Technical deep dives and implementation walkthroughs, from the underlying concepts to working code.</p>
      <nav class="hero-actions" aria-label="Explore the writing">
        <a class="hero-link" href="/posts/">Browse articles <span aria-hidden="true">→</span></a>
        <a class="hero-link hero-link--secondary" href="/collections/">Reading collections <span aria-hidden="true">→</span></a>
      </nav>
    </div>
    <HomeCard />
    <HomeTopics posts={posts} />
  </section>
  {featured && <section data-topic-tone={getTopicTone(featured.data.categories?.[0])} class="featured-section" aria-labelledby="featured-title" data-featured-reveal>
    <div class="feature-label"><p class="eyebrow">Start here</p><span class="meta">{featured.data.pin ? 'Featured article' : 'Latest article'}</span></div>
    <div class="featured-copy"><div><div class="featured-meta"><time datetime={featured.data.date?.toISOString()}>{formatDate(featured.data.date)}</time>{featured.data.categories?.[0] && <CategoryBadge category={featured.data.categories[0]} />}</div><h2 id="featured-title"><a href={getPostPath(featured)}>{featured.data.title}</a></h2></div><div class="featured-summary"><p>{getPostExcerpt(featured, 240)}</p><a class="text-link" href={getPostPath(featured)}>Read the article <span aria-hidden="true">↗</span></a></div></div>
  </section>}
  {collections.length > 0 && <section class="home-collections" aria-labelledby="collections-title">
    <div class="section-heading"><div><p class="eyebrow">Connect the ideas</p><h2 id="collections-title">Follow a thread</h2></div><a class="text-link" href="/collections/">All collections ↗</a></div>
    <ReadingPaths collections={collections} />
  </section>}
  <section class="home-recent" aria-labelledby="recent-title"><div class="section-heading"><div><p class="eyebrow">Fresh from the notebook</p><h2 id="recent-title">Recent posts</h2></div><a class="text-link" href="/posts/">All posts ↗</a></div><div class="post-list">{recent.map((post) => <PostPreview post={post} headingLevel={3} />)}</div></section>
  <section class="notebook-footer" aria-label="About this notebook"><div><p class="eyebrow">An ongoing practice</p><p class="notebook-statement">Always learning.<br />Still building.</p><img class="milestone no-lightbox" src="/assets/images/2026/codex-profile-card.png" alt="Bin Zhang’s Codex profile: 1B lifetime tokens, 71.8M peak day, 5-day current streak, and 14-day longest streak." width="998" height="612" loading="lazy" decoding="async" /></div><dl><div><dt>Published notes</dt><dd>{posts.length}</dd></div><div><dt>Topics explored</dt><dd>{topics.size}</dd></div><div><dt>Latest entry</dt><dd class="latest-date">{formatDate(newest?.data.date)}</dd></div></dl></section>
</BaseLayout>
<script>
  import { setupHomepageMotion } from '../scripts/home-motion';
  setupHomepageMotion();
</script>
<style>
  .home-hero { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(220px, .9fr) minmax(0, 1fr); align-items: center; gap: clamp(1rem, 2vw, 2rem); padding-block: 1rem 3rem; view-timeline-name: --hero; view-timeline-axis: block; }
  .hero-copy { position: relative; z-index: 2; min-width: 0; }
  .hero-byline { display: flex; flex-wrap: wrap; align-items: baseline; gap: .65rem; margin: 0; font-size: .8125rem; font-weight: 500; color: var(--muted); }
  .hero-byline span { color: var(--line); }
  #home-title { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 3vw, 2.65rem); font-weight: 400; line-height: 1.14; letter-spacing: -.035em; margin-block: 1.25rem 1.5rem; }
  .hero-description { max-width: 44ch; margin: 0; font-size: 1.0625rem; line-height: 1.75; }
  .hero-detail { max-width: 48ch; margin: .9rem 0 0; color: var(--muted); font-size: .9375rem; line-height: 1.75; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem 1.75rem; margin-top: 1.75rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .hero-link { display: inline-flex; align-items: center; gap: .65rem; min-height: 44px; font-size: .875rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .hero-link--secondary { color: var(--body-text); font-weight: 400; }
  .hero-link span { font-size: 1.05rem; }
  .hero-link:is(:hover, :focus-visible) { color: var(--accent); text-decoration: underline; text-underline-offset: .3em; }
  .featured-section { position: relative; padding: 2rem 2rem 2.5rem; border: 1px solid var(--accent-line); border-radius: .6rem; background: color-mix(in srgb, var(--accent-soft) 65%, var(--surface)); }
  .featured-section::before { content: ''; position: absolute; top: -1px; left: 2rem; width: 64px; height: 3px; background: var(--accent); border-radius: 2px; }
  .featured-section a { transition: color 180ms ease; }
  .feature-label { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1.6rem; }
  .feature-label .eyebrow { color: var(--accent); }
  .featured-copy { display: grid; grid-template-columns: 1.35fr 1fr; gap: 4rem; }
  .featured-meta { display: flex; flex-wrap: wrap; gap: 1rem; color: var(--muted); font-family: var(--font-mono); font-size: .8125rem; }
  .featured-copy h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); margin-block: .8rem 0; line-height: 1.17; }
  .featured-copy h2 a { color: var(--ink); text-decoration: none; }
  .featured-copy h2 a:hover { color: var(--accent); }
  .featured-summary { align-self: end; }
  .featured-summary p { font-size: .95rem; margin-top: 0; }
  .home-collections, .home-recent { margin-top: 5rem; }
  .section-heading h2 { display: flex; align-items: center; gap: .65rem; font-weight: 600; font-size: clamp(1.75rem, 2.5vw, 2.25rem); letter-spacing: -.025em; line-height: 1.25; }
  .notebook-footer { margin-top: 5rem; padding: 2rem 0; display: flex; gap: 2rem; justify-content: space-between; border-top: 1px solid var(--line); }
  .notebook-statement { font-size: 2rem; line-height: 1.2; color: var(--ink); letter-spacing: -.04em; margin-block: 1rem; }
  .milestone { display: block; width: min(100%, 460px); height: auto; margin-top: 1.5rem; }
  .notebook-footer > div { min-width: 0; }
  dl { display: flex; flex-wrap: wrap; gap: 3rem; margin: 0; align-items: center; }
  dt { font-size: .8125rem; color: var(--muted); }
  dd { font-size: 2.4rem; margin: .5rem 0 0; letter-spacing: -.05em; }
  dl > div:nth-child(1) dd { color: var(--violet); }
  dl > div:nth-child(2) dd { color: var(--teal); }
  dl > div:nth-child(3) dd { color: var(--amber); }
  dd.latest-date { font-size: 1rem; letter-spacing: 0; }
  @keyframes featured-reveal { from { transform: translateY(12px); opacity: .8; } to { transform: none; opacity: 1; } }
  @supports (animation-timeline: view()) {
    @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
      .featured-section { animation: featured-reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 100%; }
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .home-hero { grid-template-columns: minmax(0, 1fr) minmax(220px, .8fr); gap: 1.5rem; }
    .home-hero :global(.home-topics) { grid-column: 1 / -1; }
    #home-title { font-size: 2.4rem; }
  }
  @media (max-width: 767px) {
    .home-hero { grid-template-columns: 1fr; padding-block: 1rem 2.5rem; min-height: 0; gap: 2rem; }
    #home-title { font-size: clamp(2rem, 7.5vw, 2.75rem); margin-block: 1rem 1.25rem; }
    .hero-description { font-size: 1rem; }
    .hero-detail { font-size: .875rem; }
    .hero-actions { gap: .25rem 1.5rem; margin-top: 1.5rem; padding-top: .75rem; }
      .featured-copy { grid-template-columns: 1fr; gap: 1.3rem; }
    .featured-copy h2 { font-size: 1.85rem; }
    .home-collections, .home-recent { margin-top: 3.5rem; }
    .featured-section { padding: 1.5rem 1.25rem; }
    .notebook-footer { flex-direction: column; margin-top: 3rem; padding: 1.25rem; }
    dl { gap: 1.5rem; }
  }
</style>
