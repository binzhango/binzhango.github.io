---
import { getTopicTone, getDisplayTitle } from '../../utils/presentation';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { getCollectionExcerpt, getCuratedCollections, type CuratedCollection } from '../../utils/collections';
import { getPostPath, slugifyId } from '../../utils/post-utils';

export async function getStaticPaths() {
  const collections = await getCuratedCollections();
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

interface Props {
  collection: CuratedCollection;
}

const { collection } = Astro.props as Props;

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

function getNoteId(postId: string): string {
  return `note-${slugifyId(postId).replaceAll('/', '-')}`;
}
---

<BaseLayout title={`${collection.title} | Collections`} description={collection.description}>
  <nav class="collection-breadcrumbs" aria-label="Breadcrumb">
    <a href="/collections/">Collections</a>
    <span aria-hidden="true">/</span>
    <span>{collection.title}</span>
  </nav>

  <header class="collection-hero" data-topic-tone={getTopicTone(collection.posts[0]?.data.categories?.[0])}>
    <div>
      <p class="collection-hero__eyebrow">Collection</p>
      <h1>{collection.title}</h1>
      <p class="collection-hero__description">{collection.description}</p>
    </div>
    <div class="collection-hero__count">
      <strong>{collection.posts.length}</strong>
      <span>notes in this path</span>
    </div>
  </header>

  <div class="collection-browser" data-collection-browser data-topic-tone={getTopicTone(collection.posts[0]?.data.categories?.[0])}>
    <aside class="collection-selector" aria-label="Collection notes">
      <div class="collection-selector__header">
        <label for="collection-search">Find a note</label>
        <span data-result-count role="status">{collection.posts.length} notes</span>
      </div>
      <input
        id="collection-search"
        class="collection-search"
        type="search"
        placeholder="Search titles, categories, or tags"
        autocomplete="off"
        data-collection-search
        hidden
      />

      <div class="collection-selector__scroll" data-collection-list tabindex="-1">
        <ol>
          {collection.posts.map((post, index) => {
            const noteId = getNoteId(post.id);
            const searchText = [
              post.data.title,
              ...(post.data.categories ?? []),
              ...(post.data.tags ?? []),
            ].join(' ').toLowerCase();

            return (
              <li data-collection-row data-search={searchText}>
                <a
                  href={`#${noteId}`}
                  class="collection-selector__item"
                  data-collection-item
                  data-target={noteId}
                  aria-controls={noteId}
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  <span class="collection-selector__index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="collection-selector__title">{getDisplayTitle(post.data.title).title}</span>
                  <span class="collection-selector__date">{formatDate(post.data.date)}</span>
                </a>
              </li>
            );
          })}
        </ol>
        <p class="collection-selector__empty" data-empty-state hidden>No matching notes found.</p>
      </div>
    </aside>

    <section class="collection-preview" aria-live="polite">
      {collection.posts.map((post, index) => {
        const noteId = getNoteId(post.id);
        return (
          <article class="note-preview" id={noteId} data-note-panel>
            <div class="note-preview__sequence">
              <span>Note {String(index + 1).padStart(2, '0')}</span>
              <span>{index + 1} of {collection.posts.length}</span>
            </div>
            <div class="note-preview__meta">
              <time datetime={post.data.date?.toISOString()}>{formatDate(post.data.date)}</time>
              {post.data.categories?.slice(0, 1).map((category) => <CategoryBadge category={category} link={false} />)}
            </div>
            <h2>{getDisplayTitle(post.data.title).title}</h2>
            <p class="note-preview__excerpt">{getCollectionExcerpt(post, 300)}</p>

            <div class="note-preview__actions">
              <a class="note-preview__read" href={getPostPath(post)}>
                Read
              </a>
              <div class="note-preview__pager" aria-label="Collection navigation">
                {index > 0 && (
                  <button type="button" data-preview-direction="previous" data-target={getNoteId(collection.posts[index - 1].id)}>
                    <span aria-hidden="true">&larr;</span>
                    <span>Previous</span>
                  </button>
                )}
                {index < collection.posts.length - 1 && (
                  <button type="button" data-preview-direction="next" data-target={getNoteId(collection.posts[index + 1].id)}>
                    <span>Next</span>
                    <span aria-hidden="true">&rarr;</span>
                  </button>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </section>
  </div>
</BaseLayout>

<script>
  function setupCollectionBrowser() {
    const browser = document.querySelector<HTMLElement>('[data-collection-browser]');
    if (!browser || browser.dataset.ready === 'true') return;
    browser.dataset.ready = 'true';

    const buttons = Array.from(browser.querySelectorAll<HTMLAnchorElement>('[data-collection-item]'));
    const panels = Array.from(browser.querySelectorAll<HTMLElement>('[data-note-panel]'));
    const rows = Array.from(browser.querySelectorAll<HTMLElement>('[data-collection-row]'));
    const search = browser.querySelector<HTMLInputElement>('[data-collection-search]');
    const count = browser.querySelector<HTMLElement>('[data-result-count]');
    const empty = browser.querySelector<HTMLElement>('[data-empty-state]');
    if (search) search.hidden = false;

    function selectNote(target: string, updateHash = true) {
      const selectedButton = buttons.find((button) => button.dataset.target === target);
      const selectedPanel = panels.find((panel) => panel.id === target);
      if (!selectedButton || !selectedPanel) return;

      buttons.forEach((button) => button.removeAttribute('aria-current'));
      panels.forEach((panel) => { panel.hidden = panel !== selectedPanel; });
      selectedButton.setAttribute('aria-current', 'true');
      const visibleButtons = buttons.filter((button) => !button.closest<HTMLElement>('[data-collection-row]')?.hidden);
      const selectedIndex = visibleButtons.indexOf(selectedButton);
      selectedPanel.querySelectorAll<HTMLButtonElement>('[data-preview-direction]').forEach((button) => {
        button.disabled = button.dataset.previewDirection === 'previous' ? selectedIndex <= 0 : selectedIndex >= visibleButtons.length - 1;
      });

      const list = selectedButton.closest<HTMLElement>('[data-collection-list]');
      if (list) {
        const itemBounds = selectedButton.getBoundingClientRect();
        const listBounds = list.getBoundingClientRect();
        if (itemBounds.top < listBounds.top) list.scrollTop -= listBounds.top - itemBounds.top;
        if (itemBounds.bottom > listBounds.bottom) list.scrollTop += itemBounds.bottom - listBounds.bottom;
      }

      if (updateHash) history.replaceState(null, '', `#${target}`);
    }

    buttons.forEach((button) => {
      button.addEventListener('click', (event) => { event.preventDefault(); selectNote(button.dataset.target ?? ''); });
      button.addEventListener('keydown', (event) => {
        const visibleButtons = buttons.filter((candidate) => !candidate.closest<HTMLElement>('[data-collection-row]')?.hidden);
        const currentIndex = visibleButtons.indexOf(button);
        let nextIndex = currentIndex;

        if (event.key === 'ArrowDown') nextIndex = Math.min(currentIndex + 1, visibleButtons.length - 1);
        if (event.key === 'ArrowUp') nextIndex = Math.max(currentIndex - 1, 0);
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = visibleButtons.length - 1;
        if (nextIndex === currentIndex || nextIndex < 0) return;

        event.preventDefault();
        visibleButtons[nextIndex].focus();
        selectNote(visibleButtons[nextIndex].dataset.target ?? '');
      });
    });

    browser.querySelectorAll<HTMLButtonElement>('[data-preview-direction]').forEach((button) => {
      button.addEventListener('click', () => {
        const visibleButtons = buttons.filter((item) => !item.closest<HTMLElement>('[data-collection-row]')?.hidden);
        const currentIndex = visibleButtons.findIndex((item) => item.getAttribute('aria-current') === 'true');
        const next = visibleButtons[currentIndex + (button.dataset.previewDirection === 'previous' ? -1 : 1)];
        if (!next) return;
        const target = next.dataset.target ?? '';
        selectNote(target);
        buttons.find((item) => item.dataset.target === target)?.focus();
      });
    });

    search?.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      let visibleCount = 0;
      rows.forEach((row) => {
        const matches = !query || (row.dataset.search ?? '').includes(query);
        row.hidden = !matches;
        if (matches) visibleCount += 1;
      });
      if (count) count.textContent = `${visibleCount} ${visibleCount === 1 ? 'note' : 'notes'}`;
      if (empty) empty.hidden = visibleCount !== 0;
      if (visibleCount === 0) {
        panels.forEach((panel) => { panel.hidden = true; });
        buttons.forEach((button) => button.removeAttribute('aria-current'));
        return;
      }

      const currentButton = buttons.find((button) => button.getAttribute('aria-current') === 'true');
      if (!currentButton || currentButton.closest<HTMLElement>('[data-collection-row]')?.hidden) {
        const firstMatch = buttons.find((button) => !button.closest<HTMLElement>('[data-collection-row]')?.hidden);
        if (firstMatch) selectNote(firstMatch.dataset.target ?? '');
      } else {
        selectNote(currentButton.dataset.target ?? '', false);
      }
    });

    const initialTarget = window.location.hash.slice(1);
    const target = buttons.some((button) => button.dataset.target === initialTarget) ? initialTarget : buttons[0]?.dataset.target;
    if (target) selectNote(target, false);
  }

  setupCollectionBrowser();
  document.addEventListener('astro:page-load', setupCollectionBrowser);
</script>


<style>
  .collection-breadcrumbs { display: flex; flex-wrap: wrap; gap: .65rem; color: var(--muted); font-size: .875rem; }
  .collection-hero { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-block: 2rem 3rem; }
  .collection-hero h1 { max-width: 22ch; font-size: clamp(2.4rem, 5vw, 4rem); }
  .collection-hero__eyebrow { font-family: var(--font-mono); color: var(--muted); font-size: .875rem; text-transform: uppercase; }
  .collection-hero__description { max-width: 65ch; }
  .collection-hero__count { display: grid; flex: none; }
  .collection-hero__count strong { font-size: 2.5rem; letter-spacing: -.05em; }
  .collection-hero__count span { color: var(--muted); font-size: .875rem; }
  .collection-browser { display: grid; grid-template-columns: minmax(260px, .8fr) minmax(0, 1.2fr); gap: 3rem; border-top: 1px solid var(--line); padding-top: 2rem; }
  .collection-selector { min-width: 0; }
  .collection-selector__header { display: flex; justify-content: space-between; font-size: .875rem; color: var(--muted); margin-bottom: .75rem; }
  .collection-search { width: 100%; padding: .8rem; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); font-size: .875rem; }
  .collection-selector__scroll { max-height: 550px; overflow: auto; margin-top: 1rem; scrollbar-width: thin; }
  ol { list-style: none; padding: 0; margin: 0; }
  .collection-selector__item { width: 100%; display: grid; grid-template-columns: 22px 1fr; gap: .4rem .7rem; border: 0; border-bottom: 1px solid var(--line); border-left: 2px solid transparent; padding: 1rem .8rem; background: transparent; color: var(--body-text); text-align: left; text-decoration: none; }
  .collection-selector__item:hover, .collection-selector__item[aria-current='true'] { background: var(--surface); border-left-color: var(--accent); color: var(--accent); }
  .collection-selector__index, .collection-selector__date { color: var(--muted); font-family: var(--font-mono); font-size: .8125rem; }
  .collection-selector__title { font-size: .875rem; line-height: 1.45; }
  .collection-selector__date { grid-column: 2; }
  .note-preview { padding: 1.5rem 0 2rem; border-bottom: 1px solid var(--line); }
  .note-preview__sequence { display: flex; justify-content: space-between; color: var(--muted); font-family: var(--font-mono); font-size: .8125rem; margin-bottom: 2.5rem; }
  .note-preview__meta { display: flex; flex-wrap: wrap; gap: 1rem; color: var(--muted); font-size: .875rem; }
  .note-preview h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.2; margin-block: 1rem; }
  .note-preview__excerpt { line-height: 1.8; font-size: 1rem; }
  .note-preview__actions { margin-top: 2rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .note-preview__read { color: var(--canvas); background: var(--ink); text-decoration: none; padding: .7rem 1.3rem; border-radius: 5px; font-size: .85rem; }
  .note-preview__pager { display: none; gap: .5rem; }
  [data-ready='true'] .note-preview__pager { display: flex; }
  .note-preview__pager button { background: transparent; border: 1px solid var(--line); border-radius: 5px; padding: .65rem .8rem; color: var(--ink); font-size: .875rem; }
  .note-preview__pager button:hover { background: var(--accent-soft); }
  .note-preview__pager button:disabled { opacity: .45; cursor: default; }
  .collection-selector__empty { font-size: .85rem; }
  @media (max-width: 767px) {
    .collection-hero { display: block; }
    .collection-hero__count { display: none; }
    .collection-browser { grid-template-columns: 1fr; gap: 1rem; }
    .collection-selector__scroll { max-height: 280px; }
    .note-preview__sequence { margin-bottom: 1.5rem; }
  }
</style>
