---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingPaths from '../../components/ReadingPaths.astro';
import { getCuratedCollections } from '../../utils/collections';

const collections = await getCuratedCollections();
const totalNotes = collections.reduce((total, collection) => total + collection.posts.length, 0);

---

<BaseLayout
  title="Collections | Bin Zhang's Blog"
  description="Curated reading paths through Bin Zhang's writing on AI, LLM systems, and data engineering."
>
  <header class="collections-hero">
    <div class="collections-hero__copy">
      <p class="eyebrow">Guided reading</p>
      <h1>Collections</h1>
      <p>
        Related notes arranged into deliberate paths. Pick a subject, begin with the first idea,
        and follow the sequence as the system comes together.
      </p>
    </div>
    <dl class="collections-hero__stats" aria-label="Collection summary">
      <div>
        <dt>Paths</dt>
        <dd>{collections.length}</dd>
      </div>
      <div>
        <dt>Notes</dt>
        <dd>{totalNotes}</dd>
      </div>
    </dl>
  </header>

  <ReadingPaths collections={collections} />
</BaseLayout>


<style>
  .collections-hero { display: flex; justify-content: space-between; align-items: end; gap: 3rem; padding-block: 1rem 3rem; }
  .collections-hero__copy { max-width: 720px; }
  .collections-hero__copy > p:last-child { max-width: 58ch; }
  .collections-hero__stats { display: flex; gap: 2rem; flex: none; }
  .collections-hero__stats dt { font-size: .875rem; color: var(--muted); }
  .collections-hero__stats dd { font-size: 2rem; margin: 0; }
  @media (max-width: 767px) { .collections-hero { display: block; } .collections-hero__stats { margin-top: 1.5rem; } }
</style>
