---
import { Pagination } from '@astryxdesign/core/Pagination';
import { getBlogPagePath } from '../utils/pagination';

interface Props { currentPage: number; totalPages: number; position: 'top' | 'bottom'; }
const { currentPage, totalPages, position } = Astro.props;
---
{totalPages > 1 && (
  <Pagination
    className="blog-pagination"
    label={`Blog pagination (${position})`}
    page={currentPage}
    totalPages={totalPages}
    variant={position === 'top' ? 'compact' : 'pages'}
    getPageHref={getBlogPagePath}
    onChange={() => {}}
  />
)}
<style is:global>
  .blog-pagination { padding-block: .75rem; }
  .blog-pagination [aria-current='page'] {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>
