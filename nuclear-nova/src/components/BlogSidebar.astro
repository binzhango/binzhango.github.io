---
import ThemeControl from './ThemeControl.astro';
import { getPostPath, getPostsByYear } from '../utils/post-utils';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const postsByYear = await getPostsByYear();
const yearGroups = Object.entries(postsByYear).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));
const currentYear = new Date().getFullYear().toString();

function shouldOpen(year: string, paths: string[]): boolean {
  return year === currentYear || paths.includes(currentPath);
}
---

<aside class="blog-sidebar" aria-label="Blog archive by year">
  <div class="blog-sidebar__inner">
    <div class="blog-sidebar__content">
      <a class="blog-sidebar__home" href="/posts/" aria-current={currentPath === '/posts/' ? 'page' : undefined}>Blog</a>
      <nav class="blog-year-groups" aria-label="Posts by year">
        {yearGroups.map(([year, yearlyPosts]) => {
          const paths = yearlyPosts.map((post) => getPostPath(post));
          return (
            <details open={shouldOpen(year, paths)}>
              <summary>
                <span class="blog-year-label">{year}</span>
                <span class="blog-year-count" aria-label={`${yearlyPosts.length} posts in ${year}`}>
                  {yearlyPosts.length}
                </span>
              </summary>
              <ul>
                {yearlyPosts.map((post) => {
                  const href = getPostPath(post);
                  const isActive = href === currentPath;

                  return (
                    <li>
                      <a href={href} aria-current={isActive ? 'page' : undefined} class:list={{ active: isActive }}>
                        {post.data.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </details>
          );
        })}
      </nav>
    </div>
    <div class="blog-sidebar__footer">
      <ThemeControl />
      <button
        type="button"
        class="blog-sidebar-toggle"
        data-blog-sidebar-toggle
        aria-label="Collapse blog sidebar"
        aria-pressed="false"
      >
        <svg class="blog-sidebar-toggle__icon" viewBox="0 0 20 20" aria-hidden="true">
          <rect x="2.25" y="3" width="15.5" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
          <path d="M7.25 4.5v11" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
          <path d="M11.75 7.25 9.25 10l2.5 2.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
        </svg>
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  function syncBlogSidebarToggle() {
    const toggle = document.querySelector('.blog-sidebar [data-blog-sidebar-toggle]');
    if (!(toggle instanceof HTMLButtonElement)) return;
    const isMobile = window.matchMedia('(max-width: 720px)').matches;
    const viewport = isMobile ? 'mobile' : 'desktop';

    if (toggle.dataset.initialized !== 'true' || toggle.dataset.viewport !== viewport) {
      document.body.classList.toggle('blog-sidebar-collapsed', isMobile);
      toggle.dataset.initialized = 'true';
      toggle.dataset.viewport = viewport;
    }

    const collapsed = document.body.classList.contains('blog-sidebar-collapsed');
    toggle.hidden = false;
    toggle.setAttribute('aria-pressed', String(!collapsed));
    toggle.setAttribute('aria-label', collapsed ? 'Open blog sidebar' : 'Collapse blog sidebar');
    toggle.dataset.collapsed = String(collapsed);
  }

  function setupBlogSidebarToggle() {
    const toggle = document.querySelector('.blog-sidebar [data-blog-sidebar-toggle]');
    if (!(toggle instanceof HTMLButtonElement)) return;

    if (toggle.dataset.bound !== 'true') {
      toggle.dataset.bound = 'true';
      toggle.addEventListener('click', () => {
        const nextCollapsed = !document.body.classList.contains('blog-sidebar-collapsed');
        document.body.classList.toggle('blog-sidebar-collapsed', nextCollapsed);
        syncBlogSidebarToggle();
      });
    }

    syncBlogSidebarToggle();
  }

  setupBlogSidebarToggle();

  if (!window.__blogSidebarFooterToggleBound) {
    document.addEventListener('astro:after-swap', setupBlogSidebarToggle);
    window.addEventListener('resize', setupBlogSidebarToggle, { passive: true });
    window.__blogSidebarFooterToggleBound = true;
  }
</script>
