---
import { getPostPath, getPostsByYear } from '../utils/post-utils';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const postsByYear = await getPostsByYear();
const yearGroups = Object.entries(postsByYear).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));
const currentYear = new Date().getFullYear().toString();

function shouldOpen(year: string, paths: string[]): boolean {
  return year === currentYear || paths.includes(currentPath);
}
---

<aside class="blog-sidebar" aria-label="Blog posts by year">
  <div class="blog-sidebar__inner">
    <div class="blog-sidebar__header">
      <p class="blog-sidebar__eyebrow">Posts</p>

      <button
        type="button"
        class="blog-sidebar-toggle"
        data-blog-sidebar-toggle
        aria-label="Collapse blog sidebar"
        aria-pressed="false"
      >
        <span class="blog-sidebar-toggle__icon-wrap" aria-hidden="true">
          <svg class="blog-sidebar-toggle__icon" viewBox="0 0 20 20">
            <path
              d="M12.25 5.75 8 10l4.25 4.25"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            ></path>
          </svg>
        </span>
        <span class="blog-sidebar-toggle__label" aria-hidden="true">Posts</span>
      </button>
    </div>

    <div class="blog-sidebar__content">
      <nav class="blog-year-groups" aria-label="Posts by year">
        {yearGroups.map(([year, yearlyPosts]) => {
          const paths = yearlyPosts.map((post) => getPostPath(post));
          const currentYearGroup = paths.includes(currentPath);

          return (
            <details open={shouldOpen(year, paths)}>
              <summary
                aria-current={currentYearGroup ? 'true' : undefined}
                data-year={year}
                title={`${year} (${yearlyPosts.length} posts)`}
              >
                <span class="blog-year-summary">
                  <span class="blog-year-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <rect x="4.5" y="5.5" width="15" height="15" rx="3.25" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
                      <path d="M8 3.75v3.4M16 3.75v3.4M5 10h14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path>
                    </svg>
                    <span>{year.slice(-2)}</span>
                  </span>
                  <span class="blog-year-meta">
                    <span class="blog-year-label">{year}</span>
                    <span class="blog-year-count" aria-label={`${yearlyPosts.length} posts in ${year}`}>
                      {yearlyPosts.length}
                    </span>
                  </span>
                </span>
                <span class="blog-year-chevron" aria-hidden="true">
                  <svg viewBox="0 0 20 20">
                    <path
                      d="M5.75 11.75 10 7.5l4.25 4.25"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                    ></path>
                  </svg>
                </span>
              </summary>
              <ul>
                {yearlyPosts.map((post) => {
                  const href = getPostPath(post);
                  const isActive = href === currentPath;

                  return (
                    <li>
                      <a href={href} aria-current={isActive ? 'page' : undefined} class:list={{ active: isActive }}>
                        {post.data.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </details>
          );
        })}
      </nav>
    </div>
  </div>
</aside>
