---
import { getCollection } from 'astro:content';
import CodeBlockCopy from './CodeBlockCopy.astro';
import Lightbox from './Lightbox.astro';
import ThemeManager from './ThemeManager.astro';

const route = Astro.locals.starlightRoute;
const { id, entry, head: headEntries } = route;
const docsEntries = await getCollection('docs');
const docsIds = new Set(docsEntries.map((doc) => doc.id));

const fallbackDescription =
  'A blog about Python, Kubernetes, Spark, Machine Learning, and more';
const fallbackOgImagePath = '/assets/images/2025/ollama.png';

function toIsoDate(value: unknown): string | undefined {
  if (value instanceof Date) {
    return Number.isNaN(value.getTime()) ? undefined : value.toISOString();
  }

  if (typeof value === 'string' || typeof value === 'number') {
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString();
  }

  return undefined;
}

function isManagedMetaTag(tag: {
  tag: string;
  attrs?: Record<string, string | boolean | undefined>;
}): boolean {
  const attrs = tag.attrs ?? {};

  if (tag.tag === 'link' && attrs.rel === 'canonical') {
    return true;
  }

  if (tag.tag !== 'meta') {
    return false;
  }

  const metaName = String(attrs.name ?? '');
  const metaProperty = String(attrs.property ?? '');

  return (
    metaName === 'description' ||
    metaName.startsWith('twitter:') ||
    metaProperty.startsWith('og:') ||
    metaProperty.startsWith('article:')
  );
}

const filteredHead = headEntries.filter((tag) => !isManagedMetaTag(tag));

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const isOgGeneratable = typeof id === 'string' && docsIds.has(id);
const ogImagePath = isOgGeneratable ? `/og/${id}.png` : fallbackOgImagePath;
const ogImageUrl = new URL(ogImagePath, Astro.site ?? Astro.url);

const title = entry?.data.title ?? 'B~~~~~Z';
const description = entry?.data.description ?? entry?.data.excerpt ?? fallbackDescription;
const author =
  entry?.data.author ??
  (Array.isArray(entry?.data.authors) ? entry?.data.authors[0] : entry?.data.authors) ??
  'Bin Zhang';
const isPost = typeof id === 'string' && id.startsWith('posts/');
const ogType = isPost ? 'article' : 'website';
const publishDate = toIsoDate(entry?.data.date);
const dateModified = toIsoDate(entry?.data.lastUpdated) ?? publishDate;
const categories = Array.isArray(entry?.data.categories) ? entry.data.categories : [];
const tags = Array.isArray(entry?.data.tags) ? entry.data.tags : [];
---

{filteredHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<ThemeManager defaultTheme="light" />

<meta name="description" content={description} />
<link rel="canonical" href={pageUrl.toString()} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl.toString()} />
<meta property="og:image" content={ogImageUrl.toString()} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="B~~~~~Z" />
<meta property="og:locale" content="en_US" />

{isPost && publishDate && (
  <>
    <meta property="article:published_time" content={publishDate} />
    <meta property="article:author" content={author} />
    {categories.map((category: string) => (
      <meta property="article:section" content={category} />
    ))}
    {tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl.toString()} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:site" content="@binzhangtw" />
<meta name="twitter:creator" content="@binzhangtw" />

<CodeBlockCopy />
<Lightbox />

<style is:inline>
  :root[data-theme='light'],
  :root[data-theme='light'] body,
  :root[data-theme='light'] html {
    --sl-color-bg: #f9fafb !important;
    --sl-color-white: #f9fafb !important;
    background-color: #f9fafb !important;
  }

  :root[data-theme='light'] .page,
  :root[data-theme='light'] main.main {
    background-color: #f9fafb !important;
  }

  :root[data-theme='light'] .content-panel,
  :root[data-theme='light'] article,
  :root[data-theme='light'] .sl-container {
    background-color: #ffffff !important;
  }

  :root[data-theme='dark'],
  :root[data-theme='dark'] body,
  :root[data-theme='dark'] html {
    --sl-color-bg: #0a0a0a !important;
    --sl-color-white: #0a0a0a !important;
    background-color: #0a0a0a !important;
  }

  :root[data-theme='dark'] .page,
  :root[data-theme='dark'] main.main {
    background-color: #0a0a0a !important;
  }
</style>

{isPost && publishDate && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      author: {
        '@type': 'Person',
        name: author,
      },
      datePublished: publishDate,
      dateModified,
      image: ogImageUrl.toString(),
      url: pageUrl.toString(),
      publisher: {
        '@type': 'Organization',
        name: 'B~~~~~Z',
        logo: {
          '@type': 'ImageObject',
          url: new URL('/assets/favicon.ico', Astro.site ?? Astro.url).toString(),
        },
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl.toString(),
      },
      keywords: tags.join(', '),
      articleSection: categories.join(', '),
    })}
  />
)}
