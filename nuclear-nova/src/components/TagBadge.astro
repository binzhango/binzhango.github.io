---
import { slugifyTag } from '../utils/taxonomy';

interface Props {
    tag: string;
    link?: boolean;
}

const { tag, link = true } = Astro.props;
const tagUrl = `/tags/${slugifyTag(tag)}/`;
---

{link ? (
    <a href={tagUrl} class="tag-badge">{tag}</a>
) : (
    <span class="tag-badge">{tag}</span>
)}

<style>
    .tag-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.38rem 0.78rem;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 999px;
        background: color-mix(in srgb, var(--clay-slushie-500) 18%, var(--clay-paper) 82%);
        border: 1px solid color-mix(in srgb, var(--clay-slushie-800) 30%, var(--clay-border));
        color: var(--clay-blueberry-800) !important;
        text-decoration: none;
        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease,
            background 0.22s ease,
            border-color 0.22s ease,
            color 0.22s ease;
        white-space: nowrap;
    }

    .tag-badge::before {
        content: '#';
        margin-right: 0.18rem;
        font-family: var(--font-space-mono);
        font-weight: 700;
    }

    a.tag-badge:hover {
        background:
            linear-gradient(135deg, rgba(248, 204, 101, 0.22), rgba(59, 211, 253, 0.18)),
            color-mix(in srgb, var(--clay-paper) 76%, transparent);
        border-color: color-mix(in srgb, var(--clay-slushie-800) 42%, var(--clay-border));
        transform: translateY(-0.1rem);
        box-shadow:
            0 10px 20px rgba(58, 44, 24, 0.1),
            0 0 0 1px rgba(255, 255, 255, 0.5) inset;
        color: var(--sl-color-text) !important;
    }

    a.tag-badge:focus-visible {
        outline: none;
        box-shadow:
            0 0 0 3px color-mix(in srgb, var(--clay-slushie-500) 24%, transparent),
            0 10px 20px rgba(58, 44, 24, 0.1);
    }

    a.tag-badge:active {
        transform: translateY(0);
    }

    :root[data-theme='dark'] .tag-badge {
        background: color-mix(in srgb, var(--clay-slushie-800) 28%, var(--clay-paper) 72%);
        color: color-mix(in srgb, var(--clay-slushie-500) 35%, var(--clay-ink)) !important;
    }

    :root[data-theme='dark'] a.tag-badge:hover {
        background:
            linear-gradient(135deg, rgba(59, 211, 253, 0.15), rgba(248, 204, 101, 0.07)),
            rgba(24, 33, 35, 0.86);
        border-color: color-mix(in srgb, var(--clay-border) 52%, var(--clay-slushie-500) 48%);
        box-shadow:
            0 14px 26px rgba(0, 0, 0, 0.34),
            0 0 0 1px rgba(255, 255, 255, 0.045) inset,
            0 0 20px color-mix(in srgb, var(--clay-slushie-500) 10%, transparent);
        color: var(--clay-ink) !important;
    }
</style>
