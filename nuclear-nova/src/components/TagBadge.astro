---
import { Badge } from '@astryxdesign/core/Badge';
import { slugifyTag } from '../utils/taxonomy';

interface Props {
    tag: string;
    link?: boolean;
}

const { tag, link = true } = Astro.props;
const tagUrl = `/tags/${slugifyTag(tag)}/`;
---

{link ? (
  <a href={tagUrl} class="taxonomy-badge tag-badge"><Badge label={tag} variant="yellow" /></a>
) : <Badge className="tag-badge" label={tag} variant="yellow" />}
