---
import 'glightbox/dist/css/glightbox.min.css';
---

<script>
  import GLightbox from 'glightbox';

  type LightboxWindow = Window & {
    __glightbox?: { destroy?: () => void };
    __glightboxBound?: boolean;
  };

  function initializeLightbox() {
    const contentImages = document.querySelectorAll<HTMLImageElement>(
      '.sl-markdown-content img:not(.no-lightbox)'
    );

    contentImages.forEach((img) => {
      if (img.closest('a.glightbox-wrapper')) return;

      const link = document.createElement('a');
      link.href = img.src;
      link.classList.add('glightbox', 'glightbox-wrapper');
      link.setAttribute('data-gallery', 'content-gallery');

      if (img.alt) {
        link.setAttribute('data-description', img.alt);
      }

      const parent = img.parentNode;
      if (!parent) return;

      parent.insertBefore(link, img);
      link.appendChild(img);
    });

    const state = window as LightboxWindow;
    state.__glightbox?.destroy?.();
    state.__glightbox = GLightbox({
      touchNavigation: true,
      loop: true,
      autoplayVideos: true,
      closeButton: true,
      zoomable: true,
      draggable: true,
      dragToleranceX: 40,
      dragToleranceY: 65,
      preload: true,
    }) as unknown as { destroy?: () => void };
  }

  initializeLightbox();

  const state = window as LightboxWindow;
  if (!state.__glightboxBound) {
    document.addEventListener('astro:page-load', initializeLightbox);
    document.addEventListener('astro:before-swap', () => {
      state.__glightbox?.destroy?.();
    });
    state.__glightboxBound = true;
  }
</script>

<style is:global>
  /* Lightbox wrapper styling */
  .glightbox-wrapper {
    display: inline-block;
    cursor: zoom-in;
    transition: opacity 0.2s ease;
  }

  .glightbox-wrapper:hover {
    opacity: 0.9;
  }

  /* Ensure images within lightbox links maintain their styling */
  .glightbox-wrapper img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  /* Custom GLightbox theme adjustments for dark mode */
  :root[data-theme='dark'] .gslide-description {
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
  }

  :root[data-theme='dark'] .gslide-title {
    color: #fff;
  }

  /* Ensure lightbox works well with Starlight's content area */
  .sl-markdown-content .glightbox-wrapper {
    margin: 1rem 0;
  }
</style>
