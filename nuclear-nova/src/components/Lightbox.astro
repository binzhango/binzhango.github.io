<script>
  const imageSelector = '.sl-markdown-content img:not(.no-lightbox):not([id^="mermaid-"])';
  let closeGallery: (() => void) | undefined;
  let galleryLoading = false;

  function initializeLightbox() {
    document.querySelectorAll<HTMLImageElement>(imageSelector).forEach((img) => {
      if (img.closest('a, video, audio, object')) return;

      const link = document.createElement('a');
      link.href = img.currentSrc || img.src;
      link.className = 'article-image-link';
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-label', img.alt ? `Open image: ${img.alt}` : 'Open image');
      const media = img.closest('picture') ?? img;
      media.before(link);
      link.append(media);
    });
  }

  document.addEventListener('click', async (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
    if (!(event.target instanceof Element)) return;
    const trigger = event.target.closest<HTMLAnchorElement>('a.article-image-link');
    if (!trigger) return;
    event.preventDefault();
    if (galleryLoading || document.querySelector('[data-article-gallery]')) return;

    const images = Array.from(document.querySelectorAll<HTMLImageElement>('.article-image-link img'))
      .filter((img) => img.getClientRects().length);
    const index = images.findIndex((img) => trigger.contains(img));
    if (index < 0) return;

    galleryLoading = true;
    try {
      const { openGallery } = await import('./ArticleGallery.jsx');
      if (!trigger.isConnected) return;
      const host = document.createElement('div');
      host.dataset.articleGallery = '';
      document.body.append(host);
      closeGallery = openGallery(host, images.map((img) => ({
        src: img.currentSrc || img.src,
        alt: img.alt,
        caption: img.dataset.lightboxDescription === 'none' ? undefined : img.alt || undefined,
      })), index, trigger);
    } catch {
      if (trigger.isConnected) window.location.assign(trigger.href);
    } finally {
      galleryLoading = false;
    }
  });

  initializeLightbox();
  document.addEventListener('astro:page-load', initializeLightbox);
  document.addEventListener('astro:before-swap', () => {
    if (document.querySelector('[data-article-gallery]')) closeGallery?.();
    closeGallery = undefined;
  });
</script>

<style is:global>
  /* Lightbox wrapper styling */
  .article-image-link {
    display: block;
    width: fit-content;
    max-width: 100%;
    cursor: zoom-in;
    transition: opacity 0.2s ease;
  }

  .article-image-link:hover {
    opacity: 0.9;
  }

  /* Ensure images within lightbox links maintain their styling */
  .article-image-link img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
  }

  /* Ensure lightbox works well with Starlight's content area */
  .sl-markdown-content .article-image-link {
    margin: 1rem auto;
  }

  .sl-markdown-content img[id^='mermaid-'] {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
  }
</style>
