---
import { normalizeCategory, slugifyCategory } from '../utils/taxonomy';

interface Props {
    category: string;
    link?: boolean;
}

const { category, link = true } = Astro.props;
const normalizedCategory = normalizeCategory(category);
const categoryUrl = `/categories/${slugifyCategory(normalizedCategory)}/`;

const categoryColors: Record<string, string> = {
    python: '#3776ab',
    k8s: '#326ce5',
    spark: '#e25a1c',
    ML: '#ff6f00',
    airflow: '#017cee',
    LLM: '#10a37f',
    Azure: '#0078d4',
    Snowflake: '#29b5e8',
    Scala: '#dc322f',
    rust: '#ce422b',
};

const categoryColor = categoryColors[normalizedCategory] || '#6b7280';
---

{link ? (
    <a href={categoryUrl} class="category-badge" style={`--category-color: ${categoryColor}`}>
        {normalizedCategory}
    </a>
) : (
    <span class="category-badge" style={`--category-color: ${categoryColor}`}>
        {normalizedCategory}
    </span>
)}

<style>
    .category-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.38rem 0.78rem;
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 999px;
        background-color: color-mix(in srgb, var(--category-color) 16%, var(--clay-paper) 84%);
        color: color-mix(in srgb, var(--category-color) 82%, var(--clay-ink));
        border: 1px dashed color-mix(in srgb, var(--category-color) 48%, var(--clay-border)) !important;
        text-decoration: none;
        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease,
            background-color 0.22s ease,
            color 0.22s ease;
        white-space: nowrap;
    }

    a.category-badge:hover {
        background-color: var(--category-color);
        color: #ffffff !important;
        border-color: var(--category-color) !important;
        transform: rotate(-5deg) translateY(-0.12rem);
        box-shadow: var(--clay-shadow-hard);
    }

    a.category-badge:active {
        transform: translateY(0);
    }

    :root[data-theme='dark'] .category-badge {
        background-color: color-mix(in srgb, var(--category-color) 24%, var(--clay-paper) 76%);
        color: color-mix(in srgb, var(--category-color) 34%, var(--clay-ink));
    }

    :root[data-theme='dark'] a.category-badge:hover {
        background-color: var(--category-color);
        color: #ffffff !important;
        border-color: var(--category-color) !important;
    }
</style>
