---
import { normalizeCategory, slugifyCategory } from '../utils/taxonomy';

interface Props {
    category: string;
    link?: boolean;
}

const { category, link = true } = Astro.props;
const normalizedCategory = normalizeCategory(category);
const categoryUrl = `/categories/${slugifyCategory(normalizedCategory)}/`;

const categoryColors: Record<string, string> = {
    python: '#3776ab',
    k8s: '#326ce5',
    spark: '#e25a1c',
    ML: '#ff6f00',
    airflow: '#017cee',
    LLM: '#10a37f',
    Azure: '#0078d4',
    Snowflake: '#29b5e8',
    Scala: '#dc322f',
    rust: '#ce422b',
};

const categoryColor = categoryColors[normalizedCategory] || '#6b7280';
---

{link ? (
    <a href={categoryUrl} class="category-badge" style={`--category-color: ${categoryColor}`}>
        {normalizedCategory}
    </a>
) : (
    <span class="category-badge" style={`--category-color: ${categoryColor}`}>
        {normalizedCategory}
    </span>
)}

<style>
    .category-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.38rem 0.78rem;
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 999px;
        background-color: color-mix(in srgb, var(--category-color) 16%, var(--clay-paper) 84%);
        color: color-mix(in srgb, var(--category-color) 82%, var(--clay-ink));
        border: 1px dashed color-mix(in srgb, var(--category-color) 48%, var(--clay-border)) !important;
        text-decoration: none;
        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease,
            background-color 0.22s ease,
            border-color 0.22s ease,
            color 0.22s ease;
        white-space: nowrap;
    }

    a.category-badge:hover {
        background-color: color-mix(in srgb, var(--category-color) 22%, var(--clay-paper) 78%);
        color: color-mix(in srgb, var(--category-color) 78%, var(--sl-color-text)) !important;
        border-color: color-mix(in srgb, var(--category-color) 58%, var(--clay-border)) !important;
        transform: translateY(-0.1rem);
        box-shadow:
            0 10px 20px rgba(58, 44, 24, 0.1),
            0 0 0 1px rgba(255, 255, 255, 0.5) inset;
    }

    a.category-badge:focus-visible {
        outline: none;
        box-shadow:
            0 0 0 3px color-mix(in srgb, var(--category-color) 22%, transparent),
            0 10px 20px rgba(58, 44, 24, 0.1);
    }

    a.category-badge:active {
        transform: translateY(0);
    }

    :root[data-theme='dark'] .category-badge {
        background-color: color-mix(in srgb, var(--category-color) 24%, var(--clay-paper) 76%);
        color: color-mix(in srgb, var(--category-color) 34%, var(--clay-ink));
    }

    :root[data-theme='dark'] a.category-badge:hover {
        background-color: color-mix(in srgb, var(--category-color) 28%, var(--clay-paper) 72%);
        color: var(--clay-ink) !important;
        border-color: color-mix(in srgb, var(--category-color) 54%, var(--clay-border)) !important;
        box-shadow:
            0 14px 26px rgba(0, 0, 0, 0.34),
            0 0 0 1px rgba(255, 255, 255, 0.045) inset,
            0 0 20px color-mix(in srgb, var(--category-color) 10%, transparent);
    }
</style>
