---
interface Props {
  icon: string;
  title: string;
  variant?: 'default' | 'purple' | 'green';
}

const { icon, title, variant = 'default' } = Astro.props;
---

<div class={`feature-card feature-card--${variant}`}>
  <div class="feature-card__header">
    <span class="feature-card__icon">{icon}</span>
    <h3 class="feature-card__title">{title}</h3>
  </div>
  <div class="feature-card__content">
    <slot />
  </div>
</div>

<style>
  .feature-card {
    background: color-mix(in srgb, var(--clay-paper) 88%, transparent);
    border: 1px solid var(--clay-border);
    border-radius: 24px;
    padding: 1.5rem;
    margin: 1.5rem 0;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
    position: relative;
    overflow: hidden;
    box-shadow: var(--clay-shadow);
  }

  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, color-mix(in srgb, var(--clay-paper) 18%, transparent) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }

  .feature-card:hover {
    transform: translateY(-0.18rem);
    box-shadow: var(--clay-shadow-hard);
  }

  .feature-card:hover::before {
    opacity: 1;
  }

  .feature-card--purple {
    background: linear-gradient(
      180deg,
      rgba(193, 176, 255, 0.34) 0%,
      color-mix(in srgb, var(--clay-paper) 92%, transparent) 100%
    );
  }

  .feature-card--purple:hover {
    border-color: color-mix(in srgb, var(--clay-ube-800) 30%, var(--clay-border));
  }

  .feature-card--green {
    background: linear-gradient(
      180deg,
      rgba(132, 231, 165, 0.34) 0%,
      color-mix(in srgb, var(--clay-paper) 92%, transparent) 100%
    );
  }

  .feature-card--green:hover {
    border-color: color-mix(in srgb, var(--clay-matcha-600) 30%, var(--clay-border));
  }

  .feature-card__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .feature-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--clay-slushie-500);
    border: 1px solid var(--clay-border);
    border-radius: 18px;
    font-size: 1.25rem;
    box-shadow: var(--clay-shadow);
    transition: transform 0.22s ease, background-color 0.22s ease, box-shadow 0.22s ease;
  }

  .feature-card:hover .feature-card__icon {
    background: var(--clay-blueberry-800);
    transform: rotate(-7deg) translateY(-0.12rem);
    box-shadow: var(--clay-shadow-hard);
  }

  .feature-card--purple .feature-card__icon {
    background: var(--clay-ube-300);
  }

  .feature-card--purple:hover .feature-card__icon {
    background: var(--clay-ube-800);
  }

  .feature-card--green .feature-card__icon {
    background: var(--clay-matcha-300);
  }

  .feature-card--green:hover .feature-card__icon {
    background: var(--clay-matcha-600);
  }

  .feature-card__title {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--sl-color-text);
    letter-spacing: -0.04em;
  }

  .feature-card__content {
    color: var(--clay-charcoal);
  }

  .feature-card :global(pre) {
    background: color-mix(in srgb, var(--clay-paper) 72%, transparent) !important;
    border: 1px solid var(--clay-border);
    border-radius: 18px;
    padding: 1rem !important;
    margin: 1rem 0;
  }

  .feature-card :global(.code-block-wrapper) {
    margin: 1rem 0;
  }

  .feature-card :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0;
  }

  .feature-card :global(li) {
    padding: 0.75rem 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--clay-border) 86%, transparent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .feature-card :global(li:last-child) {
    border-bottom: none;
  }

  .feature-card :global(li:hover) {
    padding-left: 0.5rem;
    color: var(--sl-color-text);
  }

  .feature-card :global(li a) {
    color: var(--sl-color-text);
    text-decoration: none;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .feature-card :global(li a:hover) {
    color: var(--clay-blueberry-800);
  }

  .feature-card :global(li a::after) {
    content: '->';
    opacity: 0;
    transition: opacity 0.2s ease;
    margin-left: auto;
  }

  .feature-card :global(li:hover a::after) {
    opacity: 1;
  }

  :root[data-theme='dark'] .feature-card :global(li a:hover) {
    color: var(--clay-slushie-500);
  }
</style>
