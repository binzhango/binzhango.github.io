---
import { Icon } from '@astryxdesign/core/Icon';
import ArticleContentsTree from './ArticleContentsTree.jsx';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  mode?: 'desktop' | 'mobile';
}

const { headings, mode = 'desktop' } = Astro.props;
const isMobile = mode === 'mobile';
const Wrapper = isMobile ? 'details' : 'div';
---
<Wrapper class:list={['contents-panel', { 'contents-mobile': isMobile }]}>
  {isMobile
    ? <summary class="contents-heading">On this page <Icon icon="chevronDown" size="sm" color="inherit" /></summary>
    : <p class="contents-heading">On this page</p>}
  <nav aria-label="On this page" class="contents-scroll" data-article-contents>
    <ArticleContentsTree headings={headings} client:media={isMobile ? '(max-width: 1023px)' : '(min-width: 1024px)'} />
    <noscript>
      <style is:inline>[data-article-contents] astro-island { display: none !important; }</style>
      <ul class="contents-fallback">
        {headings.map(({ slug, text }) => <li><a href={`#${encodeURIComponent(slug)}`}>{text}</a></li>)}
      </ul>
    </noscript>
  </nav>
</Wrapper>

<script>
  const outlines = Array.from(document.querySelectorAll<HTMLElement>('[data-article-contents]'));
  if (outlines.length) {
    const headings = Array.from(outlines[0].querySelectorAll<HTMLAnchorElement>('a[href^="#"]'), (link) =>
      document.getElementById(decodeURIComponent(link.hash.slice(1)))
    ).filter((heading): heading is HTMLElement => heading !== null);
    const controller = new AbortController();
    let frame = 0;

    function updateLocation() {
      frame = 0;
      const scrollPadding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      let current: HTMLElement | undefined;
      for (const heading of headings) {
        const scrollMargin = parseFloat(getComputedStyle(heading).scrollMarginTop) || 0;
        if (heading.getBoundingClientRect().top > scrollPadding + scrollMargin + 2) break;
        current = heading;
      }
      for (const outline of outlines) {
        if (outline.querySelector('astro-island[ssr]')) continue;
        const next = current && outline.querySelector<HTMLAnchorElement>(
          `a[href="#${CSS.escape(encodeURIComponent(current.id))}"]`
        );
        const previous = outline.querySelector('a[aria-current="location"]');
        if (next === previous) continue;
        previous?.removeAttribute('aria-current');
        next?.setAttribute('aria-current', 'location');
      }
    }

    function scheduleUpdate() {
      if (!frame) frame = requestAnimationFrame(updateLocation);
    }

    const branches = new MutationObserver(scheduleUpdate);
    outlines.forEach((outline) => branches.observe(outline, {
      childList: true, subtree: true, attributes: true, attributeFilter: ['ssr'],
    }));
    for (const event of ['scroll', 'resize', 'hashchange']) {
      window.addEventListener(event, scheduleUpdate, { passive: true, signal: controller.signal });
    }
    scheduleUpdate();
    document.addEventListener('astro:before-swap', () => {
      controller.abort();
      branches.disconnect();
      cancelAnimationFrame(frame);
    }, { once: true });
  }
</script>

<style>
  .contents-panel {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-container);
    background: var(--surface);
  }
  .contents-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    margin: 0;
    padding: .7rem .85rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font: 600 .875rem/1.35 var(--font-sans);
  }
  .contents-scroll {
    max-height: min(36rem, calc(100dvh - 11rem));
    overflow: auto;
    padding: .4rem .3rem;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    overscroll-behavior: contain;
  }
  .contents-scroll :global(.astryx-tree-list-item) { padding-block: .4rem; }
  .contents-scroll :global(button[data-tree-toggle]) {
    appearance: none;
    padding: 0;
    border: 0;
    border-radius: var(--radius-inner);
    background: transparent;
    color: var(--muted);
  }
  .contents-scroll :global(button[data-tree-toggle]:hover) {
    background: var(--color-overlay-hover);
    color: var(--ink);
  }
  .contents-scroll :global(.astryx-tree-list-item a) {
    color: var(--muted);
    text-decoration: none;
    font-size: .8125rem;
    line-height: 1.45;
  }
  .contents-scroll :global(.astryx-tree-list-item a span) {
    font: inherit;
    color: inherit;
    letter-spacing: normal;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .contents-scroll :global([data-tree-level='1'] > div .astryx-tree-list-item a:not([aria-current='location'])) {
    color: var(--ink);
    font-weight: 550;
  }
  .contents-scroll :global(.astryx-tree-list-item:has(a[aria-current='location'])) {
    background-color: var(--color-accent-muted);
  }
  .contents-scroll :global(.astryx-tree-list-item a[aria-current='location']) {
    color: var(--color-text-accent);
    font-weight: 600;
  }
  .contents-fallback { margin: 0; padding: .35rem .55rem; list-style: none; }
  .contents-fallback a { display: block; padding-block: .25rem; color: var(--ink); font-size: .8125rem; }
  .contents-mobile > summary { cursor: pointer; list-style: none; }
  .contents-mobile > summary::-webkit-details-marker { display: none; }
  .contents-mobile:not([open]) > summary { border-bottom-color: transparent; }
  .contents-mobile[open] > summary :global(.astryx-icon) { transform: rotate(180deg); }
  .contents-mobile .contents-scroll { max-height: 60dvh; }
</style>
