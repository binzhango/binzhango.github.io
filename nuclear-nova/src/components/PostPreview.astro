---
import type { Post } from '../utils/post-utils';
import { getPostPath } from '../utils/post-utils';
import { getPostExcerpt } from '../utils/excerpt';
import CategoryBadge from './CategoryBadge.astro';
import { getTopicTone, getDisplayTitle } from '../utils/presentation';
interface Props { post: Post; index?: number; headingLevel?: 2 | 3; }
const { post, index, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const tone = getTopicTone(post.data.categories?.[0]);
const display = getDisplayTitle(post.data.title);
const excerpt = getPostExcerpt(post, 180);
const date = post.data.date?.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<article class:list={["post-preview", { "post-preview--pinned": post.data.pin }]} data-topic-tone={tone}>
  <div class="preview-meta">
    <time datetime={post.data.date?.toISOString()}>{date}</time>
    {post.data.pin && <span class="pin-badge">Pinned article</span>}
    {index !== undefined && <span class="preview-step">Chapter {String(index + 1).padStart(2, '0')}</span>}
  </div>
  <div class="preview-copy">
    {post.data.categories?.[0] && <CategoryBadge category={post.data.categories[0]} />}
    <Heading class="preview-title"><a href={getPostPath(post)} aria-label={post.data.title}>{display.series && <span class="preview-series">{display.series}</span>}{display.title}</a></Heading>
    {excerpt && <p>{excerpt}</p>}
  </div>
</article>
<style>
  .post-preview { min-width: 0; display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 1.5rem; padding: 1.7rem 0; border-bottom: 1px solid var(--line); }
  .preview-meta { display: flex; flex-direction: column; align-items: start; gap: .65rem; padding-top: .25rem; font-size: .8125rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .pin-badge, .preview-step { font-size: .8125rem; color: var(--accent); font-weight: 600; text-transform: none; letter-spacing: 0; }
  .preview-copy { min-width: 0; overflow-wrap: anywhere; }
  .preview-copy :global(.category-badge) { color: var(--accent); font-size: .8125rem; }
  .preview-title { margin: .55rem 0 .6rem; font-size: clamp(1.3rem, 2vw, 1.7rem); line-height: 1.25; max-width: 42ch; letter-spacing: -.03em; }
  .preview-title a { color: var(--ink); text-decoration: none; transition: color 180ms ease; }
  .preview-title a:hover { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .16em; }
  .preview-series { display: block; font-size: .8125rem; font-weight: 400; color: var(--muted); letter-spacing: 0; line-height: 1.5; margin-bottom: .35rem; }
  p { max-width: 68ch; margin: 0; font-size: .9375rem; line-height: 1.65; }
  .post-preview--pinned { padding: 1.8rem; margin-block: .5rem 1rem; border: 1px solid var(--accent-line); border-radius: .6rem; background: color-mix(in srgb, var(--accent-soft) 65%, var(--surface)); }
  .post-preview--pinned .preview-title { font-size: clamp(1.5rem, 2.6vw, 2rem); max-width: 38ch; }
  .post-preview:focus-within .preview-title a { color: var(--accent); }
  @media (max-width: 767px) {
    .post-preview { grid-template-columns: minmax(0, 1fr); gap: .6rem; padding-block: 1.4rem; }
    .post-preview--pinned { padding: 1.25rem; }
    .preview-meta { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: .5rem 1rem; }
    .preview-title { font-size: 1.35rem; }
  }
</style>
