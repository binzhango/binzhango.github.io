---
interface Props {
    title: string;
    icon?: string;
}

const { title, icon } = Astro.props;
---

<div class="card-wrapper">
    <div class="card-container">
        {icon && (
            <div class="card-icon-wrapper">
                <span class="card-icon">{icon}</span>
            </div>
        )}
        <div class="card-text-section">
            <h3 class="card-title">{title}</h3>
            <div class="card-description">
                <slot />
            </div>
        </div>
    </div>
</div>

<style>
    .card-wrapper {
        background: transparent;
        padding: 0;
        margin: 0;
    }

    .card-container {
        background: color-mix(in srgb, var(--clay-paper) 88%, transparent);
        border: 1px solid var(--clay-border);
        border-radius: 24px;
        padding: 1.5rem;
        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease,
            background-color 0.22s ease,
            border-color 0.22s ease;
        position: relative;
        overflow: hidden;
        box-shadow: var(--clay-shadow);
    }

    .card-container::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(248, 204, 101, 0.16) 0%, transparent 40%);
        opacity: 0;
        transition: opacity 0.22s ease;
        pointer-events: none;
    }

    .card-container:hover {
        border-color: color-mix(in srgb, var(--clay-blueberry-800) 28%, var(--clay-border));
        transform: translateY(-0.18rem);
        box-shadow: var(--clay-shadow-hard);
    }

    .card-container:hover::before {
        opacity: 1;
    }

    .card-icon-wrapper {
        background: transparent;
        margin-bottom: 1rem;
        padding: 0;
    }

    .card-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        background: var(--clay-slushie-500);
        border: 1px solid var(--clay-border);
        border-radius: 18px;
        font-size: 1.5rem;
        box-shadow: var(--clay-shadow);
        transition: transform 0.22s ease, box-shadow 0.22s ease, background-color 0.22s ease;
    }

    .card-container:hover .card-icon {
        transform: rotate(-7deg) translateY(-0.15rem);
        background: var(--clay-pomegranate-400);
        box-shadow: var(--clay-shadow-hard);
    }

    .card-text-section {
        background: transparent;
        padding: 0;
        margin: 0;
    }

    .card-title {
        background: transparent;
        font-size: 1.35rem;
        font-weight: 600;
        margin: 0 0 0.75rem 0;
        padding: 0;
        color: var(--sl-color-text);
        line-height: 1.2;
        letter-spacing: -0.03em;
    }

    .card-description {
        background: transparent;
        color: var(--clay-charcoal);
        line-height: 1.7;
        margin: 0;
        padding: 0;
    }

    .card-description :global(*) {
        background: transparent !important;
        background-color: transparent !important;
    }

    .card-description :global(p),
    .card-description :global(span),
    .card-description :global(div),
    .card-description :global(a) {
        background: transparent !important;
        background-color: transparent !important;
    }

    :root[data-theme='dark'] .card-container:hover {
        border-color: color-mix(in srgb, var(--clay-slushie-500) 40%, var(--clay-border));
    }
</style>
