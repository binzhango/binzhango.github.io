---
interface Props {
  variant?: 'floating' | 'default' | 'header';
}

const { variant = 'default' } = Astro.props;
const isHeader = variant === 'header';
---

<div class="theme-control" data-theme-control data-variant={variant}>
  {isHeader ? (
    <button type="button" class="theme-switch" data-theme-switch aria-label="Switch to dark theme" aria-pressed="false">
      <span class="theme-switch__track" aria-hidden="true">
        <span class="theme-switch__icon theme-switch__icon--light">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4.25" fill="currentColor"></circle>
            <path
              d="M12 1.75v2.5M12 19.75v2.5M4.75 4.75l1.77 1.77M17.48 17.48l1.77 1.77M1.75 12h2.5M19.75 12h2.5M4.75 19.25l1.77-1.77M17.48 6.52l1.77-1.77"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.75"
            ></path>
          </svg>
        </span>
        <span class="theme-switch__icon theme-switch__icon--dark">
          <svg viewBox="0 0 24 24">
            <path d="M15.25 3.5a8.75 8.75 0 1 0 5.25 15.75A9.5 9.5 0 0 1 15.25 3.5Z" fill="currentColor"></path>
          </svg>
        </span>
        <span class="theme-switch__thumb"></span>
      </span>
    </button>
  ) : (
    <details class="theme-dropdown" data-theme-choice="light">
      <summary class="theme-trigger" aria-label="Open theme menu">
        <span class="theme-trigger__icon" aria-hidden="true">
          <svg class="theme-icon theme-icon--light" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4.25" fill="currentColor"></circle>
            <path
              d="M12 1.75v2.5M12 19.75v2.5M4.75 4.75l1.77 1.77M17.48 17.48l1.77 1.77M1.75 12h2.5M19.75 12h2.5M4.75 19.25l1.77-1.77M17.48 6.52l1.77-1.77"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.75"
            ></path>
          </svg>
          <svg class="theme-icon theme-icon--dark" viewBox="0 0 24 24">
            <path
              d="M15.25 3.5a8.75 8.75 0 1 0 5.25 15.75A9.5 9.5 0 0 1 15.25 3.5Z"
              fill="currentColor"
            ></path>
          </svg>
          <svg class="theme-icon theme-icon--system" viewBox="0 0 24 24">
            <rect x="4" y="5" width="16" height="11" rx="2.25" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
            <path d="M9 19h6M12 16.2V19" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
          </svg>
        </span>
        <span class="theme-trigger__label" data-theme-label>Light</span>
      </summary>
      <div class="theme-menu" role="menu" aria-label="Theme mode">
        <button type="button" class="theme-option" data-theme-choice="light" role="menuitemradio" aria-checked="true">
          <span>Light</span>
          <span class="theme-option__check" aria-hidden="true">+</span>
        </button>
        <button type="button" class="theme-option" data-theme-choice="dark" role="menuitemradio" aria-checked="false">
          <span>Dark</span>
          <span class="theme-option__check" aria-hidden="true">+</span>
        </button>
        <button type="button" class="theme-option" data-theme-choice="auto" role="menuitemradio" aria-checked="false">
          <span>System</span>
          <span class="theme-option__check" aria-hidden="true">+</span>
        </button>
      </div>
    </details>
  )}
</div>

<script is:inline>
  function syncThemeControl(control) {
    const themeApi = window.theme;
    const switchButton = control.querySelector('[data-theme-switch]');
    if (switchButton instanceof HTMLButtonElement && themeApi) {
      const currentTheme = themeApi.getTheme();
      const resolvedTheme = currentTheme === 'auto' ? themeApi.getSystemTheme() : currentTheme;
      const isDark = resolvedTheme === 'dark';
      switchButton.dataset.themeChoice = resolvedTheme;
      switchButton.setAttribute('aria-pressed', String(isDark));
      switchButton.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
      return;
    }

    const dropdown = control.querySelector('.theme-dropdown');
    const label = control.querySelector('[data-theme-label]');
    if (!(dropdown instanceof HTMLDetailsElement) || !(label instanceof HTMLElement) || !themeApi) return;

    const labels = { light: 'Light', dark: 'Dark', auto: 'System' };
    const options = Array.from(control.querySelectorAll('.theme-option'));
    const currentTheme = themeApi.getTheme();
    dropdown.dataset.themeChoice = currentTheme;
    label.textContent = labels[currentTheme] ?? 'Light';

    options.forEach((option) => {
      const isSelected = option.dataset.themeChoice === currentTheme;
      option.setAttribute('aria-checked', String(isSelected));
      option.dataset.selected = String(isSelected);
    });
  }

  function setupThemeControls() {
    const controls = Array.from(document.querySelectorAll('[data-theme-control]'));
    controls.forEach((control) => {
      if (!(control instanceof HTMLElement)) return;

      if (control.dataset.bound !== 'true') {
        control.dataset.bound = 'true';

        control.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const switchButton = target.closest('[data-theme-switch]');
          if (switchButton instanceof HTMLButtonElement) {
            const themeApi = window.theme;
            if (!themeApi) return;

            const currentTheme = themeApi.getTheme();
            const resolvedTheme = currentTheme === 'auto' ? themeApi.getSystemTheme() : currentTheme;
            themeApi.setTheme(resolvedTheme === 'dark' ? 'light' : 'dark');
            syncThemeControl(control);
            return;
          }

          const option = target.closest('.theme-option');
          if (!(option instanceof HTMLButtonElement)) return;

          const themeApi = window.theme;
          const dropdown = control.querySelector('.theme-dropdown');
          const nextTheme = option.dataset.themeChoice;
          if (!(dropdown instanceof HTMLDetailsElement) || !themeApi) return;

          if (nextTheme === 'light' || nextTheme === 'dark' || nextTheme === 'auto') {
            themeApi.setTheme(nextTheme);
            dropdown.open = false;
            syncThemeControl(control);
          }
        });
      }

      syncThemeControl(control);
    });
  }

  setupThemeControls();

  if (!window.__themeControlsBound) {
    document.addEventListener('theme-changed', () => {
      document.querySelectorAll('[data-theme-control]').forEach((control) => {
        if (control instanceof HTMLElement) syncThemeControl(control);
      });
    });

    document.addEventListener('click', (event) => {
      document.querySelectorAll('[data-theme-control] .theme-dropdown').forEach((dropdown) => {
        if (!(dropdown instanceof HTMLDetailsElement) || !dropdown.open) return;
        if (event.target instanceof Node && !dropdown.contains(event.target)) {
          dropdown.open = false;
        }
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      document.querySelectorAll('[data-theme-control] .theme-dropdown').forEach((dropdown) => {
        if (dropdown instanceof HTMLDetailsElement) dropdown.open = false;
      });
    });

    document.addEventListener('astro:after-swap', setupThemeControls);
    window.addEventListener('resize', setupThemeControls, { passive: true });
    window.__themeControlsBound = true;
  }
</script>

<style>
  .theme-control {
    color: var(--sl-color-text);
    --control-bg: color-mix(in srgb, var(--clay-paper) 88%, transparent);
    --control-bg-hover: var(--clay-lemon-400);
    --control-border: var(--clay-border);
    --control-menu-bg: color-mix(in srgb, var(--clay-paper) 94%, transparent);
  }

  .theme-control[data-variant='floating'] {
    position: fixed;
    left: 1rem;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 30;
  }

  .theme-control[data-variant='header'] {
    flex: none;
  }

  .theme-switch {
    width: 4.35rem;
    height: 2.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--sl-color-text);
    border: 1px solid var(--clay-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--clay-paper) 72%, transparent);
    cursor: pointer;
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }

  .theme-switch:hover {
    border-color: color-mix(in srgb, var(--clay-border) 55%, var(--sl-color-text) 45%);
    background: color-mix(in srgb, var(--clay-paper) 58%, var(--clay-lemon-400) 42%);
    transform: translateY(-1px);
  }

  .theme-switch:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(20, 110, 245, 0.18);
  }

  .theme-switch__track {
    position: relative;
    width: 3.75rem;
    height: 1.75rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    border-radius: 999px;
  }

  .theme-switch__icon {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    color: color-mix(in srgb, var(--sl-color-text) 72%, white 28%);
    transition: color 0.18s ease;
  }

  .theme-switch__icon svg {
    width: 0.86rem;
    height: 0.86rem;
    display: block;
  }

  .theme-switch__thumb {
    position: absolute;
    left: 0;
    top: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--clay-lemon-400);
    border: 1px solid color-mix(in srgb, var(--clay-border) 70%, white 30%);
    box-shadow:
      0 6px 14px rgba(18, 27, 48, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .theme-switch[data-theme-choice='light'] .theme-switch__icon--light,
  .theme-switch[data-theme-choice='dark'] .theme-switch__icon--dark {
    color: var(--sl-color-text);
  }

  .theme-switch[data-theme-choice='dark'] .theme-switch__thumb {
    transform: translateX(2rem);
    background: color-mix(in srgb, var(--clay-blueberry-800) 84%, #111827 16%);
  }

  .theme-dropdown {
    position: relative;
  }

  .theme-dropdown summary {
    list-style: none;
  }

  .theme-dropdown summary::marker {
    content: '';
  }

  .theme-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .theme-dropdown summary::before {
    content: none !important;
    display: none !important;
  }

  .theme-trigger {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--sl-color-text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    border: 1px solid var(--control-border);
    background: var(--control-bg);
    border-radius: 999px;
    padding: 0.44rem 0.76rem 0.44rem 0.48rem;
    cursor: pointer;
    box-shadow: var(--clay-shadow);
    transition:
      background-color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease,
      color 0.18s ease;
  }

  .theme-trigger:hover {
    color: var(--sl-color-text);
    background: var(--control-bg-hover);
    transform: rotate(-5deg) translateY(-0.12rem);
    box-shadow: var(--clay-shadow-hard);
  }

  .theme-trigger:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 3px rgba(20, 110, 245, 0.18),
      var(--clay-shadow-hard);
  }

  .theme-trigger:active {
    transform: translateY(0);
  }

  .theme-trigger__icon {
    width: 1.45rem;
    height: 1.45rem;
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--clay-paper) 90%, transparent);
    border: 1px solid var(--clay-border);
  }

  .theme-icon {
    width: 0.82rem;
    height: 0.82rem;
    display: none;
  }

  .theme-dropdown[data-theme-choice='light'] .theme-icon--light,
  .theme-dropdown[data-theme-choice='dark'] .theme-icon--dark,
  .theme-dropdown[data-theme-choice='auto'] .theme-icon--system {
    display: block;
  }

  .theme-menu {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.55rem);
    min-width: 8.9rem;
    display: none;
    padding: 0.42rem;
    background: var(--control-menu-bg);
    border: 1px solid var(--clay-border);
    border-radius: 24px;
    box-shadow: var(--clay-shadow);
    backdrop-filter: blur(18px) saturate(1.08);
  }

  .theme-control[data-variant='header'] .theme-trigger {
    width: 2.35rem;
    min-height: 2.35rem;
    justify-content: center;
    padding: 0;
    box-shadow: none;
  }

  .theme-control[data-variant='header'] .theme-trigger:hover {
    transform: translateY(-1px);
  }

  .theme-control[data-variant='header'] .theme-trigger__label {
    display: none;
  }

  .theme-control[data-variant='header'] .theme-trigger__icon {
    width: 1.45rem;
    height: 1.45rem;
    border: 0;
    background: transparent;
  }

  .theme-control[data-variant='header'] .theme-menu {
    left: auto;
    right: 0;
    top: calc(100% + 0.55rem);
    bottom: auto;
  }

  .theme-dropdown[open] .theme-menu {
    display: grid;
    gap: 0.16rem;
  }

  .theme-option {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.75rem;
    color: var(--sl-color-text);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    text-align: left;
    border: 0;
    background: transparent;
    border-radius: 18px;
    padding: 0.55rem 0.68rem;
    cursor: pointer;
    transition:
      color 0.18s ease,
      background-color 0.18s ease,
      transform 0.18s ease;
  }

  .theme-option:hover {
    color: var(--sl-color-text);
    background: rgba(248, 204, 101, 0.48);
    transform: translateY(-1px);
  }

  .theme-option[data-selected='true'] {
    background: rgba(59, 211, 253, 0.26);
  }

  .theme-option__check {
    opacity: 0;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .theme-option[data-selected='true'] .theme-option__check {
    opacity: 1;
  }

  :root[data-theme='dark'] .theme-control {
    color: var(--clay-ink);
    --control-bg: color-mix(in srgb, var(--clay-paper) 94%, transparent);
    --control-menu-bg: color-mix(in srgb, var(--clay-paper) 98%, transparent);
  }

  :root[data-theme='dark'] .theme-trigger,
  :root[data-theme='dark'] .theme-option {
    color: var(--clay-ink);
  }

  :root[data-theme='dark'] .theme-trigger__icon {
    background: rgba(247, 241, 234, 0.08);
  }

  :root[data-theme='dark'] .theme-option[data-selected='true'] {
    background: rgba(59, 211, 253, 0.22);
  }

  @media (max-width: 720px) {
    .theme-control[data-variant='floating'] {
      left: 0.75rem;
      bottom: max(0.75rem, env(safe-area-inset-bottom));
    }

    .theme-menu {
      min-width: 8.2rem;
    }
  }
</style>
