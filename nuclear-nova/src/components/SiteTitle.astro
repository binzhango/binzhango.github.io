---
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;

const primaryLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/posts/2025/03-29-llm-usage', label: 'Blog' },
	{ href: '/archive/', label: 'Archive' },
];
---

<div class="site-title-group">
	<a href={siteTitleHref} class="site-title sl-flex">
		{
			config.logo && logos.dark && (
				<>
					<img
						class:list={{ 'light:sl-hidden print:hidden': !('src' in config.logo) }}
						alt={config.logo.alt}
						src={logos.dark.src}
						width={logos.dark.width}
						height={logos.dark.height}
					/>
					{!('src' in config.logo) && (
						<img
							class="dark:sl-hidden print:block"
							alt={config.logo.alt}
							src={logos.light?.src}
							width={logos.light?.width}
							height={logos.light?.height}
						/>
					)}
				</>
			)
		}
		<span class:list={{ 'sr-only': config.logo?.replacesTitle }} translate="no">
			{siteTitle}
		</span>
	</a>

	<nav class="header-links" aria-label="Primary">
		{
			primaryLinks.map((item) => (
				<a href={item.href} class="header-link">
					{item.label}
				</a>
			))
		}
	</nav>
</div>

<style>
	@layer starlight.core {
		.site-title-group {
			display: flex;
			align-items: center;
			gap: var(--sl-nav-gap);
			min-width: 0;
		}

		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}

		.site-title span {
			overflow: hidden;
		}

		.site-title img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
		}

		.header-links {
			display: none;
			gap: 0.9rem;
			align-items: center;
			white-space: nowrap;
		}

		.header-link {
			text-decoration: none;
			color: var(--sl-color-text);
			font-size: var(--sl-text-sm);
		}

		.header-link:hover {
			color: var(--sl-color-text-accent);
		}

		@media (min-width: 64rem) {
			.header-links {
				display: flex;
			}
		}
	}
</style>
