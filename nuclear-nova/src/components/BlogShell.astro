---
import BlogSidebar from './BlogSidebar.astro';

interface Props {
  currentPath?: string;
  reserveSecondary?: boolean;
}

const { currentPath = '', reserveSecondary = false } = Astro.props;
const hasSecondary = Astro.slots.has('secondary');
const showSecondary = hasSecondary || reserveSecondary;
---

<div class:list={['blog-layout', { 'blog-layout--with-secondary': showSecondary }]}>
  <BlogSidebar currentPath={currentPath} />

  <section class="blog-main">
    <div class="blog-main__inner">
      <slot />
    </div>
  </section>

  {showSecondary && (
    <aside class="blog-secondary" aria-label="On this page">
      <div class="blog-secondary__inner">
        {hasSecondary && <slot name="secondary" />}
      </div>
    </aside>
  )}
</div>

<style>
  .blog-layout {
    --blog-sidebar-width: 15rem;
    --blog-sidebar-collapsed-width: 4.75rem;
    --blog-main-max-width: 68rem;
    --blog-secondary-width: 14rem;
    --blog-layout-gap: clamp(1rem, 1.6vw, 1.45rem);
    --blog-sidebar-hover: rgba(248, 204, 101, 0.2);
    --blog-sidebar-active: rgba(59, 211, 253, 0.2);
    --blog-sidebar-active-strong: rgba(1, 65, 141, 0.1);
    --blog-sidebar-flyout-bg:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--clay-paper) 96%, #ffffff 4%) 0%,
        color-mix(in srgb, var(--clay-paper) 89%, var(--clay-cream) 11%) 100%
      );
    display: grid;
    grid-template-columns: var(--blog-sidebar-width) minmax(0, 1fr);
    gap: var(--blog-layout-gap);
    width: 100%;
    position: relative;
    isolation: isolate;
    align-items: start;
  }

  .blog-layout.blog-layout--with-secondary {
    grid-template-columns:
      var(--blog-sidebar-width)
      minmax(0, 1fr)
      var(--blog-secondary-width);
  }

  :global(.blog-sidebar) {
    position: sticky;
    top: 5.45rem;
    align-self: start;
    width: var(--blog-sidebar-width);
    height: calc(100vh - 6rem);
    border-right: 1px solid color-mix(in srgb, var(--clay-border) 70%, white 30%);
    border-radius: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--clay-paper) 96%, white 4%) 0%,
        color-mix(in srgb, var(--clay-paper) 94%, var(--clay-cream) 6%) 100%
      );
    box-shadow: none;
    overflow: visible;
    z-index: 20;
    transition:
      width 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }

  :global(.blog-sidebar__inner) {
    height: 100%;
    box-sizing: border-box;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.85rem;
    padding: 0.9rem 0.75rem 1rem;
  }

  :global(.blog-sidebar__header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.25rem 0.15rem 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--clay-border) 55%, white 45%);
  }

  :global(.blog-sidebar__eyebrow) {
    margin: 0;
    color: color-mix(in srgb, var(--clay-muted) 88%, var(--sl-color-text) 12%);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.blog-sidebar__content) {
    min-height: 0;
    overflow: auto;
    padding-right: 0.12rem;
    scrollbar-width: thin;
  }

  .blog-main {
    min-width: 0;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 0;
  }

  .blog-main__inner {
    width: 100%;
    min-width: 0;
    max-width: var(--blog-main-max-width);
  }

  .blog-secondary {
    position: sticky;
    top: 5.1rem;
    align-self: start;
    width: var(--blog-secondary-width);
    justify-self: end;
    z-index: 0;
  }

  .blog-secondary__inner {
    width: 100%;
  }

  :global(.blog-year-groups summary),
  :global(.blog-year-groups a) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    box-sizing: border-box;
    color: var(--sl-color-text) !important;
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.45;
    padding: 0.64rem 0.7rem;
    border-radius: 0.55rem;
    position: relative;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  :global(.blog-year-groups summary:hover),
  :global(.blog-year-groups a:hover) {
    background: var(--blog-sidebar-hover);
  }

  :global(.blog-year-groups summary[aria-current='true']),
  :global(.blog-year-groups a.active),
  :global(.blog-year-groups a[aria-current='page']) {
    background: linear-gradient(
      135deg,
      var(--blog-sidebar-active) 0%,
      color-mix(in srgb, var(--blog-sidebar-active) 48%, #ffffff 52%) 100%
    );
  }

  :global(.blog-year-groups) {
    display: grid;
    gap: 0.42rem;
    margin-top: 0;
  }

  :global(.blog-year-groups details) {
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    overflow: visible;
    position: relative;
  }

  :global(.blog-year-groups summary) {
    cursor: pointer;
    justify-content: space-between;
    list-style: none;
    border: 1px solid transparent;
    background: transparent;
    box-shadow: none;
  }

  :global(.blog-year-groups details[open] > summary) {
    border-color: color-mix(in srgb, var(--clay-border) 52%, white 48%);
    box-shadow: inset 3px 0 0 rgba(1, 65, 141, 0.14);
  }

  :global(.blog-year-groups summary::-webkit-details-marker) {
    display: none;
  }

  :global(.blog-year-groups summary::marker) {
    content: '';
  }

  :global(.blog-year-groups summary::before) {
    content: none !important;
    display: none !important;
  }

  :global(.blog-year-summary) {
    min-width: 0;
    display: flex;
    align-items: center;
    flex: 1;
  }

  :global(.blog-year-meta) {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  :global(.blog-year-label) {
    min-width: 0;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  :global(.blog-year-count) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.7rem;
    padding: 0.12rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blog-sidebar-active-strong) 72%, white 28%);
    color: color-mix(in srgb, var(--clay-muted) 80%, var(--sl-color-text) 20%);
    font-size: 0.72rem;
    font-family: var(--font-space-mono);
  }

  :global(.blog-year-chevron) {
    width: 1.15rem;
    height: 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--sl-color-text) 66%, white 34%);
    flex: none;
    transition: transform 0.18s ease, color 0.18s ease;
  }

  :global(.blog-year-chevron svg) {
    width: 0.92rem;
    height: 0.92rem;
    display: block;
  }

  :global(.blog-year-groups details[open] .blog-year-chevron) {
    transform: rotate(180deg);
    color: color-mix(in srgb, var(--sl-color-text) 82%, white 18%);
  }

  :global(.blog-year-groups ul) {
    list-style: none;
    margin: 0;
    padding: 0.3rem 0 0 0.95rem;
    display: grid;
    gap: 0.12rem;
    position: relative;
  }

  :global(.blog-year-groups ul::before) {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0.08rem;
    bottom: 0.72rem;
    width: 1px;
    background: color-mix(in srgb, var(--clay-border) 54%, white 46%);
  }

  :global(.blog-year-groups li) {
    position: relative;
  }

  :global(.blog-year-groups a) {
    padding: 0.5rem 0.62rem;
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--sl-color-text) 74%, white 26%) !important;
  }

  :global(.blog-year-groups a::before) {
    content: '';
    position: absolute;
    left: -0.52rem;
    top: 50%;
    width: 0.36rem;
    height: 1px;
    background: color-mix(in srgb, var(--clay-border) 54%, white 46%);
  }

  :global(.blog-sidebar-toggle) {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    padding: 0;
    color: var(--sl-color-text);
    border: 1px solid color-mix(in srgb, var(--clay-border) 68%, white 32%);
    background: transparent;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: none;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  :global(.blog-sidebar-toggle:hover) {
    background: var(--blog-sidebar-hover);
  }

  :global(.blog-sidebar-toggle__icon-wrap) {
    width: 1.25rem;
    height: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: transparent;
    border: 0;
  }

  :global(.blog-sidebar-toggle__icon) {
    width: 0.86rem;
    height: 0.86rem;
    display: block;
  }

  :global(.blog-sidebar-toggle[data-collapsed='true'] .blog-sidebar-toggle__icon) {
    transform: scaleX(-1);
  }

  :global(body.blog-sidebar-collapsed) .blog-layout {
    grid-template-columns: var(--blog-sidebar-width) minmax(0, 1fr);
  }

  :global(body.blog-sidebar-collapsed) .blog-layout.blog-layout--with-secondary {
    grid-template-columns:
      var(--blog-sidebar-width)
      minmax(0, 1fr)
      var(--blog-secondary-width);
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar) {
    width: var(--blog-sidebar-collapsed-width);
    overflow: visible;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__inner) {
    padding: 0.9rem 0.6rem;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__header) {
    justify-content: center;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__header) {
    border-bottom: 0;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__eyebrow) {
    display: none;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__content) {
    overflow: visible;
    padding-right: 0;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups) {
    gap: 0.65rem;
    margin-top: 0;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups details) {
    border-color: transparent;
    background: transparent;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups details::after) {
    content: '';
    position: absolute;
    top: 0;
    left: 100%;
    width: 1rem;
    height: 100%;
    background: transparent;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups > details > summary) {
    justify-content: center;
    padding: 0.4rem 0.12rem;
    min-height: 2.9rem;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups > details > summary .blog-year-summary) {
    justify-content: center;
    width: 100%;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups > details > summary .blog-year-meta) {
    flex: none;
    min-width: 0;
    justify-content: center;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups > details > summary .blog-year-label) {
    font-size: 0.88rem;
    text-align: center;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups > details > summary .blog-year-count),
  :global(body.blog-sidebar-collapsed .blog-year-chevron) {
    display: none;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups ul) {
    display: grid !important;
    position: absolute;
    left: calc(100% + 0.65rem);
    top: 0;
    min-width: 14rem;
    max-height: min(28rem, calc(100vh - 8rem));
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: 0.8rem;
    border: 1px solid var(--clay-border);
    border-radius: 0.9rem;
    background: var(--blog-sidebar-flyout-bg);
    box-shadow:
      0 22px 34px rgba(18, 27, 48, 0.1),
      0 2px 10px rgba(18, 27, 48, 0.05);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-0.25rem) scale(0.985);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    z-index: 100;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups ul::before),
  :global(body.blog-sidebar-collapsed .blog-year-groups a::before) {
    display: none;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups li + li) {
    margin-top: 0.16rem;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups ul::-webkit-scrollbar) {
    width: 0.52rem;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups ul::-webkit-scrollbar-thumb) {
    background: color-mix(in srgb, var(--clay-border) 88%, rgba(18, 27, 48, 0.16) 12%);
    border-radius: 999px;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups ul::-webkit-scrollbar-track) {
    background: transparent;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups details:hover ul),
  :global(body.blog-sidebar-collapsed .blog-year-groups details:focus-within ul) {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0) scale(1);
  }

  @media (max-width: 980px) {
    .blog-layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 1.1rem;
    }

    .blog-secondary {
      display: none;
    }

    :global(body.blog-sidebar-collapsed) .blog-layout {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .blog-layout {
      display: block;
    }

    :global(.blog-sidebar) {
      position: fixed;
      top: 5rem;
      left: 0.75rem;
      width: min(17rem, calc(100vw - 1.5rem));
      max-height: calc(100dvh - 5.75rem);
      z-index: 45;
      transform: translateX(0);
    }

    :global(body.blog-sidebar-collapsed .blog-sidebar) {
      transform: translateX(calc(-1 * min(17rem, calc(100vw - 1.5rem)) - 1rem));
    }

    :global(body.blog-sidebar-collapsed .blog-year-groups ul) {
      display: none;
    }
  }

  :global(:root[data-theme='dark'] .blog-layout) {
    --blog-sidebar-hover: rgba(248, 204, 101, 0.14);
    --blog-sidebar-active: rgba(59, 211, 253, 0.22);
    --blog-sidebar-active-strong: rgba(247, 241, 234, 0.08);
    --blog-sidebar-flyout-bg:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--clay-paper) 95%, transparent) 0%,
        color-mix(in srgb, var(--clay-paper) 90%, var(--clay-cream) 10%) 100%
      );
  }

  :global(:root[data-theme='dark'] .blog-sidebar) {
    background: color-mix(in srgb, var(--clay-paper) 94%, var(--clay-cream) 6%);
  }

  :global(:root[data-theme='dark'] .blog-year-groups summary),
  :global(:root[data-theme='dark'] .blog-year-groups a),
  :global(:root[data-theme='dark'] .blog-sidebar-toggle) {
    color: var(--clay-ink) !important;
  }

  :global(:root[data-theme='dark'] .blog-year-groups summary) {
    border-color: var(--clay-border);
    background: color-mix(in srgb, var(--clay-paper) 86%, transparent);
  }

  :global(:root[data-theme='dark'] .blog-year-count) {
    background: rgba(247, 241, 234, 0.1);
    color: var(--clay-ink);
  }

  :global(:root[data-theme='dark'] .blog-sidebar-toggle__icon-wrap) {
    background: color-mix(in srgb, var(--clay-paper) 86%, white 14%);
    border-color: var(--clay-border);
  }
</style>

<script is:inline>
  function syncBlogSidebarToggle() {
    const toggle = document.querySelector('.blog-sidebar [data-blog-sidebar-toggle]');
    if (!(toggle instanceof HTMLButtonElement)) return;
    const isMobile = window.matchMedia('(max-width: 720px)').matches;
    const viewport = isMobile ? 'mobile' : 'desktop';

    if (toggle.dataset.initialized !== 'true' || toggle.dataset.viewport !== viewport) {
      document.body.classList.toggle('blog-sidebar-collapsed', isMobile);
      toggle.dataset.initialized = 'true';
      toggle.dataset.viewport = viewport;
    }

    const collapsed = document.body.classList.contains('blog-sidebar-collapsed');
    toggle.hidden = false;
    toggle.setAttribute('aria-pressed', String(!collapsed));
    toggle.setAttribute('aria-label', collapsed ? 'Open blog sidebar' : 'Collapse blog sidebar');
    toggle.dataset.collapsed = String(collapsed);

    document.querySelectorAll('.blog-year-groups > details').forEach((detail) => {
      if (!(detail instanceof HTMLDetailsElement)) return;

      if (collapsed) {
        if (!detail.dataset.openBeforeCollapse) {
          detail.dataset.openBeforeCollapse = detail.open ? 'true' : 'false';
        }
        detail.open = true;
      } else if (detail.dataset.openBeforeCollapse) {
        detail.open = detail.dataset.openBeforeCollapse === 'true';
        delete detail.dataset.openBeforeCollapse;
      }
    });
  }

  function setupBlogSidebarToggle() {
    const toggle = document.querySelector('.blog-sidebar [data-blog-sidebar-toggle]');
    if (!(toggle instanceof HTMLButtonElement)) return;

    if (toggle.dataset.bound !== 'true') {
      toggle.dataset.bound = 'true';
      toggle.addEventListener('click', () => {
        const nextCollapsed = !document.body.classList.contains('blog-sidebar-collapsed');
        document.body.classList.toggle('blog-sidebar-collapsed', nextCollapsed);
        syncBlogSidebarToggle();
      });
    }

    syncBlogSidebarToggle();
  }

  function setupCollapsedSidebarHoverMode() {
    const summaries = Array.from(document.querySelectorAll('.blog-year-groups > details > summary'));

    summaries.forEach((summary) => {
      if (!(summary instanceof HTMLElement) || summary.dataset.collapsedHoverBound === 'true') return;

      summary.dataset.collapsedHoverBound = 'true';
      summary.addEventListener('click', (event) => {
        if (!document.body.classList.contains('blog-sidebar-collapsed')) return;
        event.preventDefault();
      });
    });
  }

  setupBlogSidebarToggle();
  setupCollapsedSidebarHoverMode();

  if (!window.__blogSidebarHeaderToggleBound) {
    document.addEventListener('astro:after-swap', setupBlogSidebarToggle);
    document.addEventListener('astro:after-swap', setupCollapsedSidebarHoverMode);
    window.addEventListener('resize', setupBlogSidebarToggle, { passive: true });
    window.__blogSidebarHeaderToggleBound = true;
  }
</script>
