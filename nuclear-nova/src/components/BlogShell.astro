---
import BlogSidebar from './BlogSidebar.astro';

interface Props {
  currentPath?: string;
  reserveSecondary?: boolean;
}

const { currentPath = '', reserveSecondary = false } = Astro.props;
const hasSecondary = Astro.slots.has('secondary');
const showSecondary = hasSecondary || reserveSecondary;
---

<div class:list={['blog-layout', { 'blog-layout--with-secondary': showSecondary }]}>
  <BlogSidebar currentPath={currentPath} />

  <section class="blog-main">
    <div class="blog-main__inner">
      <slot />
    </div>
  </section>

  {showSecondary && (
    <aside class="blog-secondary" aria-label="On this page">
      <div class="blog-secondary__inner">
        {hasSecondary && <slot name="secondary" />}
      </div>
    </aside>
  )}
</div>

<style>
  .blog-layout {
    --blog-sidebar-width: clamp(14.5rem, 18vw, 17rem);
    --blog-sidebar-collapsed-width: 3.1rem;
    --blog-main-max-width: 68rem;
    --blog-main-expanded-max-width: none;
    --blog-secondary-width: 14rem;
    --blog-layout-gap: clamp(1rem, 1.6vw, 1.45rem);
    --blog-sidebar-hover: rgba(248, 204, 101, 0.2);
    --blog-sidebar-active: rgba(59, 211, 253, 0.2);
    --blog-sidebar-active-strong: rgba(1, 65, 141, 0.1);
    --blog-sidebar-surface:
      linear-gradient(150deg, rgba(255, 255, 255, 0.28), transparent 34%),
      linear-gradient(
        180deg,
        rgba(246, 238, 225, 0.96) 0%,
        rgba(239, 228, 210, 0.94) 100%
      );
    --blog-sidebar-flyout-bg:
      linear-gradient(180deg, rgba(255, 255, 255, 0.24), transparent 38%),
      linear-gradient(
        180deg,
        rgba(246, 238, 225, 0.96) 0%,
        rgba(239, 228, 210, 0.94) 100%
      );
    display: grid;
    grid-template-columns: var(--blog-sidebar-width) minmax(0, 1fr);
    gap: var(--blog-layout-gap);
    width: 100%;
    position: relative;
    isolation: isolate;
    align-items: start;
    transition: grid-template-columns 0.24s ease, gap 0.24s ease;
  }

  .blog-layout.blog-layout--with-secondary {
    grid-template-columns:
      var(--blog-sidebar-width)
      minmax(0, 1fr)
      var(--blog-secondary-width);
  }

  :global(.blog-sidebar) {
    position: sticky;
    top: 5.45rem;
    align-self: start;
    width: var(--blog-sidebar-width);
    height: calc(100vh - 6rem);
    max-height: calc(100vh - 6rem);
    border: 1px solid color-mix(in srgb, var(--clay-border) 82%, white 18%);
    border-radius: 26px;
    background: var(--blog-sidebar-surface) !important;
    box-shadow:
      0 16px 32px rgba(58, 44, 24, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.38) inset;
    overflow: visible;
    z-index: 20;
    transition:
      width 0.22s ease,
      border-color 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }

  :global(.blog-sidebar__inner) {
    height: 100%;
    max-height: calc(100vh - 6rem);
    box-sizing: border-box;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.72rem;
    padding: 0.85rem;
  }

  :global(.blog-sidebar__header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.18rem 0.1rem 0.72rem 0.2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--clay-border) 54%, transparent);
  }

  :global(.blog-sidebar__eyebrow) {
    margin: 0;
    color: color-mix(in srgb, var(--clay-muted) 88%, var(--sl-color-text) 12%);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.blog-sidebar__content) {
    min-height: 0;
    overflow: auto;
    padding-right: 0.16rem;
    scrollbar-width: thin;
  }

  .blog-main {
    min-width: 0;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 0;
  }

  .blog-main__inner {
    width: 100%;
    min-width: 0;
    max-width: var(--blog-main-max-width);
    transition: max-width 0.24s ease;
  }

  .blog-secondary {
    position: sticky;
    top: 5.1rem;
    align-self: start;
    width: var(--blog-secondary-width);
    justify-self: end;
    z-index: 0;
  }

  .blog-secondary__inner {
    width: 100%;
  }

  :global(.blog-year-groups summary),
  :global(.blog-year-groups a) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    box-sizing: border-box;
    color: var(--sl-color-text) !important;
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.45;
    padding: 0.64rem 0.7rem;
    border-radius: 14px;
    position: relative;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  :global(.blog-year-groups summary:hover),
  :global(.blog-year-groups a:hover) {
    background: var(--blog-sidebar-hover);
    box-shadow: 0 8px 18px rgba(58, 44, 24, 0.06);
  }

  :global(.blog-year-groups summary[aria-current='true']),
  :global(.blog-year-groups a.active),
  :global(.blog-year-groups a[aria-current='page']) {
    background: linear-gradient(
      135deg,
      var(--year-rail-soft, var(--blog-sidebar-active)) 0%,
      color-mix(in srgb, var(--year-rail-soft, var(--blog-sidebar-active)) 46%, #ffffff 54%) 100%
    );
  }

  :global(.blog-year-groups) {
    display: grid;
    gap: 0.42rem;
    margin-top: 0;
  }

  :global(.blog-year-groups details) {
    border: 0;
    border-radius: 14px;
    background: transparent;
    overflow: visible;
    position: relative;
  }

  :global(.blog-year-groups summary) {
    --year-rail-accent: color-mix(in srgb, var(--sl-color-text) 62%, var(--clay-muted) 38%);
    --year-rail-soft: color-mix(in srgb, var(--year-rail-accent) 13%, transparent);
    --year-rail-border: color-mix(in srgb, var(--year-rail-accent) 32%, var(--clay-border));
    cursor: pointer;
    justify-content: space-between;
    list-style: none;
    border: 1px solid transparent;
    background: transparent;
    box-shadow: none;
  }

  :global(.blog-year-groups summary[data-year='2026']) {
    --year-rail-accent: #0197b4;
    --year-rail-soft: rgba(1, 151, 180, 0.13);
    --year-rail-border: rgba(1, 151, 180, 0.34);
  }

  :global(.blog-year-groups summary[data-year='2025']) {
    --year-rail-accent: #a65f00;
    --year-rail-soft: rgba(248, 204, 101, 0.24);
    --year-rail-border: rgba(166, 95, 0, 0.26);
  }

  :global(.blog-year-groups summary[data-year='2024']) {
    --year-rail-accent: #6a7f2c;
    --year-rail-soft: rgba(154, 178, 84, 0.2);
    --year-rail-border: rgba(106, 127, 44, 0.28);
  }

  :global(.blog-year-groups summary[data-year='2021']) {
    --year-rail-accent: #7b62b8;
    --year-rail-soft: rgba(123, 98, 184, 0.16);
    --year-rail-border: rgba(123, 98, 184, 0.28);
  }

  :global(.blog-year-groups summary[data-year='2020']) {
    --year-rail-accent: #c05f72;
    --year-rail-soft: rgba(192, 95, 114, 0.15);
    --year-rail-border: rgba(192, 95, 114, 0.27);
  }

  :global(.blog-year-groups summary[data-year='2012']) {
    --year-rail-accent: #667985;
    --year-rail-soft: rgba(102, 121, 133, 0.16);
    --year-rail-border: rgba(102, 121, 133, 0.28);
  }

  :global(.blog-year-groups summary[data-year]:hover) {
    background: var(--year-rail-soft);
    border-color: var(--year-rail-border);
  }

  :global(.blog-year-groups details[open] > summary) {
    border-color: var(--year-rail-border);
    background: color-mix(in srgb, var(--year-rail-soft) 66%, var(--clay-paper) 34%);
    box-shadow:
      inset 3px 0 0 color-mix(in srgb, var(--year-rail-accent) 42%, transparent),
      0 6px 16px rgba(58, 44, 24, 0.05);
  }

  :global(.blog-year-groups summary::-webkit-details-marker) {
    display: none;
  }

  :global(.blog-year-groups summary::marker) {
    content: '';
  }

  :global(.blog-year-groups summary::before) {
    content: none !important;
    display: none !important;
  }

  :global(.blog-year-summary) {
    min-width: 0;
    display: flex;
    align-items: center;
    flex: 1;
  }

  :global(.blog-year-icon) {
    display: none;
  }

  :global(.blog-year-meta) {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  :global(.blog-year-label) {
    min-width: 0;
    color: color-mix(in srgb, var(--year-rail-accent, var(--sl-color-text)) 30%, var(--sl-color-text) 70%);
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: color 0.18s ease;
  }

  :global(.blog-year-groups summary:hover .blog-year-label),
  :global(.blog-year-groups details[open] > summary .blog-year-label),
  :global(.blog-year-groups summary[aria-current='true'] .blog-year-label) {
    color: color-mix(in srgb, var(--year-rail-accent) 58%, var(--sl-color-text) 42%);
  }

  :global(.blog-year-count) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.7rem;
    padding: 0.12rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--year-rail-soft, var(--blog-sidebar-active-strong)) 74%, white 26%);
    color: color-mix(in srgb, var(--year-rail-accent, var(--clay-muted)) 68%, var(--sl-color-text) 32%);
    font-size: 0.72rem;
    font-family: var(--font-space-mono);
  }

  :global(.blog-year-chevron) {
    width: 1.15rem;
    height: 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--sl-color-text) 66%, white 34%);
    flex: none;
    transition: transform 0.18s ease, color 0.18s ease;
  }

  :global(.blog-year-chevron svg) {
    width: 0.92rem;
    height: 0.92rem;
    display: block;
  }

  :global(.blog-year-groups details[open] .blog-year-chevron) {
    transform: rotate(180deg);
    color: color-mix(in srgb, var(--year-rail-accent) 64%, var(--sl-color-text) 36%);
  }

  :global(.blog-year-groups ul) {
    list-style: none;
    margin: 0;
    padding: 0.3rem 0 0 0.95rem;
    display: grid;
    gap: 0.12rem;
    position: relative;
  }

  :global(.blog-year-groups ul::before) {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0.08rem;
    bottom: 0.72rem;
    width: 1px;
    background: color-mix(in srgb, var(--clay-border) 54%, white 46%);
  }

  :global(.blog-year-groups li) {
    position: relative;
  }

  :global(.blog-year-groups a) {
    padding: 0.5rem 0.62rem;
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--sl-color-text) 74%, white 26%) !important;
  }

  :global(.blog-year-groups a::before) {
    content: '';
    position: absolute;
    left: -0.52rem;
    top: 50%;
    width: 0.36rem;
    height: 1px;
    background: color-mix(in srgb, var(--clay-border) 54%, white 46%);
  }

  :global(.blog-sidebar-toggle) {
    position: relative;
    z-index: 4;
    width: 2rem;
    height: 2rem;
    display: inline-grid;
    align-items: center;
    justify-content: center;
    flex: none;
    padding: 0;
    color: color-mix(in srgb, var(--sl-color-text) 62%, var(--clay-muted) 38%);
    border: 1px solid transparent;
    background: transparent !important;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: none;
    transition:
      transform 0.18s ease,
      color 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  :global(.blog-sidebar-toggle:hover),
  :global(.blog-sidebar-toggle:focus-visible) {
    color: var(--sl-color-text);
    border-color: color-mix(in srgb, var(--clay-border) 64%, white 36%);
    background: color-mix(in srgb, var(--blog-sidebar-active) 42%, transparent) !important;
    box-shadow: 0 8px 18px rgba(58, 44, 24, 0.07);
  }

  :global(.blog-sidebar-toggle:focus-visible) {
    outline: 2px solid color-mix(in srgb, var(--clay-blueberry-800) 42%, transparent);
    outline-offset: 2px;
  }

  :global(.blog-sidebar-toggle__icon-wrap) {
    width: 1rem;
    height: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    background: transparent;
    border: 0;
  }

  :global(.blog-sidebar-toggle__icon) {
    width: 1rem;
    height: 1rem;
    display: block;
    opacity: 0.86;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  :global(.blog-sidebar-toggle:hover .blog-sidebar-toggle__icon),
  :global(.blog-sidebar-toggle:focus-visible .blog-sidebar-toggle__icon) {
    opacity: 1;
  }

  :global(.blog-sidebar-toggle__label) {
    display: none;
  }

  :global(.blog-sidebar-toggle[data-collapsed='true'] .blog-sidebar-toggle__icon) {
    transform: scaleX(-1);
  }

  :global(body.blog-sidebar-collapsed) .blog-layout {
    grid-template-columns: var(--blog-sidebar-collapsed-width) minmax(0, 1fr);
    gap: clamp(0.65rem, 1.1vw, 1rem);
  }

  :global(body.blog-sidebar-collapsed) .blog-layout.blog-layout--with-secondary {
    grid-template-columns:
      var(--blog-sidebar-collapsed-width)
      minmax(0, 1fr)
      var(--blog-secondary-width);
  }

  :global(body.blog-sidebar-collapsed) .blog-main__inner {
    max-width: var(--blog-main-expanded-max-width);
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar) {
    width: var(--blog-sidebar-collapsed-width);
    min-width: 0;
    height: calc(100vh - 6rem);
    min-height: 8rem;
    border-color: color-mix(in srgb, var(--clay-border) 74%, white 26%);
    border-radius: 22px;
    background: var(--blog-sidebar-surface) !important;
    box-shadow:
      0 14px 28px rgba(58, 44, 24, 0.07),
      0 0 0 1px rgba(255, 255, 255, 0.34) inset;
    overflow: visible;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__inner) {
    display: block;
    max-height: none;
    padding: 0.82rem 0.42rem;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__header) {
    justify-content: center;
    padding: 0 0 0.78rem;
    border-bottom: 1px solid color-mix(in srgb, var(--clay-border) 46%, transparent);
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__eyebrow) {
    display: none;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__content) {
    display: block;
    overflow: visible;
    padding: 0.74rem 0 0;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups) {
    justify-items: center;
    gap: 0.48rem;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups details) {
    width: 100%;
    border-radius: 12px;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups summary) {
    width: 2.32rem;
    height: 2.32rem;
    justify-content: center;
    padding: 0;
    border-radius: 999px;
    color: var(--year-rail-accent) !important;
    border-color: var(--year-rail-border);
    background:
      radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.56), transparent 42%),
      var(--year-rail-soft);
    box-shadow:
      0 7px 16px rgba(58, 44, 24, 0.06),
      0 0 0 1px rgba(255, 255, 255, 0.34) inset;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups summary:hover),
  :global(body.blog-sidebar-collapsed .blog-year-groups summary:focus-visible) {
    color: color-mix(in srgb, var(--year-rail-accent) 84%, var(--sl-color-text) 16%) !important;
    border-color: color-mix(in srgb, var(--year-rail-accent) 52%, var(--clay-border));
    background:
      radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.7), transparent 44%),
      color-mix(in srgb, var(--year-rail-accent) 18%, transparent);
    box-shadow:
      0 9px 18px rgba(58, 44, 24, 0.09),
      0 0 0 1px rgba(255, 255, 255, 0.42) inset;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups details[open] > summary) {
    border-color: var(--year-rail-border);
    background:
      radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.56), transparent 42%),
      var(--year-rail-soft);
    box-shadow:
      0 7px 16px rgba(58, 44, 24, 0.06),
      0 0 0 1px rgba(255, 255, 255, 0.34) inset;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups details[open] > summary:hover),
  :global(body.blog-sidebar-collapsed .blog-year-groups details[open] > summary:focus-visible) {
    color: color-mix(in srgb, var(--year-rail-accent) 84%, var(--sl-color-text) 16%) !important;
    border-color: color-mix(in srgb, var(--year-rail-accent) 52%, var(--clay-border));
    background:
      radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.7), transparent 44%),
      color-mix(in srgb, var(--year-rail-accent) 18%, transparent);
    box-shadow:
      0 9px 18px rgba(58, 44, 24, 0.09),
      0 0 0 1px rgba(255, 255, 255, 0.42) inset;
  }

  :global(body.blog-sidebar-collapsed .blog-year-groups summary[aria-current='true']) {
    color: color-mix(in srgb, var(--year-rail-accent) 76%, var(--sl-color-text) 24%) !important;
    border-color: color-mix(in srgb, var(--year-rail-accent) 58%, var(--clay-border));
    background:
      radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.74), transparent 44%),
      color-mix(in srgb, var(--year-rail-accent) 23%, white 77%);
    box-shadow:
      0 9px 18px rgba(58, 44, 24, 0.1),
      0 0 0 1px rgba(255, 255, 255, 0.48) inset;
  }

  :global(body.blog-sidebar-collapsed .blog-year-summary) {
    flex: none;
    justify-content: center;
  }

  :global(body.blog-sidebar-collapsed .blog-year-icon) {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.48rem;
    height: 1.48rem;
  }

  :global(body.blog-sidebar-collapsed .blog-year-icon svg) {
    width: 1.48rem;
    height: 1.48rem;
    display: block;
    opacity: 0.92;
  }

  :global(body.blog-sidebar-collapsed .blog-year-icon span) {
    position: absolute;
    top: 0.58rem;
    left: 50%;
    transform: translateX(-50%);
    color: currentColor;
    font-family: var(--font-space-mono);
    font-size: 0.56rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
  }

  :global(body.blog-sidebar-collapsed .blog-year-meta),
  :global(body.blog-sidebar-collapsed .blog-year-chevron),
  :global(body.blog-sidebar-collapsed .blog-year-groups ul) {
    display: none;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle) {
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border-color: transparent;
    border-radius: 10px;
    background: transparent !important;
    box-shadow: none;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle:hover),
  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle:focus-visible) {
    border-color: color-mix(in srgb, var(--clay-border) 58%, white 42%);
    background: color-mix(in srgb, var(--blog-sidebar-active) 48%, transparent) !important;
    box-shadow: 0 8px 18px rgba(58, 44, 24, 0.07);
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle__icon-wrap) {
    width: 1rem;
    height: 1rem;
    background: transparent;
    box-shadow: none;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle__icon) {
    width: 1rem;
    height: 1rem;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle__label) {
    display: none;
  }

  @media (max-width: 980px) {
    .blog-layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 1.1rem;
    }

    .blog-secondary {
      display: none;
    }

    :global(body.blog-sidebar-collapsed) .blog-layout {
      grid-template-columns: var(--blog-sidebar-collapsed-width) minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .blog-layout {
      display: block;
    }

    :global(.blog-sidebar) {
      position: fixed;
      top: 5rem;
      left: 0.75rem;
      width: min(17rem, calc(100vw - 1.5rem));
      max-height: calc(100dvh - 5.75rem);
      z-index: 45;
      transform: translateX(0);
    }

    :global(.blog-sidebar-toggle) {
      top: 50%;
      right: -0.58rem;
      width: 1.2rem;
      height: 3.4rem;
      position: absolute;
      gap: 0;
      padding: 0;
      border: 1px solid color-mix(in srgb, var(--clay-border) 74%, white 26%);
      border-left: 0;
      border-radius: 0 999px 999px 0;
      transform: translateY(-50%);
    }

    :global(.blog-sidebar-toggle:hover) {
      transform: translateY(-50%) translateX(0.08rem);
      background: var(--blog-sidebar-hover) !important;
      box-shadow: 0 8px 18px rgba(58, 44, 24, 0.08);
    }

    :global(.blog-sidebar-toggle__icon-wrap) {
      width: 0.78rem;
      height: 2.1rem;
      background: transparent;
      box-shadow: none;
    }

    :global(.blog-sidebar-toggle__icon) {
      width: 0.72rem;
      height: 0.72rem;
    }

    :global(.blog-sidebar-toggle__label) {
      display: none;
    }

    :global(body.blog-sidebar-collapsed .blog-sidebar) {
      width: 0;
      height: 0;
      transform: none;
      border: 0;
      background: transparent !important;
      box-shadow: none;
    }

    :global(body.blog-sidebar-collapsed .blog-sidebar__header) {
      padding: 0;
