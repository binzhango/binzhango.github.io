---
import BlogSidebar from './BlogSidebar.astro';

interface Props {
  currentPath?: string;
  reserveSecondary?: boolean;
}

const { currentPath = '', reserveSecondary = false } = Astro.props;
const hasSecondary = Astro.slots.has('secondary');
const showSecondary = hasSecondary || reserveSecondary;
---

<div class:list={['blog-layout', { 'blog-layout--with-secondary': showSecondary }]}>
  <BlogSidebar currentPath={currentPath} />

  <section class="blog-main">
    <div class="blog-main__inner">
      <slot />
    </div>
  </section>

  {showSecondary && (
    <aside class="blog-secondary" aria-label="On this page">
      <div class="blog-secondary__inner">
        {hasSecondary && <slot name="secondary" />}
      </div>
    </aside>
  )}
</div>

<style>
  .blog-layout {
    --blog-sidebar-width: clamp(14.5rem, 18vw, 17rem);
    --blog-sidebar-collapsed-width: 2.6rem;
    --blog-main-max-width: 68rem;
    --blog-main-expanded-max-width: 82rem;
    --blog-secondary-width: 14rem;
    --blog-layout-gap: clamp(1rem, 1.6vw, 1.45rem);
    --blog-sidebar-hover: rgba(248, 204, 101, 0.2);
    --blog-sidebar-active: rgba(59, 211, 253, 0.2);
    --blog-sidebar-active-strong: rgba(1, 65, 141, 0.1);
    --blog-sidebar-surface:
      linear-gradient(150deg, rgba(255, 255, 255, 0.28), transparent 34%),
      linear-gradient(
        180deg,
        rgba(246, 238, 225, 0.96) 0%,
        rgba(239, 228, 210, 0.94) 100%
      );
    --blog-sidebar-flyout-bg:
      linear-gradient(180deg, rgba(255, 255, 255, 0.24), transparent 38%),
      linear-gradient(
        180deg,
        rgba(246, 238, 225, 0.96) 0%,
        rgba(239, 228, 210, 0.94) 100%
      );
    display: grid;
    grid-template-columns: var(--blog-sidebar-width) minmax(0, 1fr);
    gap: var(--blog-layout-gap);
    width: 100%;
    position: relative;
    isolation: isolate;
    align-items: start;
    transition: grid-template-columns 0.24s ease, gap 0.24s ease;
  }

  .blog-layout.blog-layout--with-secondary {
    grid-template-columns:
      var(--blog-sidebar-width)
      minmax(0, 1fr)
      var(--blog-secondary-width);
  }

  :global(.blog-sidebar) {
    position: sticky;
    top: 5.45rem;
    align-self: start;
    width: var(--blog-sidebar-width);
    height: calc(100vh - 6rem);
    max-height: calc(100vh - 6rem);
    border: 1px solid color-mix(in srgb, var(--clay-border) 82%, white 18%);
    border-radius: 26px;
    background: var(--blog-sidebar-surface) !important;
    box-shadow:
      0 16px 32px rgba(58, 44, 24, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.38) inset;
    overflow: visible;
    z-index: 20;
    transition:
      width 0.22s ease,
      border-color 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }

  :global(.blog-sidebar__inner) {
    height: 100%;
    max-height: calc(100vh - 6rem);
    box-sizing: border-box;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.72rem;
    padding: 0.85rem;
  }

  :global(.blog-sidebar__header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.25rem 1.2rem 0.65rem 0.2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--clay-border) 54%, transparent);
  }

  :global(.blog-sidebar__eyebrow) {
    margin: 0;
    color: color-mix(in srgb, var(--clay-muted) 88%, var(--sl-color-text) 12%);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.blog-sidebar__content) {
    min-height: 0;
    overflow: auto;
    padding-right: 0.16rem;
    scrollbar-width: thin;
  }

  .blog-main {
    min-width: 0;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 0;
  }

  .blog-main__inner {
    width: 100%;
    min-width: 0;
    max-width: var(--blog-main-max-width);
    transition: max-width 0.24s ease;
  }

  .blog-secondary {
    position: sticky;
    top: 5.1rem;
    align-self: start;
    width: var(--blog-secondary-width);
    justify-self: end;
    z-index: 0;
  }

  .blog-secondary__inner {
    width: 100%;
  }

  :global(.blog-year-groups summary),
  :global(.blog-year-groups a) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    box-sizing: border-box;
    color: var(--sl-color-text) !important;
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.45;
    padding: 0.64rem 0.7rem;
    border-radius: 14px;
    position: relative;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  :global(.blog-year-groups summary:hover),
  :global(.blog-year-groups a:hover) {
    background: var(--blog-sidebar-hover);
    box-shadow: 0 8px 18px rgba(58, 44, 24, 0.06);
  }

  :global(.blog-year-groups summary[aria-current='true']),
  :global(.blog-year-groups a.active),
  :global(.blog-year-groups a[aria-current='page']) {
    background: linear-gradient(
      135deg,
      var(--blog-sidebar-active) 0%,
      color-mix(in srgb, var(--blog-sidebar-active) 48%, #ffffff 52%) 100%
    );
  }

  :global(.blog-year-groups) {
    display: grid;
    gap: 0.42rem;
    margin-top: 0;
  }

  :global(.blog-year-groups details) {
    border: 0;
    border-radius: 14px;
    background: transparent;
    overflow: visible;
    position: relative;
  }

  :global(.blog-year-groups summary) {
    cursor: pointer;
    justify-content: space-between;
    list-style: none;
    border: 1px solid transparent;
    background: transparent;
    box-shadow: none;
  }

  :global(.blog-year-groups details[open] > summary) {
    border-color: color-mix(in srgb, var(--clay-border) 60%, white 40%);
    background: color-mix(in srgb, var(--clay-paper) 46%, transparent);
    box-shadow:
      inset 3px 0 0 rgba(1, 65, 141, 0.14),
      0 6px 16px rgba(58, 44, 24, 0.05);
  }

  :global(.blog-year-groups summary::-webkit-details-marker) {
    display: none;
  }

  :global(.blog-year-groups summary::marker) {
    content: '';
  }

  :global(.blog-year-groups summary::before) {
    content: none !important;
    display: none !important;
  }

  :global(.blog-year-summary) {
    min-width: 0;
    display: flex;
    align-items: center;
    flex: 1;
  }

  :global(.blog-year-meta) {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  :global(.blog-year-label) {
    min-width: 0;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  :global(.blog-year-count) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.7rem;
    padding: 0.12rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blog-sidebar-active-strong) 72%, white 28%);
    color: color-mix(in srgb, var(--clay-muted) 80%, var(--sl-color-text) 20%);
    font-size: 0.72rem;
    font-family: var(--font-space-mono);
  }

  :global(.blog-year-chevron) {
    width: 1.15rem;
    height: 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--sl-color-text) 66%, white 34%);
    flex: none;
    transition: transform 0.18s ease, color 0.18s ease;
  }

  :global(.blog-year-chevron svg) {
    width: 0.92rem;
    height: 0.92rem;
    display: block;
  }

  :global(.blog-year-groups details[open] .blog-year-chevron) {
    transform: rotate(180deg);
    color: color-mix(in srgb, var(--sl-color-text) 82%, white 18%);
  }

  :global(.blog-year-groups ul) {
    list-style: none;
    margin: 0;
    padding: 0.3rem 0 0 0.95rem;
    display: grid;
    gap: 0.12rem;
    position: relative;
  }

  :global(.blog-year-groups ul::before) {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0.08rem;
    bottom: 0.72rem;
    width: 1px;
    background: color-mix(in srgb, var(--clay-border) 54%, white 46%);
  }

  :global(.blog-year-groups li) {
    position: relative;
  }

  :global(.blog-year-groups a) {
    padding: 0.5rem 0.62rem;
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--sl-color-text) 74%, white 26%) !important;
  }

  :global(.blog-year-groups a::before) {
    content: '';
    position: absolute;
    left: -0.52rem;
    top: 50%;
    width: 0.36rem;
    height: 1px;
    background: color-mix(in srgb, var(--clay-border) 54%, white 46%);
  }

  :global(.blog-sidebar-toggle) {
    position: absolute;
    top: 50%;
    right: -0.58rem;
    z-index: 4;
    width: 1.2rem;
    height: 3.65rem;
    display: inline-grid;
    align-items: center;
    justify-content: center;
    flex: none;
    padding: 0;
    color: var(--sl-color-text);
    border: 1px solid color-mix(in srgb, var(--clay-border) 74%, white 26%);
    border-left: 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--clay-cream) 90%, transparent), color-mix(in srgb, var(--clay-paper) 74%, rgba(248, 204, 101, 0.16))),
      color-mix(in srgb, var(--clay-cream) 92%, transparent) !important;
    border-radius: 0 999px 999px 0;
    cursor: pointer;
    box-shadow:
      6px 10px 18px rgba(58, 44, 24, 0.1),
      -1px 0 0 color-mix(in srgb, var(--clay-border) 58%, transparent),
      1px 0 0 rgba(255, 255, 255, 0.5) inset;
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
    transform: translateY(-50%);
  }

  :global(.blog-sidebar-toggle:hover) {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--clay-cream) 84%, transparent), color-mix(in srgb, var(--clay-paper) 62%, rgba(248, 204, 101, 0.28))),
      color-mix(in srgb, var(--clay-cream) 90%, transparent) !important;
    border-color: color-mix(in srgb, var(--clay-blueberry-800) 18%, var(--clay-border));
    border-left: 0;
    box-shadow:
      8px 12px 22px rgba(58, 44, 24, 0.14),
      -1px 0 0 color-mix(in srgb, var(--clay-border) 52%, transparent),
      1px 0 0 rgba(255, 255, 255, 0.58) inset;
    transform: translateY(-50%) translateX(0.06rem);
  }

  :global(.blog-sidebar-toggle__icon-wrap) {
    width: 0.78rem;
    height: 2.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: transparent;
    border: 0;
  }

  :global(.blog-sidebar-toggle__icon) {
    width: 0.72rem;
    height: 0.72rem;
    display: block;
    opacity: 0.8;
  }

  :global(.blog-sidebar-toggle::before) {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.22rem;
    width: 2px;
    height: 1.1rem;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 18%, transparent);
    transform: translateY(-50%);
  }

  :global(.blog-sidebar-toggle__label) {
    display: none;
  }

  :global(.blog-sidebar-toggle[data-collapsed='true'] .blog-sidebar-toggle__icon) {
    transform: scaleX(-1);
  }

  :global(body.blog-sidebar-collapsed) .blog-layout {
    grid-template-columns: var(--blog-sidebar-collapsed-width) minmax(0, 1fr);
    gap: clamp(0.65rem, 1.1vw, 1rem);
  }

  :global(body.blog-sidebar-collapsed) .blog-layout.blog-layout--with-secondary {
    grid-template-columns:
      var(--blog-sidebar-collapsed-width)
      minmax(0, 1fr)
      var(--blog-secondary-width);
  }

  :global(body.blog-sidebar-collapsed) .blog-main__inner {
    max-width: var(--blog-main-expanded-max-width);
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar) {
    width: var(--blog-sidebar-collapsed-width);
    min-width: 0;
    height: calc(100vh - 6rem);
    min-height: 8rem;
    border-color: transparent;
    background: transparent !important;
    box-shadow: none;
    overflow: visible;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__inner) {
    display: block;
    max-height: none;
    padding: 0;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__header) {
    justify-content: center;
    padding: 0;
    border-bottom: 0;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__eyebrow) {
    display: none;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar__content) {
    display: none;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle) {
    top: 50%;
    right: -0.58rem;
    width: 1.2rem;
    height: 3.65rem;
    padding: 0;
    border-color: color-mix(in srgb, var(--clay-blueberry-800) 18%, var(--clay-border));
    border-left: 0;
    border-radius: 0 999px 999px 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--clay-cream) 88%, transparent), color-mix(in srgb, var(--clay-paper) 64%, rgba(248, 204, 101, 0.24))),
      color-mix(in srgb, var(--clay-cream) 92%, transparent) !important;
    box-shadow:
      8px 12px 22px rgba(58, 44, 24, 0.14),
      -1px 0 0 color-mix(in srgb, var(--clay-border) 54%, transparent),
      1px 0 0 rgba(255, 255, 255, 0.58) inset;
    transform: translateY(-50%);
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle:hover) {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--clay-cream) 82%, transparent), color-mix(in srgb, var(--clay-paper) 56%, rgba(248, 204, 101, 0.34))),
      color-mix(in srgb, var(--clay-cream) 90%, transparent) !important;
    box-shadow:
      10px 14px 24px rgba(58, 44, 24, 0.18),
      -1px 0 0 color-mix(in srgb, var(--clay-border) 48%, transparent),
      1px 0 0 rgba(255, 255, 255, 0.62) inset;
    transform: translateY(-50%) translateX(0.06rem);
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle__icon-wrap) {
    width: 0.78rem;
    height: 2.2rem;
    background: transparent;
    box-shadow: none;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle__icon) {
    width: 0.72rem;
    height: 0.72rem;
  }

  :global(body.blog-sidebar-collapsed .blog-sidebar-toggle__label) {
    display: none;
  }

  @media (max-width: 980px) {
    .blog-layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 1.1rem;
    }

    .blog-secondary {
      display: none;
    }

    :global(body.blog-sidebar-collapsed) .blog-layout {
      grid-template-columns: var(--blog-sidebar-collapsed-width) minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .blog-layout {
      display: block;
    }

    :global(.blog-sidebar) {
      position: fixed;
      top: 5rem;
      left: 0.75rem;
      width: min(17rem, calc(100vw - 1.5rem));
      max-height: calc(100dvh - 5.75rem);
      z-index: 45;
      transform: translateX(0);
    }

    :global(.blog-sidebar-toggle) {
      top: 50%;
      right: -0.58rem;
      width: 1.2rem;
      height: 3.4rem;
      gap: 0;
      padding: 0;
      border-radius: 0 999px 999px 0;
      transform: translateY(-50%);
    }

    :global(.blog-sidebar-toggle:hover) {
      transform: translateY(-50%) translateX(0.08rem);
      background: var(--blog-sidebar-hover) !important;
      box-shadow: 0 8px 18px rgba(58, 44, 24, 0.08);
    }

    :global(.blog-sidebar-toggle__icon-wrap) {
      width: 0.78rem;
      height: 2.1rem;
      background: transparent;
      box-shadow: none;
    }

    :global(.blog-sidebar-toggle__icon) {
      width: 0.72rem;
      height: 0.72rem;
    }

    :global(.blog-sidebar-toggle__label) {
      display: none;
    }

    :global(body.blog-sidebar-collapsed .blog-sidebar) {
      width: 0;
      height: 0;
      transform: none;
    }

    :global(body.blog-sidebar-collapsed .blog-sidebar__header) {
      padding: 0;
    }

    :global(body.blog-sidebar-collapsed .blog-sidebar-toggle) {
      position: fixed;
      top: auto;
      right: 1rem;
      bottom: 1rem;
      left: auto;
      z-index: 55;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border-radius: 999px;
      transform: none;
    }

    :global(body.blog-sidebar-collapsed .blog-sidebar-toggle__label) {
      display: none;
    }
  }

  :global(:root[data-theme='dark'] .blog-layout) {
    --blog-sidebar-hover: rgba(248, 204, 101, 0.14);
    --blog-sidebar-active: rgba(59, 211, 253, 0.22);
    --blog-sidebar-active-strong: rgba(247, 241, 234, 0.08);
    --blog-sidebar-surface:
      linear-gradient(150deg, rgba(255, 255, 255, 0.025), transparent 32%),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--clay-paper) 90%, #29313a 10%) 0%,
        color-mix(in srgb, var(--clay-cream) 88%, var(--clay-slushie-800) 12%) 100%
      );
    --blog-sidebar-flyout-bg:
      linear-gradient(180deg, rgba(59, 211, 253, 0.08), transparent 30%),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--clay-paper) 90%, #29313a 10%) 0%,
        color-mix(in srgb, var(--clay-cream) 88%, var(--clay-slushie-800) 12%) 100%
      );
  }

  :global(:root[data-theme='dark'] .blog-sidebar) {
    border-color: color-mix(in srgb, var(--clay-border) 72%, var(--clay-slushie-500) 28%);
    background: var(--blog-sidebar-surface) !important;
    box-shadow:
      0 24px 52px rgba(0, 0, 0, 0.32),
      0 0 0 1px rgba(255, 255, 255, 0.035) inset,
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 0 26px color-mix(in srgb, var(--clay-slushie-500) 7%, transparent);
  }

  :global(:root[data-theme='dark'] .blog-year-groups summary),
  :global(:root[data-theme='dark'] .blog-year-groups a),
  :global(:root[data-theme='dark'] .blog-sidebar-toggle) {
    color: var(--clay-ink) !important;
  }

  :global(:root[data-theme='dark'] .blog-year-groups summary) {
    border-color: var(--clay-border);
    background: color-mix(in srgb, var(--clay-paper) 86%, transparent);
  }

  :global(:root[data-theme='dark'] .blog-year-count) {
    background: rgba(247, 241, 234, 0.1);
    color: var(--clay-ink);
  }

  :global(:root[data-theme='dark'] .blog-sidebar-toggle__icon-wrap) {
    background: transparent;
    border-color: var(--clay-border);
  }

  :global(:root[data-theme='dark'] body.blog-sidebar-collapsed .blog-sidebar-toggle) {
    border-color: color-mix(in srgb, var(--clay-slushie-500) 26%, var(--clay-border));
    border-left: 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--clay-cream) 92%, transparent), color-mix(in srgb, var(--clay-paper) 74%, rgba(59, 211, 253, 0.1))),
      color-mix(in srgb, var(--clay-cream) 92%, transparent) !important;
    box-shadow:
      8px 14px 26px rgba(0, 0, 0, 0.34),
      -1px 0 0 color-mix(in srgb, var(--clay-slushie-500) 14%, transparent),
      1px 0 0 rgba(255, 255, 255, 0.055) inset;
  }
</style>

<script is:inline>
  const BLOG_SIDEBAR_STORAGE_KEY = 'blog-sidebar-collapsed';

  function getSavedBlogSidebarState(isMobile) {
    if (isMobile) return true;

    try {
      return window.localStorage.getItem(BLOG_SIDEBAR_STORAGE_KEY) === 'true';
    } catch {
      return false;
    }
  }

  function saveBlogSidebarState(collapsed) {
    try {
      window.localStorage.setItem(BLOG_SIDEBAR_STORAGE_KEY, String(collapsed));
    } catch {
      // Ignore storage failures; the toggle should still work for the current page.
    }
  }

  function syncBlogSidebarToggle() {
    const toggle = document.querySelector('.blog-sidebar [data-blog-sidebar-toggle]');
    if (!(toggle instanceof HTMLButtonElement)) return;
    const isMobile = window.matchMedia('(max-width: 720px)').matches;
    const viewport = isMobile ? 'mobile' : 'desktop';

    if (toggle.dataset.initialized !== 'true' || toggle.dataset.viewport !== viewport) {
      document.body.classList.toggle('blog-sidebar-collapsed', getSavedBlogSidebarState(isMobile));
      toggle.dataset.initialized = 'true';
      toggle.dataset.viewport = viewport;
    }

    const collapsed = document.body.classList.contains('blog-sidebar-collapsed');
    toggle.hidden = false;
    toggle.setAttribute('aria-pressed', String(!collapsed));
    toggle.setAttribute('aria-label', collapsed ? 'Open blog sidebar' : 'Collapse blog sidebar');
    toggle.dataset.collapsed = String(collapsed);

    document.querySelectorAll('.blog-year-groups > details').forEach((detail) => {
      if (!(detail instanceof HTMLDetailsElement)) return;

      if (collapsed) {
        if (!detail.dataset.openBeforeCollapse) {
          detail.dataset.openBeforeCollapse = detail.open ? 'true' : 'false';
        }
        detail.open = true;
      } else if (detail.dataset.openBeforeCollapse) {
        detail.open = detail.dataset.openBeforeCollapse === 'true';
        delete detail.dataset.openBeforeCollapse;
      }
    });
  }

  function setupBlogSidebarToggle() {
    const toggle = document.querySelector('.blog-sidebar [data-blog-sidebar-toggle]');
    if (!(toggle instanceof HTMLButtonElement)) return;

    if (toggle.dataset.bound !== 'true') {
      toggle.dataset.bound = 'true';
      toggle.addEventListener('click', () => {
        const nextCollapsed = !document.body.classList.contains('blog-sidebar-collapsed');
        const isMobile = window.matchMedia('(max-width: 720px)').matches;
        document.body.classList.toggle('blog-sidebar-collapsed', nextCollapsed);
        if (!isMobile) saveBlogSidebarState(nextCollapsed);
        syncBlogSidebarToggle();
      });
    }

    syncBlogSidebarToggle();
  }

  function setupCollapsedSidebarHoverMode() {
    const summaries = Array.from(document.querySelectorAll('.blog-year-groups > details > summary'));

    summaries.forEach((summary) => {
      if (!(summary instanceof HTMLElement) || summary.dataset.collapsedHoverBound === 'true') return;

      summary.dataset.collapsedHoverBound = 'true';
      summary.addEventListener('click', (event) => {
        if (!document.body.classList.contains('blog-sidebar-collapsed')) return;
        event.preventDefault();
      });
    });
  }

  setupBlogSidebarToggle();
  setupCollapsedSidebarHoverMode();

  if (!window.__blogSidebarHeaderToggleBound) {
    document.addEventListener('astro:after-swap', setupBlogSidebarToggle);
    document.addEventListener('astro:after-swap', setupCollapsedSidebarHoverMode);
    window.addEventListener('resize', setupBlogSidebarToggle, { passive: true });
    window.__blogSidebarHeaderToggleBound = true;
  }
</script>
