---
import BrowseControls from './BrowseControls.astro';
import BlogSidebar from './BlogSidebar.astro';
const hasSecondary = Astro.slots.has('secondary');
interface Props { article?: boolean; }
const { article = false } = Astro.props;
---
<div class:list={{ 'article-shell': article }}>
{article ? <a class="article-back" href="/posts/">← All posts</a> : <BrowseControls />}
<div class:list={['blog-layout', { 'blog-layout--article': hasSecondary }]}>
  <aside class="blog-primary" aria-label="Blog navigation"><BlogSidebar /></aside>
  <section class="blog-main"><slot /></section>
  {hasSecondary && <aside class="blog-secondary"><slot name="secondary" /></aside>}
</div>
</div>
<style>
  .article-shell { --reading-width: 52rem; }
  .article-back { display: inline-block; font-size: .875rem; text-decoration: none; padding-block: .35rem; }
  .article-back:hover { text-decoration: underline; }
  .blog-layout {
    --posts-width-expanded: clamp(12rem, 18vw, 15rem);
    --posts-width-collapsed: 5.25rem;
    --posts-width: var(--posts-width-expanded);
    --contents-width: 15rem;
    display: grid;
    grid-template-columns: var(--posts-width) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
    margin-top: 1.5rem;
  }
  .blog-layout--article { grid-template-columns: var(--posts-width) minmax(0, 1fr) var(--contents-width); }
  .blog-layout:has(.blog-primary :global([data-enhanced] > .blog-posts:not([open]))) { --posts-width: var(--posts-width-collapsed); }
  .blog-primary, .blog-secondary { min-width: 0; position: sticky; top: 112px; }
  .blog-main { min-width: 0; }
  @media (max-width: 1023px) {
    .blog-layout--article { grid-template-columns: var(--posts-width) minmax(0, 1fr); }
    .blog-secondary { display: none; }
  }
  @media (max-width: 720px) {
    .blog-layout, .blog-layout--article { grid-template-columns: minmax(0, 1fr); }
    .blog-primary { position: static; }
  }
  @media (min-width: 721px) and (prefers-reduced-motion: no-preference) {
    .blog-layout { transition: grid-template-columns 240ms ease; }
  }
</style>
