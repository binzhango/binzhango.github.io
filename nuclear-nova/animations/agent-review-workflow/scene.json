{"canvas":{"width":1600,"height":900,"fps":15,"duration":8},"title":"A Git-native agent review loop","subtitle":"Commits carry code; append-only refs carry compact handoff and review messages.","layout":{"mode":"manual","direction":"LR"},"exports":{"formats":["mp4","gif"]},"groups":[{"label":"IMPLEMENT","x":60,"y":180,"w":440,"h":550,"accent":"violet"},{"label":"MESSAGE CHANNEL","x":580,"y":180,"w":440,"h":550,"accent":"green"},{"label":"REVIEW","x":1100,"y":180,"w":440,"h":550,"accent":"blue"}],"nodes":[{"id":"task","x":105,"y":250,"w":350,"h":130,"accent":"violet","kicker":"CLAUDE CODE","title":"Implement and verify","detail":"Change code · Run tests"},{"id":"commit","x":105,"y":500,"w":350,"h":130,"accent":"violet","kicker":"GIT COMMIT","title":"Record the revision","detail":"Exact code under review"},{"id":"message","x":625,"y":335,"w":350,"h":160,"accent":"green","kicker":"APPEND-ONLY REF","title":"Publish JSON handoff","detail":"Done · Risk · Pending · SHA"},{"id":"review","x":1145,"y":250,"w":350,"h":130,"accent":"blue","kicker":"CODEX","title":"Review the commit","detail":"Inspect diff · Find risks"},{"id":"decision","x":1145,"y":500,"w":350,"h":130,"accent":"green","kicker":"VERDICT","title":"Approve or request fixes","detail":"Append a new message"}],"edges":[{"from":"task","to":"commit","accent":"violet"},{"from":"commit","to":"message","accent":"green"},{"from":"message","to":"review","accent":"blue"},{"from":"review","to":"decision","accent":"blue"},{"from":"decision","to":"message","accent":"green"},{"from":"message","to":"task","accent":"violet"}],"sequence":["task","commit","message","review","decision","message","task"],"packetDuration":2}
